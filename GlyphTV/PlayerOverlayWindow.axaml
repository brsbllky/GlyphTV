<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GlyphTV.PlayerOverlayWindow"
        Title="GlyphTV Player Overlay"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="True"
        MinWidth="320"
        MinHeight="180"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        KeyDown="Window_KeyDown">

	<!--
	PlayerOverlayWindow
	====================
	KÖK SEBEP (VLC/mpv video görüntüsü, oynatıcı kontrol butonlarının/rozetlerinin
	HER ZAMAN önünde kalıyordu — "airspace" sorunu): VideoView (VLC) ve
	MpvVideoHost (mpv) ikisi de video çıktısını GERÇEK bir native Win32 alt
	pencere (HWND) üzerinden gösterir. Windows'ta bir native alt pencere, aynı
	üst pencere (MainWindow) içindeki Avalonia'nın kendi çizdiği (Skia tabanlı)
	içeriğin HER ZAMAN önünde render edilir — bu, XAML'deki eleman sırası veya
	ZIndex ile değiştirilemeyen bir Windows pencere kompozisyon kısıtıdır (aynı
	sorun WPF/WinForms'ta native video kontrolleri için de onlarca yıldır
	bilinir ve orada da standart çözüm budur).
	
	ÇÖZÜM: Oynatıcı kontrol paneli (üst bar, alt bar, kanal listesi/ses/altyazı/
	enboy popup'ları, medya bilgi rozetleri — eskiden MainWindow.axaml içindeki
	"PlayerOverlayRoot" Grid'i) artık MainWindow'un ÜZERİNE, video alanının tam
	koordinatlarına senkronize edilen, şeffaf bir AYRI native pencerede
	yaşıyor. "Üstte kalma" (Topmost) durumu artık STATİK OLARAK burada
	değil, MainWindow.PlayerOverlay.cs'te DİNAMİK olarak yönetiliyor —
	sadece GlyphTV etkin/öndeki pencereyken Topmost=true olur; kullanıcı
	başka bir uygulamaya geçtiğinde false'a döner (bkz. "hayalet pencere"
	düzeltmesi, MainWindow.Activated/Deactivated abonelikleri). Statik
	Topmost="True" öncesinde overlay'i TÜM SİSTEMDEKİ pencerelerin
	üzerinde tutuyordu — GlyphTV arka plana alınsa bile video kontrol
	paneli diğer uygulamaların önünde "hayalet" gibi görünmeye devam
	ediyordu. Video (PlayerVideoHost) MainWindow içinde kalmaya
	devam ediyor; bu pencere sadece kontrolleri barındırıyor ve MainWindow'un
	PlayerContainer'ının ekran konumu/boyutu her değiştiğinde (bkz.
	MainWindow.PlayerOverlay.cs → SyncPlayerOverlayBounds) buna göre taşınıp
	yeniden boyutlandırılıyor.
	
	Tüm x:Name'ler eski MainWindow.axaml'deki İLE BİREBİR AYNI tutuldu ve
	x:FieldModifier="Public" eklendi ki MainWindow.PlayerOverlay.cs'teki
	yönlendirme (forwarding) property'leri bunlara erişebilsin — böylece
	MainWindow.Player.cs/Series.cs/VodInfo.cs/Epg.cs içindeki mevcut kod
	(PlayerTopBar.IsVisible = ... gibi) HİÇBİR DEĞİŞİKLİK YAPILMADAN aynen
	çalışmaya devam ediyor.
	-->

	<Window.Styles>
		<Style Selector="Button.PlayerIconBtn">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Root" CornerRadius="8" Background="Transparent">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.PlayerIconBtn:pointerover /template/ Border#Root">
			<Setter Property="Background" Value="#22ffffff"/>
		</Style>
		<Style Selector="Button.PlayerIconBtn:pressed /template/ Border#Root">
			<Setter Property="Background" Value="#33ffffff"/>
		</Style>
		<Style Selector="Button.PlayBtn">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Root" CornerRadius="20" Background="White">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.PlayBtn:pointerover /template/ Border#Root">
			<Setter Property="Background" Value="#DBEAFE"/>
		</Style>
		<Style Selector="Button.PlayBtn:pressed /template/ Border#Root">
			<Setter Property="Background" Value="#BFDBFE"/>
		</Style>
		<Style Selector="Button.PlayerTopBtn">
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Root" CornerRadius="20"
                            Background="#1Affffff"
                            BorderBrush="#33ffffff" BorderThickness="1"
                            Padding="10,5">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.PlayerTopBtn:pointerover /template/ Border#Root">
			<Setter Property="Background" Value="#443b82f6"/>
			<Setter Property="BorderBrush" Value="#773b82f6"/>
		</Style>
		<Style Selector="Button.PlayerTopBtn:pressed /template/ Border#Root">
			<Setter Property="Background" Value="#663b82f6"/>
			<Setter Property="BorderBrush" Value="#993b82f6"/>
		</Style>
		<Style Selector="Button.PlayerIconBtnWide">
			<Setter Property="Height" Value="36"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Root" CornerRadius="8" Background="Transparent" Padding="6,0">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.PlayerIconBtnWide:pointerover /template/ Border#Root">
			<Setter Property="Background" Value="#22ffffff"/>
		</Style>
		<Style Selector="Button.PlayerIconBtnWide:pressed /template/ Border#Root">
			<Setter Property="Background" Value="#33ffffff"/>
		</Style>
		<Style Selector="Button.PlayerCloseBtn">
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Root" CornerRadius="7"
                            Background="#18ffffff"
                            BorderBrush="#2Affffff" BorderThickness="1">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.PlayerCloseBtn:pointerover /template/ Border#Root">
			<Setter Property="Background" Value="#BBef4444"/>
			<Setter Property="BorderBrush" Value="#88ef4444"/>
		</Style>
		<Style Selector="Button.PlayerCloseBtn:pressed /template/ Border#Root">
			<Setter Property="Background" Value="#FFef4444"/>
			<Setter Property="BorderBrush" Value="#FFef4444"/>
		</Style>
		<Style Selector="Button.PlayerChannelBtn">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,1"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Root" CornerRadius="8" Background="Transparent" Padding="12,10">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.PlayerChannelBtn:pointerover /template/ Border#Root">
			<Setter Property="Background" Value="#22ffffff"/>
		</Style>
		<Style Selector="Button.PlayerChannelBtn.Active /template/ Border#Root">
			<Setter Property="Background" Value="#333b82f6"/>
		</Style>
		<Style Selector="Button.TrackBtn">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="Root" CornerRadius="6" Background="Transparent" Padding="10,6">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.TrackBtn:pointerover /template/ Border#Root">
			<Setter Property="Background" Value="#22ffffff"/>
		</Style>
		<Style Selector="Button.TrackBtn.Active /template/ Border#Root">
			<Setter Property="Background" Value="#3b82f6"/>
		</Style>
		<Style Selector="Border#AudioTrackPopup ScrollViewer">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border#AudioTrackPopup ScrollViewer /template/ Border">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border#AudioTrackPopup ScrollViewer > ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border#SubtitlePopup ScrollViewer">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border#SubtitlePopup ScrollViewer /template/ Border">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border#SubtitlePopup ScrollViewer > ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border#ChannelListPanel ScrollViewer">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border#ChannelListPanel ScrollViewer /template/ Border">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Border#ChannelListPanel ScrollViewer > ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- YENİ: MainWindow.axaml'deki Border.SelectListItem stilinin bu
		     (ayrı) pencere için kopyası — Donanım Çözümlemesi/İnterlacing
		     kontrolleri artık burada (mpv Ayarları popup'ında) da
		     gösteriliyor ve aynı seçim-listesi görünümünü kullanıyor.
		     MainWindow.axaml → Window.Styles bu pencereye miras kalmaz,
		     bu yüzden ayrı tanımlanması gerekiyor. -->
		<Style Selector="Border.SelectListItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Border.SelectListItem:pointerover">
			<Setter Property="Background" Value="#22ffffff"/>
		</Style>
		<Style Selector="Border.SelectListItem.Active">
			<Setter Property="Background" Value="#333b82f6"/>
		</Style>

		<!-- YENİ: Dar 4 sütunlu ızgaralar (Hedef Ekran Tepe Parlaklığı gibi)
		     için SelectListItem'ın daha kompakt (küçük padding/font) versiyonu
		     — normal SelectListItem'ın 10,8 padding'i bu kadar dar sütunlarda
		     metnin taşmasına/satırların üst üste binmesine yol açıyordu. -->
		<Style Selector="Border.SelectListItemCompact">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="7"/>
			<Setter Property="Padding" Value="4,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="Border.SelectListItemCompact:pointerover">
			<Setter Property="Background" Value="#22ffffff"/>
		</Style>
		<Style Selector="Border.SelectListItemCompact.Active">
			<Setter Property="Background" Value="#333b82f6"/>
		</Style>
	</Window.Styles>

					<Grid x:Name="PlayerOverlayRoot" x:FieldModifier="Public" Background="#01000000" PointerMoved="PlayerContainer_PointerMoved" PointerPressed="PlayerOverlay_PointerPressed">

							<!-- ÜST BAR -->
							<Border x:Name="PlayerTopBar" x:FieldModifier="Public" VerticalAlignment="Top" HorizontalAlignment="Stretch" Padding="18,12">
								<Border.Background>
									<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
										<GradientStop Color="#CC0b0f19" Offset="0"/>
										<GradientStop Color="#000b0f19" Offset="1"/>
									</LinearGradientBrush>
								</Border.Background>
								<Grid ColumnDefinitions="Auto, *, Auto">
									<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
										<Border x:Name="LiveBadge" x:FieldModifier="Public" Background="#22ef4444" BorderBrush="#55ef4444" BorderThickness="1" CornerRadius="12" Padding="7,3" IsVisible="True">
											<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
												<Border Width="5" Height="5" CornerRadius="3" Background="#ff4d4d"/>
												<TextBlock Text="CANLI" Foreground="#ff6b6b" FontSize="10" FontWeight="Bold"/>
											</StackPanel>
										</Border>
										<TextBlock x:Name="PlayerTitleText" x:FieldModifier="Public" Text="Kanal Adı" Foreground="White" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" MaxWidth="400" TextTrimming="CharacterEllipsis"/>

										<StackPanel x:Name="MediaInfoBadgesPanel" x:FieldModifier="Public" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
											<Border x:Name="ResolutionBadge" x:FieldModifier="Public" Background="#22ffffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="6" Padding="6,2" IsVisible="False">
												<TextBlock x:Name="ResolutionBadgeText" x:FieldModifier="Public" Foreground="#DDffffff" FontSize="10" FontWeight="Bold"/>
											</Border>
											<Border x:Name="FpsBadge" x:FieldModifier="Public" Background="#22ffffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="6" Padding="6,2" IsVisible="False">
												<TextBlock x:Name="FpsBadgeText" x:FieldModifier="Public" Foreground="#DDffffff" FontSize="10" FontWeight="Bold"/>
											</Border>
											<Border x:Name="VideoCodecBadge" x:FieldModifier="Public" Background="#22ffffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="6" Padding="6,2" IsVisible="False">
												<TextBlock x:Name="VideoCodecBadgeText" x:FieldModifier="Public" Foreground="#DDffffff" FontSize="10" FontWeight="Bold"/>
											</Border>
											<Border x:Name="AudioCodecBadge" x:FieldModifier="Public" Background="#22ffffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="6" Padding="6,2" IsVisible="False">
												<TextBlock x:Name="AudioCodecBadgeText" x:FieldModifier="Public" Foreground="#DDffffff" FontSize="10" FontWeight="Bold"/>
											</Border>
											<Border x:Name="AudioChannelsBadge" x:FieldModifier="Public" Background="#22ffffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="6" Padding="6,2" IsVisible="False">
												<TextBlock x:Name="AudioChannelsBadgeText" x:FieldModifier="Public" Foreground="#DDffffff" FontSize="10" FontWeight="Bold"/>
											</Border>
											<!-- YENİ: Bitrate Rozeti (Sadece Canlı Yayınlar İçin) -->
											<Border x:Name="BitrateBadge" x:FieldModifier="Public" CornerRadius="6" Background="#E60f172a" BorderBrush="#3322c55e" BorderThickness="1" Padding="7,2" Margin="0,0,6,0" IsVisible="False">
												<TextBlock x:Name="BitrateBadgeText" x:FieldModifier="Public" Text="0 Mb/s" FontSize="11" FontWeight="Bold" Foreground="#4ade80" VerticalAlignment="Center"/>
											</Border>
										</StackPanel>
									</StackPanel>

									<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
										<Border x:Name="BtnAudioTrack" x:FieldModifier="Public" Background="#1Affffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="20" Padding="10,5" Cursor="Hand" PointerPressed="BtnAudioTrack_Click" IsVisible="True">
											<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
												<Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" Fill="#DDffffff" Width="13" Height="13" Stretch="Uniform"/>
												<TextBlock Text="Ses Dili" Foreground="#DDffffff" FontSize="12"/>
											</StackPanel>
										</Border>
										<Border x:Name="BtnChannelList" x:FieldModifier="Public" Background="#1Affffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="20" Padding="10,5" Cursor="Hand" PointerPressed="BtnChannelList_Click" IsVisible="True">
											<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
												<Path Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" Fill="#DDffffff" Width="13" Height="13" Stretch="Uniform"/>
												<TextBlock Text="Kanallar" Foreground="#DDffffff" FontSize="12"/>
											</StackPanel>
										</Border>
										<Border x:Name="BtnAspectRatio" x:FieldModifier="Public" Background="#1Affffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="20" Padding="10,5" Cursor="Hand" PointerPressed="BtnAspectRatio_Click" IsVisible="True">
											<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
												<Path Data="M19 12h-2v3h-3v2h5v-5zM7 9h3V7H5v5h2V9zm14-6H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.99h18v14.02z" Fill="#DDffffff" Width="13" Height="13" Stretch="Uniform"/>
												<TextBlock x:Name="AspectRatioText" x:FieldModifier="Public" Text="Auto" Foreground="#DDffffff" FontSize="12"/>
											</StackPanel>
										</Border>
										<Border x:Name="BtnSubtitle" x:FieldModifier="Public" Background="#1Affffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="20" Padding="10,5" Cursor="Hand" PointerPressed="BtnSubtitle_Click" IsVisible="False">
											<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
												<Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-3 10H7v-2h10v2zm0-4H7V6h10v2z" Fill="#DDffffff" Width="13" Height="13" Stretch="Uniform"/>
												<TextBlock Text="Altyazı / Dil" Foreground="#DDffffff" FontSize="12"/>
											</StackPanel>
										</Border>
										<!-- YENİ: mpv Ayarları (⚙️) — SADECE mpv motoru aktifken
										     görünür (bkz. MainWindow.Settings.cs →
										     UpdateMpvSettingsButtonVisibility), VLC'de bu
										     düzeyde ayrıntılı HDR/görüntü kontrolü yok. -->
										<!-- YENİ: Kozmetik güncelleme — eski "⚙️ mpv Ayarları" emoji+metin
										     kombinasyonu yerine özel bir dişli (gear) SVG ikonu ve
										     "Enhanced" etiketi kullanılıyor. Tıklama davranışı
										     (MpvSettingsBtn_Click) ve x:Name (dolayısıyla
										     MainWindow.PlayerOverlay.cs'teki forwarding property)
										     DEĞİŞMEDİ — sadece görsel içerik güncellendi. -->
										<Border x:Name="MpvSettingsBtn" x:FieldModifier="Public" Background="#1Affffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="20" Padding="10,5" Cursor="Hand" PointerPressed="MpvSettingsBtn_Click" IsVisible="False">
											<StackPanel Orientation="Horizontal" Spacing="5" IsHitTestVisible="False">
												<Viewbox Width="13" Height="13">
													<Canvas Width="54" Height="54">
														<Path Fill="#DDffffff" Data="M27,13c-7.72,0-14,6.28-14,14s6.28,14,14,14s14-6.28,14-14S34.72,13,27,13z M27,39c-6.617,0-12-5.383-12-12s5.383-12,12-12 s12,5.383,12,12S33.617,39,27,39z"/>
