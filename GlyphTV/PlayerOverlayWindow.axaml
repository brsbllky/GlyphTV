.311-2.613L23,6.372V2.78C23,2.35,23.35,2,23.78,2h6.439C30.65,2,31,2.35,31,2.78v3.592l0.773,0.18 c2.237,0.521,4.36,1.399,6.311,2.613l0.674,0.42l2.539-2.539c0.306-0.306,0.801-0.304,1.104,0l4.553,4.553 c0.305,0.305,0.305,0.8,0,1.104l-2.539,2.539l0.42,0.674c1.214,1.949,2.093,4.072,2.613,6.311L47.628,23h3.592 C51.65,23,52,23.35,52,23.78V30.22z"/>
														<Path Fill="#DDffffff" Data="M27,17c-5.514,0-10,4.486-10,10s4.486,10,10,10s10-4.486,10-10S32.514,17,27,17z M27,35c-4.411,0-8-3.589-8-8s3.589-8,8-8 s8,3.589,8,8S31.411,35,27,35z"/>
													</Canvas>
												</Viewbox>
												<TextBlock Text="Enhanced" Foreground="#DDffffff" FontSize="12"/>
											</StackPanel>
										</Border>
									</StackPanel>
								</Grid>
							</Border>

							<!-- ALT BAR -->
							<Border x:Name="PlayerBottomBar" x:FieldModifier="Public" VerticalAlignment="Bottom" Padding="18,10,18,14">
								<Border.Background>
									<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
										<GradientStop Color="#000b0f19" Offset="0"/>
										<GradientStop Color="#EE0b0f19" Offset="1"/>
									</LinearGradientBrush>
								</Border.Background>
								<StackPanel Spacing="8">

									<Grid x:Name="SeekBarContainer" x:FieldModifier="Public" ColumnDefinitions="Auto, *, Auto" IsVisible="False">
										<TextBlock x:Name="CurrentTimeText" x:FieldModifier="Public" Grid.Column="0" Text="00:00:00" Foreground="#99ffffff" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="Consolas,monospace"/>
										<Slider x:Name="TimeSlider" x:FieldModifier="Public" Classes="PlayerSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" ValueChanged="TimeSlider_ValueChanged">
											<Slider.Resources>
												<SolidColorBrush x:Key="SliderThumbBackground" Color="White"/>
												<SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DDDDDD"/>
												<SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BBBBBB"/>
												<SolidColorBrush x:Key="SliderTrackValueFill" Color="White"/>
												<SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White"/>
												<SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White"/>
												<SolidColorBrush x:Key="SliderTrackFill" Color="#44ffffff"/>
												<SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#55ffffff"/>
												<SolidColorBrush x:Key="SliderTrackFillPressed" Color="#55ffffff"/>
											</Slider.Resources>
										</Slider>
										<TextBlock x:Name="TotalTimeText" x:FieldModifier="Public" Grid.Column="2" Text="00:00:00" Foreground="#99ffffff" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas,monospace"/>
									</Grid>

									<Grid ColumnDefinitions="*, Auto">
										<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<Border x:Name="PrevChannelBtn" x:FieldModifier="Public" Width="36" Height="36" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="PrevChannel_Click" ToolTip.Tip="Önceki Kanal">
												<Viewbox Width="18" Height="18" IsHitTestVisible="False">
													<Canvas Width="24" Height="24">
														<Path Data="M6 6h2v12H6V6zm3.5 6 8.5 6V6l-8.5 6z" Fill="#CCffffff"/>
													</Canvas>
												</Viewbox>
											</Border>

											<StackPanel x:Name="SkipBackBtn" x:FieldModifier="Public" IsVisible="False" VerticalAlignment="Center" Spacing="1">
												<Border Width="36" Height="30" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="SkipBack_Click" ToolTip.Tip="10 saniye geri">
													<Viewbox Width="18" Height="18" IsHitTestVisible="False">
														<Canvas Width="24" Height="24">
															<Path Data="M6 6h2v12H6V6zm3.5 6 8.5 6V6l-8.5 6z" Fill="#CCffffff"/>
														</Canvas>
													</Viewbox>
												</Border>
												<TextBlock Text="10s" Foreground="#66ffffff" FontSize="9" HorizontalAlignment="Center" IsHitTestVisible="False"/>
											</StackPanel>

											<Border x:Name="PlayPauseBtn" x:FieldModifier="Public" Width="40" Height="40" CornerRadius="20" Background="White" Cursor="Hand" PointerPressed="PlayPause_Click" Margin="4,0">
												<Viewbox Width="18" Height="18" IsHitTestVisible="False">
													<Canvas Width="24" Height="24">
														<Path x:Name="IconPlay" x:FieldModifier="Public"  Data="M8 5v14l11-7z"                   Fill="#111111" IsVisible="False"/>
														<Path x:Name="IconPause" x:FieldModifier="Public" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" Fill="#111111" IsVisible="True"/>
													</Canvas>
												</Viewbox>
											</Border>

											<Border x:Name="NextChannelBtn" x:FieldModifier="Public" Width="36" Height="36" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="NextChannel_Click" ToolTip.Tip="Sonraki Kanal">
												<Viewbox Width="18" Height="18" IsHitTestVisible="False">
													<Canvas Width="24" Height="24">
														<Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="#CCffffff"/>
													</Canvas>
												</Viewbox>
											</Border>

											<StackPanel x:Name="SkipForwardBtn" x:FieldModifier="Public" IsVisible="False" VerticalAlignment="Center" Spacing="1">
												<Border Width="36" Height="30" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="SkipForward_Click" ToolTip.Tip="10 saniye ileri">
													<Viewbox Width="18" Height="18" IsHitTestVisible="False">
														<Canvas Width="24" Height="24">
															<Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="#CCffffff"/>
														</Canvas>
													</Viewbox>
												</Border>
												<TextBlock Text="10s" Foreground="#66ffffff" FontSize="9" HorizontalAlignment="Center" IsHitTestVisible="False"/>
											</StackPanel>

											<Border x:Name="NextEpisodeBtn" x:FieldModifier="Public" Width="36" Height="36" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="NextEpisode_Click" IsVisible="False" ToolTip.Tip="Sonraki Bölüm" Margin="2,0,0,0">
												<Viewbox Width="17" Height="17" IsHitTestVisible="False">
													<Canvas Width="24" Height="24">
														<Path Data="M5 18l8.5-6L5 6v12zm8-12v12l8.5-6L13 6z" Fill="#CCffffff"/>
													</Canvas>
												</Viewbox>
											</Border>

											<Border x:Name="SpeedBtn" x:FieldModifier="Public" Height="36" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="Speed_Click" IsVisible="False" Padding="6,0" Margin="2,0,0,0">
												<StackPanel Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
													<Viewbox Width="22" Height="12" HorizontalAlignment="Center">
														<Canvas Width="512" Height="278.862">
															<Path Fill="#CCffffff" Data="M0 255.999C0 185.311 28.655 121.31 74.982 74.982 121.311 28.655 185.311 0 256.001 0c55.455 0 106.794 17.638 148.714 47.607l-26.682 22.017c-29.757-19.521-64.47-32.109-101.845-35.468v29.067h-40.377V34.156c-45.225 4.063-86.554 21.643-119.916 48.665l24.793 24.794-28.549 28.549-25.202-25.202c-33.462 38.969-53.685 89.641-53.685 145.037H0zM450.497 89.547C488.837 134.304 512 192.448 512 255.999h-33.252c0-53.029-18.531-101.73-49.467-139.979l21.216-26.473z"/>
															<Path Fill="#EF1C25" Data="M233.323 220.86c-38.904 32.143 13.131 86.245 48.238 40.188L440.179 63.123l-7.427-6.826L233.323 220.86z"/>
														</Canvas>
													</Viewbox>
													<TextBlock x:Name="SpeedBtnText" x:FieldModifier="Public" Text="1×" Foreground="#CCffffff" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
												</StackPanel>
											</Border>
										</StackPanel>

										<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
											<Border x:Name="MuteBtn" x:FieldModifier="Public" Width="36" Height="36" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="Mute_Click">
												<Viewbox Width="16" Height="16" IsHitTestVisible="False">
													<Canvas Width="24" Height="24">
														<Path x:Name="IconMuteOn" x:FieldModifier="Public"  Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" Fill="#CCffffff" IsVisible="True"/>
														<Path x:Name="IconMuteOff" x:FieldModifier="Public" Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" Fill="#CCffffff" IsVisible="False"/>
													</Canvas>
												</Viewbox>
											</Border>

											<Slider x:Name="VolumeSlider" x:FieldModifier="Public" Classes="PlayerSlider" Width="90" Minimum="0" Maximum="200" Value="100" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center">
												<Slider.Resources>
													<SolidColorBrush x:Key="SliderThumbBackground" Color="White"/>
													<SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DDDDDD"/>
													<SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BBBBBB"/>
													<SolidColorBrush x:Key="SliderTrackValueFill" Color="White"/>
													<SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White"/>
													<SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White"/>
													<SolidColorBrush x:Key="SliderTrackFill" Color="#44ffffff"/>
													<SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#55ffffff"/>
													<SolidColorBrush x:Key="SliderTrackFillPressed" Color="#55ffffff"/>
												</Slider.Resources>
											</Slider>

											<TextBlock x:Name="VolumeText" x:FieldModifier="Public" Text="100%" Foreground="#66ffffff" FontSize="11" VerticalAlignment="Center" Width="34" FontFamily="Consolas,monospace"/>

											<Border Width="1" Height="18" Background="#22ffffff" Margin="4,0"/>

											<Border x:Name="PipBtn" x:FieldModifier="Public" Width="36" Height="36" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="Pip_Click" ToolTip.Tip="Picture-in-Picture (PiP) [Shift+T]">
												<Viewbox Width="17" Height="17" IsHitTestVisible="False">
													<Canvas Width="24" Height="24">
														<Path Data="M19 7h-8v6h8V7zm2-4H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.99h18v14.02z" Fill="#CCffffff"/>
													</Canvas>
												</Viewbox>
											</Border>

											<Border Width="36" Height="36" CornerRadius="8" Background="Transparent" Cursor="Hand" PointerPressed="Fullscreen_Click" ToolTip.Tip="Tam Ekran [F]">
												<Viewbox Width="17" Height="17" IsHitTestVisible="False">
													<Canvas Width="24" Height="24">
														<Path Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" Fill="#CCffffff"/>
													</Canvas>
												</Viewbox>
											</Border>

											<Border x:Name="ClosePlayerBorder" x:FieldModifier="Public" Width="30" Height="30" CornerRadius="7" Background="#18ffffff" BorderBrush="#2Affffff" BorderThickness="1" Cursor="Hand" PointerPressed="ClosePlayer_Click" Margin="4,0,0,0" ToolTip.Tip="Kapat"
													PointerEntered="CloseBtn_PointerEntered" PointerExited="CloseBtn_PointerExited">
												<Viewbox Width="13" Height="13" IsHitTestVisible="False">
													<Canvas Width="24" Height="24">
														<Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#99ffffff"/>
													</Canvas>
												</Viewbox>
											</Border>
										</StackPanel>
									</Grid>
								</StackPanel>
							</Border>

							<!-- KANAL LİSTESİ POPUP -->
							<Border x:Name="ChannelListPanel" x:FieldModifier="Public" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,12,12" Background="#F2131a2e" BorderBrush="#1e2b47" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="False" Width="280" MaxHeight="460" ZIndex="50" PointerPressed="Popup_PointerPressed">
								<Grid RowDefinitions="Auto, *">
									<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,0,8">
										<TextBlock Text="Kanallar" Foreground="#3b82f6" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
										<Button Grid.Column="1" Classes="PlayerCloseBtn" Click="CloseChannelList_Click">
											<Viewbox Width="13" Height="13">
												<Canvas Width="24" Height="24">
													<Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#99ffffff"/>
												</Canvas>
											</Viewbox>
										</Button>
									</Grid>
									<ScrollViewer Grid.Row="1" Padding="0,4,0,0"
												  HorizontalScrollBarVisibility="Disabled"
												  VerticalScrollBarVisibility="Hidden">
										<ScrollViewer.Styles>
											<Style Selector="ScrollViewer /template/ ContentPresenter#PART_ContentPresenter">
												<Setter Property="Background" Value="Transparent"/>
											</Style>
										</ScrollViewer.Styles>
										<StackPanel x:Name="PlayerChannelListContainer" x:FieldModifier="Public" Spacing="1"/>
									</ScrollViewer>
								</Grid>
							</Border>

							<!-- SES DİLİ POPUP (CANLI İÇERİKLER İÇİN) -->
							<Border x:Name="AudioTrackPopup" x:FieldModifier="Public" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,12,12" Background="#F2131a2e" BorderBrush="#1e2b47" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="False" MinWidth="240" MaxWidth="320" MaxHeight="480" ZIndex="50" PointerPressed="Popup_PointerPressed">
								<Grid RowDefinitions="Auto, *, Auto, Auto, Auto">
									<TextBlock Grid.Row="0" Text="Ses Dili" Foreground="#3b82f6" FontWeight="Bold" FontSize="12" Margin="4,0,4,8"/>
									<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" MaxHeight="180">
										<ScrollViewer.Styles>
											<Style Selector="ScrollViewer /template/ ContentPresenter#PART_ContentPresenter">
												<Setter Property="Background" Value="Transparent"/>
											</Style>
										</ScrollViewer.Styles>
										<StackPanel x:Name="AudioTrackContainer" x:FieldModifier="Public" Spacing="2"/>
									</ScrollViewer>

									<!-- SES SENKRONİZASYONU BÖLÜMÜ -->
									<Border Grid.Row="2" Height="1" Background="#1e2b47" Margin="0,8,0,8"/>
									<Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="4,0,4,6">
										<TextBlock Text="Ses Senkronizasyonu" Foreground="#3b82f6" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
										<TextBlock x:Name="AudioDelayText" x:FieldModifier="Public" Grid.Column="1" Text="0 ms" Foreground="#DDffffff" FontSize="11" FontWeight="Bold" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
									</Grid>
									<StackPanel Grid.Row="4" Spacing="6" Margin="0,0,0,4">
										<Grid ColumnDefinitions="*,*,*">
											<Border Grid.Column="0" Classes="SelectListItemCompact" Margin="0,0,2,0" PointerPressed="AudioDelayMinus500_Click" ToolTip.Tip="-500 ms (Sesi İlerlet/Erken) [Shift+J]">
												<TextBlock Text="-500ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
											<Border Grid.Column="1" Classes="SelectListItemCompact" Margin="2,0,2,0" PointerPressed="AudioDelayMinus100_Click" ToolTip.Tip="-100 ms (Sesi İlerlet/Erken)">
												<TextBlock Text="-100ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
											<Border Grid.Column="2" Classes="SelectListItemCompact" Margin="2,0,0,0" PointerPressed="AudioDelayMinus50_Click" ToolTip.Tip="-50 ms (Sesi İlerlet/Erken) [J]">
												<TextBlock Text="-50ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
										</Grid>
										<Grid ColumnDefinitions="*,*,*">
											<Border Grid.Column="0" Classes="SelectListItemCompact" Margin="0,0,2,0" PointerPressed="AudioDelayPlus50_Click" ToolTip.Tip="+50 ms (Sesi Geciktir) [K]">
												<TextBlock Text="+50ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
											<Border Grid.Column="1" Classes="SelectListItemCompact" Margin="2,0,2,0" PointerPressed="AudioDelayPlus100_Click" ToolTip.Tip="+100 ms (Sesi Geciktir)">
												<TextBlock Text="+100ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
											<Border Grid.Column="2" Classes="SelectListItemCompact" Margin="2,0,0,0" PointerPressed="AudioDelayPlus500_Click" ToolTip.Tip="+500 ms (Sesi Geciktir) [Shift+K]">
												<TextBlock Text="+500ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
										</Grid>
										<Border Classes="SelectListItemCompact" PointerPressed="AudioDelayReset_Click" Background="#1Affffff" ToolTip.Tip="Ses Senkronunu Sıfırla (0 ms) [L]">
											<TextBlock Text="Ses Senkronunu Sıfırla (0 ms)" Foreground="#3b82f6" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="10"/>
										</Border>
									</StackPanel>
								</Grid>
							</Border>

							<!-- ALTYAZI + SES DİLİ POPUP -->
							<Border x:Name="SubtitlePopup" x:FieldModifier="Public" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,12,12" Background="#F2131a2e" BorderBrush="#1e2b47" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="False" MinWidth="240" MaxWidth="320" MaxHeight="540" ZIndex="50" PointerPressed="Popup_PointerPressed">
								<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
									<TextBlock Grid.Row="0" Text="Altyazı" Foreground="#3b82f6" FontWeight="Bold" FontSize="12" Margin="4,0,4,6"/>
									<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" MaxHeight="120">
										<ScrollViewer.Styles>
											<Style Selector="ScrollViewer /template/ ContentPresenter#PART_ContentPresenter">
												<Setter Property="Background" Value="Transparent"/>
											</Style>
										</ScrollViewer.Styles>
										<StackPanel x:Name="SubtitleContainer" x:FieldModifier="Public" Spacing="2" Margin="0,0,0,4"/>
									</ScrollViewer>

									<!-- ALTYAZI SENKRONİZASYONU BÖLÜMÜ -->
									<Border Grid.Row="2" Height="1" Background="#1e2b47" Margin="0,8,0,8"/>
									<Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="4,0,4,6">
										<TextBlock Text="Altyazı Senkronizasyonu" Foreground="#3b82f6" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
										<TextBlock x:Name="SubtitleDelayText" x:FieldModifier="Public" Grid.Column="1" Text="0 ms" Foreground="#DDffffff" FontSize="11" FontWeight="Bold" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
									</Grid>
									<StackPanel Grid.Row="4" Spacing="6" Margin="0,0,0,4">
										<Grid ColumnDefinitions="*,*,*">
											<Border Grid.Column="0" Classes="SelectListItemCompact" Margin="0,0,2,0" PointerPressed="SubDelayMinus500_Click" ToolTip.Tip="-500 ms (Daha Erken) [Shift+G]">
												<TextBlock Text="-500ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
											<Border Grid.Column="1" Classes="SelectListItemCompact" Margin="2,0,2,0" PointerPressed="SubDelayMinus100_Click" ToolTip.Tip="-100 ms (Daha Erken)">
												<TextBlock Text="-100ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
											<Border Grid.Column="2" Classes="SelectListItemCompact" Margin="2,0,0,0" PointerPressed="SubDelayMinus50_Click" ToolTip.Tip="-50 ms (Daha Erken) [G]">
												<TextBlock Text="-50ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
										</Grid>
										<Grid ColumnDefinitions="*,*,*">
											<Border Grid.Column="0" Classes="SelectListItemCompact" Margin="0,0,2,0" PointerPressed="SubDelayPlus50_Click" ToolTip.Tip="+50 ms (Daha Geç) [H]">
												<TextBlock Text="+50ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
											<Border Grid.Column="1" Classes="SelectListItemCompact" Margin="2,0,2,0" PointerPressed="SubDelayPlus100_Click" ToolTip.Tip="+100 ms (Daha Geç)">
												<TextBlock Text="+100ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
											<Border Grid.Column="2" Classes="SelectListItemCompact" Margin="2,0,0,0" PointerPressed="SubDelayPlus500_Click" ToolTip.Tip="+500 ms (Daha Geç) [Shift+H]">
												<TextBlock Text="+500ms" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
											</Border>
										</Grid>
										<Border Classes="SelectListItemCompact" PointerPressed="SubDelayReset_Click" Background="#1Affffff" ToolTip.Tip="Senkronu Sıfırla (0 ms) [Z]">
											<TextBlock Text="Senkronu Sıfırla (0 ms)" Foreground="#3b82f6" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="10"/>
										</Border>
									</StackPanel>

									<Border Grid.Row="5" Height="1" Background="#1e2b47" Margin="0,8,0,8"/>
									<TextBlock Grid.Row="6" Text="Ses Dili" Foreground="#3b82f6" FontWeight="Bold" FontSize="12" Margin="4,0,4,6"/>
									<ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" MaxHeight="120">
										<ScrollViewer.Styles>
											<Style Selector="ScrollViewer /template/ ContentPresenter#PART_ContentPresenter">
												<Setter Property="Background" Value="Transparent"/>
											</Style>
										</ScrollViewer.Styles>
										<StackPanel x:Name="AudioTrackContainerVod" x:FieldModifier="Public" Spacing="2"/>
									</ScrollViewer>
								</Grid>
							</Border>

							<!-- ASPECT RATIO POPUP -->
							<Border x:Name="AspectRatioPopup" x:FieldModifier="Public" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,12,12" Background="#F2131a2e" BorderBrush="#1e2b47" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="False" MinWidth="200" ZIndex="50" PointerPressed="Popup_PointerPressed">
								<StackPanel>
									<TextBlock Text="En:Boy Oranı" Foreground="#3b82f6" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
									<StackPanel x:Name="AspectRatioContainer" x:FieldModifier="Public" Spacing="2"/>
								</StackPanel>
							</Border>
							<!-- ============================================================
							     YENİ: mpv Ayarları popup'ı (⚙️) — HDR ton eşleme, hedef
							     tepe parlaklığı, işleme kalitesi, ince görüntü ayarları
							     (Parlaklık/Kontrast/Doygunluk/Gama) ve Donanım Çözümlemesi/
							     İnterlacing (bkz. Ayarlar sekmesi kaldırıldı — bu seçenekler
							     artık SADECE burada yaşıyor). Mantık (SetHdrToneMapping vb.)
							     MainWindow.Settings.cs'te DEĞİŞMEDEN kalıyor; sadece erişim
							     noktası değişti.
							     DÜZELTME (seçenekler üst üste biniyordu / okunmuyordu):
							     Parlaklık/Kontrast ve Doygunluk/Gama artık YAN YANA (2 sütun),
							     Hedef Ekran Tepe Parlaklığı artık 4 SÜTUNLU tek bir ızgara
							     (kullanıcının paylaştığı referans görsele göre) — önceki
							     dağınık 2'li satır grupları kaldırıldı.
							     ============================================================ -->
							<Border x:Name="MpvSettingsPopup" x:FieldModifier="Public" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,12,12" Background="#F2131a2e" BorderBrush="#1e2b47" BorderThickness="1" CornerRadius="10" Padding="14" IsVisible="False" Width="336" MaxHeight="540" ZIndex="50" PointerPressed="Popup_PointerPressed">
								<Grid RowDefinitions="Auto, *">
									<StackPanel Grid.Row="0" Margin="0,0,0,10">
										<Grid ColumnDefinitions="*, Auto, Auto">
											<TextBlock Text="ENHANCED" Foreground="#3b82f6" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
											<Border Grid.Column="1" Background="#1Affffff" BorderBrush="#33ffffff" BorderThickness="1" CornerRadius="8" Padding="10,4" Cursor="Hand" Margin="0,0,8,0" PointerPressed="MpvResetSettings_Click">
												<TextBlock Text="Sıfırla" Foreground="#DDffffff" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Border>
											<Button Grid.Column="2" Classes="PlayerCloseBtn" Click="CloseMpvSettingsPopup_Click">
												<Viewbox Width="13" Height="13">
													<Canvas Width="24" Height="24">
														<Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#99ffffff"/>
													</Canvas>
												</Viewbox>
											</Button>
										</Grid>
										<TextBlock x:Name="MpvPopupStatusText" x:FieldModifier="Public" Text="Aktif: auto" Foreground="#77ffffff" FontSize="11" Margin="0,6,0,0"/>
										<Border Height="1" Background="#33ffffff" Margin="0,10,0,0"/>
									</StackPanel>

									<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" MaxHeight="470">
										<ScrollViewer.Styles>
											<Style Selector="ScrollViewer /template/ ContentPresenter#PART_ContentPresenter">
												<Setter Property="Background" Value="Transparent"/>
											</Style>
										</ScrollViewer.Styles>
										<StackPanel Spacing="4">
											<!-- GÖRÜNTÜ İYİLEŞTİRME & SHADER (Sadece MPV) -->
											<StackPanel x:Name="ShaderSectionContainer" x:FieldModifier="Public" Margin="0,0,0,8">
												<TextBlock Text="GÖRÜNTÜ İYİLEŞTİRME &amp; SHADER" Foreground="#3b82f6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
												<Grid ColumnDefinitions="*,*,*">
													<Border Grid.Column="0" x:Name="ShaderOffItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="off" PointerPressed="ShaderItem_PointerPressed" Margin="0,0,2,0" ToolTip.Tip="Shader kapalı (Orijinal görüntü)">
														<TextBlock Text="Kapalı" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
													<Border Grid.Column="1" x:Name="ShaderCasItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="cas" PointerPressed="ShaderItem_PointerPressed" Margin="2,0,2,0" ToolTip.Tip="AMD FidelityFX CAS (Canlı ve Keskin Yayın)">
														<TextBlock Text="AMD CAS" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
													<Border Grid.Column="2" x:Name="ShaderFsrItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="fsr" PointerPressed="ShaderItem_PointerPressed" Margin="2,0,0,0" ToolTip.Tip="AMD FSR (FidelityFX Super Resolution / 4K Ölçekleme)">
														<TextBlock Text="AMD FSR" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
												</Grid>
												<TextBlock Text="AMD FidelityFX algoritmaları ile yayını netleştirir veya 4K ölçekler." FontSize="10" Foreground="#77ffffff" TextWrapping="Wrap" Margin="0,4,0,0"/>
												<Border Height="1" Background="#33ffffff" Margin="0,8,0,0"/>
											</StackPanel>

											<!-- CANLI TV KANAL GEÇİŞİ (ZAPPING) -->
											<StackPanel x:Name="ZappingSectionContainer" x:FieldModifier="Public" Margin="0,0,0,8">
												<TextBlock Text="CANLI TV KANAL GEÇİŞİ" Foreground="#3b82f6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
												<Grid ColumnDefinitions="*,*">
													<Border Grid.Column="0" x:Name="ZappingFastItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="fast" PointerPressed="ZappingItem_PointerPressed" Margin="0,0,2,0" ToolTip.Tip="Düşük gecikmeli anlık kanal açılışı (200-300ms)">
														<TextBlock Text="⚡ Ultra Hızlı (200ms)" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
													<Border Grid.Column="1" x:Name="ZappingStableItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="stable" PointerPressed="ZappingItem_PointerPressed" Margin="2,0,0,0" ToolTip.Tip="Standart tamponlu kararlı mod">
														<TextBlock Text="Standart (Kararlı)" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
												</Grid>
												<TextBlock Text="Canlı TV geçişlerinde tamponu sıfırlayarak kanal açılışını anında görüntüye indirir." FontSize="10" Foreground="#77ffffff" TextWrapping="Wrap" Margin="0,4,0,0"/>
												<Border Height="1" Background="#33ffffff" Margin="0,8,0,0"/>
											</StackPanel>

											<!-- AKILLI SES İŞLEME -->
											<StackPanel x:Name="AudioEnhanceSectionContainer" x:FieldModifier="Public" Margin="0,0,0,8">
												<TextBlock Text="AKILLI SES İŞLEME" Foreground="#3b82f6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
												<Grid ColumnDefinitions="*,*,*">
													<Border Grid.Column="0" x:Name="AudioEnhanceOffItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="off" PointerPressed="AudioEnhanceItem_PointerPressed" Margin="0,0,2,0" ToolTip.Tip="Orijinal ses">
														<TextBlock Text="Standart" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
													<Border Grid.Column="1" x:Name="AudioEnhanceLoudnormItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="loudnorm" PointerPressed="AudioEnhanceItem_PointerPressed" Margin="2,0,2,0" ToolTip.Tip="EBU R128 Ses Dengeleme (Reklam/kanal ses patlamalarını önler)">
														<TextBlock Text="Loudnorm" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
													<Border Grid.Column="2" x:Name="AudioEnhanceNightItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="night" PointerPressed="AudioEnhanceItem_PointerPressed" Margin="2,0,0,0" ToolTip.Tip="Gece Modu (Patlama ve efektleri kısıp diyalogları öne çıkarır)">
														<TextBlock Text="Gece Modu" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
												</Grid>
												<TextBlock Text="Kanal/reklam arası ani ses patlamalarını dengeler veya gece izlemede diyalogları netleştirir." FontSize="10" Foreground="#77ffffff" TextWrapping="Wrap" Margin="0,4,0,0"/>
												<Border Height="1" Background="#33ffffff" Margin="0,8,0,0"/>
											</StackPanel>

											<TextBlock Text="VİDEO" Foreground="#3b82f6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>

											<!-- RESİM MODLARI (F1 - F4) -->
											<Grid ColumnDefinitions="*, Auto" Margin="0,0,0,3">
												<TextBlock Text="RESİM MODU" Foreground="#CCffffff" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
												<TextBlock Text="F1 - F4" Foreground="#66ffffff" FontSize="10" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas,monospace"/>
											</Grid>
											<Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,8">
												<Border Grid.Column="0" x:Name="PresetNaturalItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="natural" PointerPressed="PresetNatural_Click" Margin="0,0,2,0" ToolTip.Tip="Doğal / Nötr renk dengesi [F1]">
													<TextBlock Text="Doğal" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="1" x:Name="PresetVividItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="vivid" PointerPressed="PresetVivid_Click" Margin="2,0,2,0" ToolTip.Tip="Canlı renkler ve kontrast [F2]">
													<TextBlock Text="Canlı" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="2" x:Name="PresetSportsItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="sports" PointerPressed="PresetSports_Click" Margin="2,0,2,0" ToolTip.Tip="Yüksek dinamik ve parlak renkler [F3]">
													<TextBlock Text="Spor" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="3" x:Name="PresetCinemaItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="cinema" PointerPressed="PresetCinema_Click" Margin="2,0,0,0" ToolTip.Tip="Sıcak tonlar ve sinematik gama [F4]">
													<TextBlock Text="Sinema" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
											</Grid>

											<!-- DÜZELTME: Parlaklık/Kontrast artık yan yana (2 sütun) —
											     önceden alt alta 4 ayrı slider tüm popup'u gereksiz
											     uzatıyor ve diğer bölümlerin görünür alanını daraltarak
											     "üst üste binme" hissi yaratıyordu. -->
											<Grid ColumnDefinitions="*,*" Margin="0,0,0,4">
												<StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="2">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Parlaklık" Foreground="#CCffffff" FontSize="12"/>
														<TextBlock x:Name="MpvEqBrightnessText" x:FieldModifier="Public" Grid.Column="1" Text="0" Foreground="#88ffffff" FontSize="11" FontFamily="Consolas,monospace"/>
													</Grid>
													<Slider x:Name="MpvEqBrightnessSlider" x:FieldModifier="Public" Minimum="-100" Maximum="100" Value="0" ValueChanged="MpvEqBrightness_ValueChanged">
														<Slider.Resources>
															<SolidColorBrush x:Key="SliderThumbBackground" Color="White"/>
															<SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DDDDDD"/>
															<SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BBBBBB"/>
															<SolidColorBrush x:Key="SliderTrackValueFill" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackFill" Color="#33ffffff"/>
															<SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44ffffff"/>
															<SolidColorBrush x:Key="SliderTrackFillPressed" Color="#44ffffff"/>
														</Slider.Resources>
													</Slider>
												</StackPanel>
												<StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Kontrast" Foreground="#CCffffff" FontSize="12"/>
														<TextBlock x:Name="MpvEqContrastText" x:FieldModifier="Public" Grid.Column="1" Text="0" Foreground="#88ffffff" FontSize="11" FontFamily="Consolas,monospace"/>
													</Grid>
													<Slider x:Name="MpvEqContrastSlider" x:FieldModifier="Public" Minimum="-100" Maximum="100" Value="0" ValueChanged="MpvEqContrast_ValueChanged">
														<Slider.Resources>
															<SolidColorBrush x:Key="SliderThumbBackground" Color="White"/>
															<SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DDDDDD"/>
															<SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BBBBBB"/>
															<SolidColorBrush x:Key="SliderTrackValueFill" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackFill" Color="#33ffffff"/>
															<SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44ffffff"/>
															<SolidColorBrush x:Key="SliderTrackFillPressed" Color="#44ffffff"/>
														</Slider.Resources>
													</Slider>
												</StackPanel>
											</Grid>

											<Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
												<StackPanel Grid.Column="0" Margin="0,0,8,0" Spacing="2">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Doygunluk" Foreground="#CCffffff" FontSize="12"/>
														<TextBlock x:Name="MpvEqSaturationText" x:FieldModifier="Public" Grid.Column="1" Text="0" Foreground="#88ffffff" FontSize="11" FontFamily="Consolas,monospace"/>
													</Grid>
													<Slider x:Name="MpvEqSaturationSlider" x:FieldModifier="Public" Minimum="-100" Maximum="100" Value="0" ValueChanged="MpvEqSaturation_ValueChanged">
														<Slider.Resources>
															<SolidColorBrush x:Key="SliderThumbBackground" Color="White"/>
															<SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DDDDDD"/>
															<SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BBBBBB"/>
															<SolidColorBrush x:Key="SliderTrackValueFill" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackFill" Color="#33ffffff"/>
															<SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44ffffff"/>
															<SolidColorBrush x:Key="SliderTrackFillPressed" Color="#44ffffff"/>
														</Slider.Resources>
													</Slider>
												</StackPanel>
												<StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Gama" Foreground="#CCffffff" FontSize="12"/>
														<TextBlock x:Name="MpvEqGammaText" x:FieldModifier="Public" Grid.Column="1" Text="0" Foreground="#88ffffff" FontSize="11" FontFamily="Consolas,monospace"/>
													</Grid>
													<Slider x:Name="MpvEqGammaSlider" x:FieldModifier="Public" Minimum="-100" Maximum="100" Value="0" ValueChanged="MpvEqGamma_ValueChanged">
														<Slider.Resources>
															<SolidColorBrush x:Key="SliderThumbBackground" Color="White"/>
															<SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DDDDDD"/>
															<SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BBBBBB"/>
															<SolidColorBrush x:Key="SliderTrackValueFill" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3b82f6"/>
															<SolidColorBrush x:Key="SliderTrackFill" Color="#33ffffff"/>
															<SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#44ffffff"/>
															<SolidColorBrush x:Key="SliderTrackFillPressed" Color="#44ffffff"/>
														</Slider.Resources>
													</Slider>
												</StackPanel>
											</Grid>

											<Border Height="1" Background="#33ffffff" Margin="0,4,0,10"/>

											<TextBlock Text="HDR TON EŞLEME" Foreground="#3b82f6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
											<Grid ColumnDefinitions="*,*" Margin="0,0,0,3">
												<Border Grid.Column="0" x:Name="HdrToneMapAutoItem" x:FieldModifier="Public" Classes="SelectListItem" Tag="auto" PointerPressed="HdrToneMappingItem_PointerPressed" Margin="0,0,3,0">
													<TextBlock Text="Otomatik" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="12"/>
												</Border>
												<Border Grid.Column="1" x:Name="HdrToneMapHableItem" x:FieldModifier="Public" Classes="SelectListItem" Tag="hable" PointerPressed="HdrToneMappingItem_PointerPressed" Margin="3,0,0,0">
													<TextBlock Text="Hable" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="12"/>
												</Border>
											</Grid>
											<Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
												<Border Grid.Column="0" x:Name="HdrToneMapMobiusItem" x:FieldModifier="Public" Classes="SelectListItem" Tag="mobius" PointerPressed="HdrToneMappingItem_PointerPressed" Margin="0,0,3,0">
													<TextBlock Text="Mobius" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="12"/>
												</Border>
												<Border Grid.Column="1" x:Name="HdrToneMapBt2446aItem" x:FieldModifier="Public" Classes="SelectListItem" Tag="bt.2446a" PointerPressed="HdrToneMappingItem_PointerPressed" Margin="3,0,0,0">
													<TextBlock Text="BT.2446a" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="12"/>
												</Border>
											</Grid>
											<!-- YENİ (kod uyumluluğu için): checkmark TextBlock'ları görsel
											     olarak kaldırılmadı (seçim artık sadece kart arka planı
											     rengiyle — referans görseldeki gibi — belirtiliyor) ama
											     MainWindow.Settings.cs → SetSelectListItemActive hâlâ bu
											     alanlara yazdığından derleme uyumluluğu için IsVisible=
											     False sabit kalacak şekilde ayrı, görünmez olarak
											     tutuluyor. -->
											<TextBlock x:Name="HdrToneMapAutoCheck" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrToneMapHableCheck" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrToneMapMobiusCheck" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrToneMapBt2446aCheck" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>

											<TextBlock Text="HEDEF EKRAN TEPE PARLAKLIĞI" Foreground="#3b82f6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
											<!-- DÜZELTME (seçenekler üst üste biniyordu): 2'li satır
											     grupları yerine TEK bir 4 sütunlu ızgara — referans
											     görseldeki (mpv.png) düzenin birebir aynısı. -->
											<Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,4">
												<Border Grid.Column="0" x:Name="HdrPeakAutoItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="auto" PointerPressed="HdrTargetPeakItem_PointerPressed" Margin="0,0,3,0">
													<TextBlock Text="Otomatik" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="1" x:Name="HdrPeak100Item" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="100" PointerPressed="HdrTargetPeakItem_PointerPressed" Margin="3,0,3,0">
													<TextBlock Text="100" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="2" x:Name="HdrPeak200Item" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="200" PointerPressed="HdrTargetPeakItem_PointerPressed" Margin="3,0,3,0">
													<TextBlock Text="200" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="3" x:Name="HdrPeak400Item" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="400" PointerPressed="HdrTargetPeakItem_PointerPressed" Margin="3,0,0,0">
													<TextBlock Text="400" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
											</Grid>
											<Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
												<Border Grid.Column="0" x:Name="HdrPeak600Item" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="600" PointerPressed="HdrTargetPeakItem_PointerPressed" Margin="0,0,3,0">
													<TextBlock Text="600" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="1" x:Name="HdrPeak800Item" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="800" PointerPressed="HdrTargetPeakItem_PointerPressed" Margin="3,0,3,0">
													<TextBlock Text="800" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="2" x:Name="HdrPeak1000Item" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="1000" PointerPressed="HdrTargetPeakItem_PointerPressed" Margin="3,0,3,0">
													<TextBlock Text="1000" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
												</Border>
												<Border Grid.Column="3"/>
											</Grid>
											<TextBlock x:Name="HdrPeakAutoCheck" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrPeak100Check" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrPeak200Check" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrPeak400Check" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrPeak600Check" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrPeak800Check" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>
											<TextBlock x:Name="HdrPeak1000Check" x:FieldModifier="Public" Text="✓" IsVisible="False" Height="0" Opacity="0"/>

											<TextBlock Text="İŞLEME KALİTESİ" Foreground="#3b82f6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
											<Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
												<Button Grid.Column="0" x:Name="ScalingQualityDefaultBtn" x:FieldModifier="Public" Classes="TrackBtn" Click="ScalingQualityDefault_Click" HorizontalAlignment="Stretch" Margin="0,0,3,0" Padding="8,14">
													<TextBlock Text="Varsayılan" Foreground="White" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
												</Button>
												<Button Grid.Column="1" x:Name="ScalingQualityHighBtn" x:FieldModifier="Public" Classes="TrackBtn" Click="ScalingQualityHigh_Click" HorizontalAlignment="Stretch" Margin="3,0,0,0" Padding="8,14">
													<TextBlock Text="Kalite (daha keskin ölçekleme)" Foreground="White" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
												</Button>
											</Grid>
											<TextBlock Text="Ton eşleme, SDR ekranlarda HDR içeriği etkiler. Kalite ölçekleme daha fazla GPU kullanır." FontSize="10" Foreground="#77ffffff" TextWrapping="Wrap" Margin="0,0,0,10"/>

											<Border Height="1" Background="#33ffffff" Margin="0,0,0,10"/>

											<!-- ═══════════════════════════════════════════════════
											     Donanım Çözümlemesi / İnterlacing — Ayarlar sekmesindeki
											     "Oynatıcı Performansı" kartı KALDIRILDI, bu seçenekler
											     artık SADECE burada yaşıyor.
											     ═══════════════════════════════════════════════════ -->
											<TextBlock Text="DONANIM ÇÖZÜMLEMESİ" Foreground="#3b82f6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
											<StackPanel Spacing="2" Margin="0,0,0,10">
												<Border x:Name="PopupHwDecodeAutoItem" x:FieldModifier="Public" Classes="SelectListItem" Tag="auto" PointerPressed="HwDecodeItem_PointerPressed">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Otomatik / Önerilen" Foreground="#DDffffff" VerticalAlignment="Center" FontSize="12"/>
														<TextBlock x:Name="PopupHwDecodeAutoCheck" x:FieldModifier="Public" Grid.Column="1" Text="✓" Foreground="#3b82f6" FontWeight="Bold" IsVisible="False"/>
													</Grid>
												</Border>
												<Border x:Name="PopupHwDecodeD3D11Item" x:FieldModifier="Public" Classes="SelectListItem" Tag="d3d11va" PointerPressed="HwDecodeItem_PointerPressed">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Windows D3D11VA" Foreground="#DDffffff" VerticalAlignment="Center" FontSize="12"/>
														<TextBlock x:Name="PopupHwDecodeD3D11Check" x:FieldModifier="Public" Grid.Column="1" Text="✓" Foreground="#3b82f6" FontWeight="Bold" IsVisible="False"/>
													</Grid>
												</Border>
												<Border x:Name="PopupHwDecodeNvdecItem" x:FieldModifier="Public" Classes="SelectListItem" Tag="nvdec" PointerPressed="HwDecodeItem_PointerPressed">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="NVIDIA NVDEC" Foreground="#DDffffff" VerticalAlignment="Center" FontSize="12"/>
														<TextBlock x:Name="PopupHwDecodeNvdecCheck" x:FieldModifier="Public" Grid.Column="1" Text="✓" Foreground="#3b82f6" FontWeight="Bold" IsVisible="False"/>
													</Grid>
												</Border>
												<Border x:Name="PopupHwDecodeNvdecCopyItem" x:FieldModifier="Public" Classes="SelectListItem" Tag="nvdec-copy" PointerPressed="HwDecodeItem_PointerPressed">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="NVIDIA NVDEC Copy" Foreground="#DDffffff" VerticalAlignment="Center" FontSize="12"/>
														<TextBlock x:Name="PopupHwDecodeNvdecCopyCheck" x:FieldModifier="Public" Grid.Column="1" Text="✓" Foreground="#3b82f6" FontWeight="Bold" IsVisible="False"/>
													</Grid>
												</Border>
												<Border x:Name="PopupHwDecodeOffItem" x:FieldModifier="Public" Classes="SelectListItem" Tag="no" PointerPressed="HwDecodeItem_PointerPressed">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Kapalı" Foreground="#DDffffff" VerticalAlignment="Center" FontSize="12"/>
														<TextBlock x:Name="PopupHwDecodeOffCheck" x:FieldModifier="Public" Grid.Column="1" Text="✓" Foreground="#3b82f6" FontWeight="Bold" IsVisible="False"/>
													</Grid>
												</Border>
											</StackPanel>

											<Border x:Name="PopupInterlaceItem" x:FieldModifier="Public" Classes="SelectListItem" PointerPressed="InterlaceToggle_PointerPressed">
												<Grid ColumnDefinitions="*, Auto">
													<StackPanel VerticalAlignment="Center">
														<TextBlock Text="İnterlacing'i Kaldır" FontWeight="Medium" Foreground="#DDffffff" FontSize="12"/>
														<TextBlock Text="Taramalı yayınlarda çizgi artefaktlarını azaltır" FontSize="10" Foreground="#88ffffff" Margin="0,2,0,0" TextWrapping="Wrap"/>
													</StackPanel>
													<TextBlock x:Name="PopupInterlaceCheck" x:FieldModifier="Public" Grid.Column="1" Text="✓" Foreground="#3b82f6" FontWeight="Bold" IsVisible="False" VerticalAlignment="Center" Margin="6,0,0,0"/>
												</Grid>
											</Border>

											<!-- Bağımlı Deinterlace Modları Seçimi -->
											<StackPanel x:Name="DeinterlaceModesContainer" x:FieldModifier="Public" Margin="0,2,0,10" Spacing="4">
												<TextBlock Text="DEINTERLACE ALGORİTMASI" Foreground="#88ffffff" FontSize="10" FontWeight="SemiBold" Margin="2,2,0,2"/>
												<Grid ColumnDefinitions="*,*,*,*">
													<Border Grid.Column="0" x:Name="PopupDeintYadif2xItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="yadif2x" PointerPressed="DeinterlaceModeItem_PointerPressed" Margin="0,0,2,0" ToolTip.Tip="Yadif 2X (50/60 FPS Akıcı Çift Kare - Önerilen)">
														<TextBlock Text="Yadif 2X" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
													<Border Grid.Column="1" x:Name="PopupDeintYadifItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="yadif" PointerPressed="DeinterlaceModeItem_PointerPressed" Margin="2,0,2,0" ToolTip.Tip="Yadif (Standart Tek Kare)">
														<TextBlock Text="Yadif" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
													<Border Grid.Column="2" x:Name="PopupDeintBobItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="bob" PointerPressed="DeinterlaceModeItem_PointerPressed" Margin="2,0,2,0" ToolTip.Tip="Bob (Hızlı Donanım Modu)">
														<TextBlock Text="Bob" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
													<Border Grid.Column="3" x:Name="PopupDeintLinearItem" x:FieldModifier="Public" Classes="SelectListItemCompact" Tag="linear" PointerPressed="DeinterlaceModeItem_PointerPressed" Margin="2,0,0,0" ToolTip.Tip="Linear (Doğrusal Enterpolasyon)">
														<TextBlock Text="Linear" Foreground="#DDffffff" HorizontalAlignment="Center" FontSize="10"/>
													</Border>
												</Grid>
											</StackPanel>
										</StackPanel>
									</ScrollViewer>
								</Grid>
							</Border>

							<!-- PiP YENİDEN BOYUTLANDIRMA KENARLARI (Resize Edges) -->
							<Border x:Name="ResizeTop" Tag="N" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="ResizeEdge_PointerPressed" ZIndex="100"/>
							<Border x:Name="ResizeBottom" Tag="S" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="ResizeEdge_PointerPressed" ZIndex="100"/>
							<Border x:Name="ResizeLeft" Tag="W" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWestEast" PointerPressed="ResizeEdge_PointerPressed" ZIndex="100"/>
							<Border x:Name="ResizeRight" Tag="E" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWestEast" PointerPressed="ResizeEdge_PointerPressed" ZIndex="100"/>
							<Border x:Name="ResizeTopLeft" Tag="NW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" PointerPressed="ResizeEdge_PointerPressed" ZIndex="101"/>
							<Border x:Name="ResizeTopRight" Tag="NE" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" PointerPressed="ResizeEdge_PointerPressed" ZIndex="101"/>
							<Border x:Name="ResizeBottomLeft" Tag="SW" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="ResizeEdge_PointerPressed" ZIndex="101"/>
							<Border x:Name="ResizeBottomRight" Tag="SE" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizeEdge_PointerPressed" ZIndex="101"/>

						</Grid>

</Window>
