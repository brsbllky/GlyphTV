																</Canvas>
															</Viewbox>
															<TextBlock Text="KOYU" VerticalAlignment="Center"/>
														</StackPanel>
													</Button>
												</StackPanel>
											</Grid>

											<Border Height="1" Background="{DynamicResource Border}"/>

											<!-- Başlangıçta Otomatik Yenileme -->
											<Grid ColumnDefinitions="*, Auto">
												<StackPanel VerticalAlignment="Center">
													<TextBlock Text="Başlangıçta Otomatik Yenileme" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
													<TextBlock Text="Uygulama her açıldığında aktif IPTV listesini sunucudan otomatik günceller" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
												</StackPanel>
												<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
													<Button x:Name="AutoRefreshOnBtn" Classes="ActionBtn SettingsToggleBtn" Click="AutoRefreshOn_Click">
														<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
															<Viewbox Width="13" Height="13" VerticalAlignment="Center">
																<Path Fill="#28a430" Data="M393.401,124.425L179.603,338.208c-15.832,15.835-41.514,15.835-57.361,0L11.878,227.836 c-15.838-15.835-15.838-41.52,0-57.358c15.841-15.841,41.521-15.841,57.355-0.006l81.698,81.699L336.037,67.064 c15.841-15.841,41.523-15.829,57.358,0C409.23,82.902,409.23,108.578,393.401,124.425z"/>
															</Viewbox>
															<TextBlock Text="AÇIK" VerticalAlignment="Center"/>
														</StackPanel>
													</Button>
													<Button x:Name="AutoRefreshOffBtn" Classes="ActionBtn SettingsToggleBtn" Click="AutoRefreshOff_Click">
														<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
															<Viewbox Width="13" Height="13" VerticalAlignment="Center">
																<Path Fill="#e61919" Data="F0 M19.207 6.207a1 1 0 0 0-1.414-1.414L12 10.586 6.207 4.793a1 1 0 0 0-1.414 1.414L10.586 12l-5.793 5.793a1 1 0 1 0 1.414 1.414L12 13.414l5.793 5.793a1 1 0 0 0 1.414-1.414L13.414 12l5.793-5.793z"/>
															</Viewbox>
															<TextBlock Text="KAPALI" VerticalAlignment="Center"/>
														</StackPanel>
													</Button>
												</StackPanel>
											</Grid>

											<Border Height="1" Background="{DynamicResource Border}"/>

											<!-- Açılışta Güncellemeleri Denetle -->
											<Grid ColumnDefinitions="*, Auto">
												<StackPanel VerticalAlignment="Center">
													<TextBlock Text="Açılışta Güncellemeleri Denetle" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
													<TextBlock Text="Uygulama başladığında arka planda sessizce yeni sürüm olup olmadığını kontrol eder" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
												</StackPanel>
												<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
													<Button x:Name="CheckUpdatesOnBtn" Classes="ActionBtn SettingsToggleBtn" Click="CheckUpdatesOn_Click">
														<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
															<Viewbox Width="13" Height="13" VerticalAlignment="Center">
																<Path Fill="#28a430" Data="M393.401,124.425L179.603,338.208c-15.832,15.835-41.514,15.835-57.361,0L11.878,227.836 c-15.838-15.835-15.838-41.52,0-57.358c15.841-15.841,41.521-15.841,57.355-0.006l81.698,81.699L336.037,67.064 c15.841-15.841,41.523-15.829,57.358,0C409.23,82.902,409.23,108.578,393.401,124.425z"/>
															</Viewbox>
															<TextBlock Text="AÇIK" VerticalAlignment="Center"/>
														</StackPanel>
													</Button>
													<Button x:Name="CheckUpdatesOffBtn" Classes="ActionBtn SettingsToggleBtn" Click="CheckUpdatesOff_Click">
														<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
															<Viewbox Width="13" Height="13" VerticalAlignment="Center">
																<Path Fill="#e61919" Data="F0 M19.207 6.207a1 1 0 0 0-1.414-1.414L12 10.586 6.207 4.793a1 1 0 0 0-1.414 1.414L10.586 12l-5.793 5.793a1 1 0 1 0 1.414 1.414L12 13.414l5.793 5.793a1 1 0 0 0 1.414-1.414L13.414 12l5.793-5.793z"/>
															</Viewbox>
															<TextBlock Text="KAPALI" VerticalAlignment="Center"/>
														</StackPanel>
													</Button>
												</StackPanel>
											</Grid>

											<Border Height="1" Background="{DynamicResource Border}"/>

											<!-- Oynatıcı Motoru -->
											<Grid ColumnDefinitions="*, Auto">
												<StackPanel VerticalAlignment="Center">
													<TextBlock Text="Oynatıcı Motoru" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
													<TextBlock Text="VLC (LibVLCSharp) veya mpv (libmpv) motoru" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
												</StackPanel>
												<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
													<Button x:Name="PlayerEngineVlcBtn" Classes="ActionBtn SettingsToggleBtn" Click="PlayerEngineVlc_Click">
														<StackPanel Orientation="Horizontal" Spacing="6">
															<Viewbox Width="15" Height="15" VerticalAlignment="Center">
																<Canvas Width="512" Height="512">
																	<Border Width="512" Height="512" CornerRadius="76" Background="Transparent"/>
																	<Path Fill="#f7901e" Data="M437 400l-36-94c-3-10-13-16-23-16H134c-10 0-20 6-23 16l-36 94c-2 3-2 7-2 11 0 16 13 29 29 29h308a29 29 0 0 0 27-40z"/>
																	<Path Fill="#f7901e" Data="M299 109l-15-51c-3-11-13-18-24-18h-8c-11 0-21 7-24 18l-15 51a307 307 0 0 0 86 0zM256 183c-24 0-46-2-64-6l-19 65c20 8 49 13 83 13s63-5 83-13l-20-65c-17 4-39 6-63 6z"/>
																	<Path Fill="#f2f2f2" Data="M319 177l-20-68a307 307 0 0 1-86 0l-21 68c18 4 40 6 64 6s46-2 63-6z"/>
																	<Path Fill="#f2f2f2" Data="M173 242l-18 62c19 14 55 23 101 23s82-9 101-23l-18-62c-20 8-49 13-83 13s-63-5-83-13z"/>
																</Canvas>
															</Viewbox>
															<TextBlock Text="VLC" VerticalAlignment="Center"/>
														</StackPanel>
													</Button>
													<Button x:Name="PlayerEngineMpvBtn" Classes="ActionBtn SettingsToggleBtn" Click="PlayerEngineMpv_Click">
														<StackPanel Orientation="Horizontal" Spacing="6">
															<Viewbox Width="15" Height="15" VerticalAlignment="Center">
																<Canvas Width="512" Height="512">
																	<Ellipse Width="490" Height="490" Canvas.Left="11" Canvas.Top="11" Fill="#E2E2E6"/>
																	<Ellipse Width="456" Height="456" Canvas.Left="28" Canvas.Top="28" Fill="#5C246E"/>
																	<Ellipse Width="330" Height="330" Canvas.Left="91" Canvas.Top="91" Fill="#3B1245"/>
																	<Ellipse Width="220" Height="220" Canvas.Left="146" Canvas.Top="146" Fill="#ECECF0"/>
																	<Path Fill="#5C246E" Data="M226,194 L326,256 L226,318 Z"/>
																</Canvas>
															</Viewbox>
															<TextBlock Text="MPV" VerticalAlignment="Center"/>
														</StackPanel>
													</Button>
												</StackPanel>
											</Grid>
										</StackPanel>
									</Border>
								</StackPanel>
							</ScrollViewer>

							<!-- 3. SEKME: VERİ & DEPOLAMA -->
							<ScrollViewer x:Name="SettingsTabData" Margin="24,18,24,24" VerticalScrollBarVisibility="Auto" IsVisible="False">
								<StackPanel Spacing="16">
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="Veri &amp; Depolama Yönetimi" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
										<TextBlock Text="İzleme geçmişi, disk ve RAM önbelleği ile uygulama sıfırlama işlemleri." FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
									</StackPanel>

									<Border Classes="SettingsCard">
										<StackPanel Spacing="16">
											<Grid ColumnDefinitions="*, Auto">
												<StackPanel VerticalAlignment="Center">
													<TextBlock Text="İzleme Geçmişini Temizle" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
													<TextBlock Text="Kaldığınız yerden devam etme pozisyonlarını ve izleme geçmişini siler" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
												</StackPanel>
												<Button Grid.Column="1" Classes="ActionBtn SettingsToggleBtn" Click="ClearHistory_Click" Foreground="#dc2626" BorderBrush="#dc2626">
													<TextBlock Text="GEÇMİŞİ TEMİZLE" VerticalAlignment="Center"/>
												</Button>
											</Grid>

											<Border Height="1" Background="{DynamicResource Border}"/>

											<Grid ColumnDefinitions="*, Auto">
												<StackPanel VerticalAlignment="Center">
													<TextBlock Text="Logo &amp; Görsel Önbelleğini Temizle" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
													<TextBlock Text="İndirilen kanal logolarını ve TMDb poster önbelleğini temizler" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
												</StackPanel>
												<Button Grid.Column="1" Classes="ActionBtn SettingsToggleBtn" Click="ClearCache_Click" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}">
													<TextBlock Text="ÖNBELLEĞİ TEMİZLE" VerticalAlignment="Center"/>
												</Button>
											</Grid>

											<Border Height="1" Background="{DynamicResource Border}"/>

											<Grid ColumnDefinitions="*, Auto">
												<StackPanel VerticalAlignment="Center">
													<TextBlock Text="Fabrika Ayarlarına Sıfırla" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
													<TextBlock Text="Tüm uygulama ayarlarını ve tercihleri varsayılan değerlere döndürür" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
												</StackPanel>
												<Button Grid.Column="1" Classes="ActionBtn SettingsToggleBtn" Click="ResetApp_Click" Foreground="#dc2626" BorderBrush="#dc2626">
													<TextBlock Text="UYGULAMAYI SIFIRLA" VerticalAlignment="Center"/>
												</Button>
											</Grid>
										</StackPanel>
									</Border>
								</StackPanel>
							</ScrollViewer>

							<!-- 4. SEKME: KISAYOLLAR -->
							<ScrollViewer x:Name="SettingsTabShortcuts" Margin="24,18,24,24" VerticalScrollBarVisibility="Hidden" IsVisible="False">
								<StackPanel Spacing="18">
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="Klavye &amp; Fare Kısayolları" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
										<TextBlock Text="Hızlı gezinme, medya kontrolü, resim modları ve ses/altyazı senkronizasyonu için kullanabileceğiniz tüm kısayollar." FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
									</StackPanel>

									<!-- 1. GRUP: TEMEL & OYNATMA KONTROLLERİ -->
									<Border Classes="SettingsCard">
										<StackPanel Spacing="12">
											<TextBlock Text="Oynatma &amp; Medya Kontrolleri" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,0,2"/>

											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Oynat / Duraklat" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="Space  /  Sol Tık" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Tam Ekran Aç / Kapat" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="F  /  Çift Tık" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Resim İçinde Resim (PiP) Modu" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="Shift + T" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Sesi Aç / Kapat (Mute)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="M" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="10 Saniye Geri / İleri Sar (Film &amp; Dizi)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="←  /  →" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Ses Seviyesi (Film/Dizi) / Kanal Değiştir (Canlı)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="↑  /  ↓" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Kanal ve İçerik Arama" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="Ctrl + F" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Pencereleri, PiP ve Modalleri Kapat" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="Esc" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
										</StackPanel>
									</Border>

									<!-- 2. GRUP: GÖRÜNTÜ VE RESİM MODLARI -->
									<Border Classes="SettingsCard">
										<StackPanel Spacing="12">
											<TextBlock Text="Görüntü ve Resim Modları" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,0,2"/>

											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Resim Modu: Doğal (Nötr / Standart Renkler)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="F1" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Resim Modu: Canlı (Yüksek Doygunluk &amp; Dinamik Kontrast)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="F2" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Resim Modu: Spor (Akıcı Hareket &amp; Canlı Saha/Zemin Tonları)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="F3" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Resim Modu: Sinema (Sıcak Film Tonları &amp; Derin Siyahlar)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="F4" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
										</StackPanel>
									</Border>

									<!-- 3. GRUP: SES VE ALTYAZI SENKRONİZASYONU -->
									<Border Classes="SettingsCard">
										<StackPanel Spacing="12">
											<TextBlock Text="Ses ve Altyazı Senkronizasyonu" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,0,2"/>

											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Sesi İlerlet / Hızlı İlerlet (-50 ms / -500 ms)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="J  /  Shift + J" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Sesi Geciktir / Hızlı Geciktir (+50 ms / +500 ms)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="K  /  Shift + K" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Ses Senkronunu Sıfırla (0 ms)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="L" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Altyazıyı Erken / Çok Erken Ver (-50 ms / -500 ms)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="G  /  Shift + G" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Altyazıyı Geciktir / Çok Geciktir (+50 ms / +500 ms)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="H  /  Shift + H" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
											<Border Height="1" Background="{DynamicResource Border}"/>
											<Grid ColumnDefinitions="*, Auto">
												<TextBlock Text="Altyazı Senkronunu Sıfırla (0 ms)" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
												<Border Grid.Column="1" Classes="KbdBadge"><TextBlock Text="Z" FontWeight="Bold" FontSize="11"/></Border>
											</Grid>
										</StackPanel>
									</Border>
								</StackPanel>
							</ScrollViewer>

							<!-- 5. SEKME: HAKKINDA -->
							<ScrollViewer x:Name="SettingsTabAbout" Margin="24,18,24,24" VerticalScrollBarVisibility="Auto" IsVisible="False">
								<StackPanel Spacing="16">
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="Hakkında &amp; Topluluk" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
										<TextBlock Text="GlyphTV geliştirici bilgileri, lisans ve topluluk bağlantıları." FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
									</StackPanel>

									<Border Classes="SettingsCard">
										<StackPanel Spacing="16">
											<Grid ColumnDefinitions="Auto, *">
												<Border Grid.Column="0" Width="350" Height="140" CornerRadius="12" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,14,0">
													<Image Source="avares://GlyphTV/Assets/glyph_icon.png" Width="380" Height="380" RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
												<Border Grid.Column="1" Width="350" Height="140" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="18,14">
													<Grid VerticalAlignment="Center" ColumnDefinitions="Auto, Auto, *" RowDefinitions="Auto, Auto, Auto">
														<TextBlock Grid.Row="0" Grid.Column="0" Text="Sürüm" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
														<TextBlock Grid.Row="0" Grid.Column="1" Text=":" FontWeight="Medium" Foreground="{DynamicResource Text}" Margin="8,0"/>
														<TextBlock Grid.Row="0" Grid.Column="2" Text="2.1.0" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

														<TextBlock Grid.Row="1" Grid.Column="0" Text="Geliştirici" FontWeight="Medium" Foreground="{DynamicResource Text}" Margin="0,10,0,0"/>
														<TextBlock Grid.Row="1" Grid.Column="1" Text=":" FontWeight="Medium" Foreground="{DynamicResource Text}" Margin="8,10,0,0"/>
														<TextBlock Grid.Row="1" Grid.Column="2" Text="Barış Ballıkaya" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Right" Margin="0,10,0,0" FontWeight="SemiBold"/>

														<TextBlock Grid.Row="2" Grid.Column="0" Text="Telif" FontWeight="Medium" Foreground="{DynamicResource Text}" Margin="0,10,0,0"/>
														<TextBlock Grid.Row="2" Grid.Column="1" Text=":" FontWeight="Medium" Foreground="{DynamicResource Text}" Margin="8,10,0,0"/>
														<TextBlock Grid.Row="2" Grid.Column="2" Text="© 2026" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Right" Margin="0,10,0,0" FontWeight="SemiBold"/>
													</Grid>
												</Border>
											</Grid>

											<!-- GlyphTV Açıklama Paneli -->
											<Border CornerRadius="10" Padding="18,14" BorderThickness="0">
												<Border.Background>
													<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
														<GradientStop Color="#4f8bff" Offset="0.0"/>
														<GradientStop Color="#ec4899" Offset="1.0"/>
													</LinearGradientBrush>
												</Border.Background>
												<StackPanel Spacing="6">
													<TextBlock Text="GlyphTV™" FontWeight="Bold" Foreground="White" FontSize="18"/>
													<TextBlock Text="Modern, hızlı ve minimal IPTV oynatıcı. Avalonia UI, LibVLCSharp ve libmpv ile güçlendirilmiştir." Foreground="#F3F4F6" FontSize="12" TextWrapping="Wrap"/>
												</StackPanel>
											</Border>

											<!-- Güncellemeler ve GitHub Yan Yana -->
											<Grid ColumnDefinitions="*, *">
												<!-- Çevrimiçi Güncelleme Denetim Kartı -->
												<Border Grid.Column="0" Background="Transparent" CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource Border}" Margin="0,0,8,0">
													<Grid ColumnDefinitions="*, Auto">
														<StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
															<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
																<TextBlock Text="Yazılım Güncellemesi" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
																<Border x:Name="SettingsAboutStatusBadge" CornerRadius="5" Padding="6,2" Background="#223b82f6" VerticalAlignment="Center">
																	<TextBlock x:Name="SettingsAboutStatusBadgeText" Text="Sürüm Güncel" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
																</Border>
															</StackPanel>
															<Panel VerticalAlignment="Center">
																<TextBlock x:Name="SettingsAboutLastCheckText" Text="Otomatik denetim aktif" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
																<Border x:Name="SettingsAboutUpdateBadge" CornerRadius="5" Padding="6,2" Background="#2222c55e" VerticalAlignment="Center" HorizontalAlignment="Left" IsVisible="False">
																	<TextBlock x:Name="SettingsAboutUpdateBadgeText" Text="Yeni Sürüm Mevcut: v0.0.0" FontSize="10" FontWeight="SemiBold" Foreground="#16a34a"/>
																</Border>
															</Panel>
														</StackPanel>

														<Button Grid.Column="1" x:Name="SettingsAboutCheckUpdatesBtn" Classes="ActionBtn" Click="CheckForUpdatesManual_Click" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" Margin="8,0,0,0" Cursor="Hand">
															<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
																<Viewbox Width="12" Height="12" VerticalAlignment="Center">
																	<Path Fill="White" Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
																</Viewbox>
																<TextBlock x:Name="SettingsAboutCheckUpdatesText" Text="Kontrol Et" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
															</StackPanel>
														</Button>
													</Grid>
												</Border>

												<!-- GitHub Butonu -->
												<Button Grid.Column="1" Classes="ActionBtn" Click="OpenGithub_Click" Background="Transparent" Foreground="{DynamicResource Text}" CornerRadius="10" Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Stretch" Margin="8,0,0,0" Cursor="Hand">
													<Grid ColumnDefinitions="Auto, *">
														<Viewbox Grid.Column="0" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
															<Canvas Width="24" Height="24">
																<Path Fill="{DynamicResource Text}" Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
															</Canvas>
														</Viewbox>
														<StackPanel Grid.Column="1" VerticalAlignment="Center">
															<TextBlock Text="GitHub Deposu" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
															<TextBlock Text="Projeyi yıldızlayın veya katkıda bulunun" FontSize="11" Foreground="{DynamicResource TextSec}"/>
														</StackPanel>
													</Grid>
												</Button>
											</Grid>
										</StackPanel>
									</Border>
								</StackPanel>
							</ScrollViewer>
						</Grid>
					</Grid>
				</Grid>
			</Border>
		</Border>

		<!-- VOD / Dizi Detay Modal (Arka Plan Silüetli Minimal Tasarım) -->
		<Border x:Name="VodInfoOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#A6000000" IsVisible="False" ZIndex="100">
			<Border Background="{DynamicResource BgCard}" Width="840" MaxHeight="600" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource Border}" BoxShadow="0 24 64 0 #AA000000" ClipToBounds="True">
				<Grid>
					<!-- 1. Arka Plan Silüeti (Backdrop / Poster) + Karartma Gradyanları -->
					<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
						<Image x:Name="VodInfoBackdropImage"
						       Stretch="UniformToFill"
						       RenderOptions.BitmapInterpolationMode="HighQuality"
						       HorizontalAlignment="Stretch"
						       VerticalAlignment="Stretch"
						       Opacity="0.88"/>
						
						<!-- Soldan Sağa Gradyan Karartma (Metin ve Sol Alan Okunabilirliği) -->
						<Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<Border.Background>
								<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
									<GradientStop Color="#F00b0f19" Offset="0.0"/>
									<GradientStop Color="#CC0b0f19" Offset="0.35"/>
									<GradientStop Color="#400b0f19" Offset="0.68"/>
									<GradientStop Color="#000b0f19" Offset="1.0"/>
								</LinearGradientBrush>
							</Border.Background>
						</Border>

						<!-- Aşağıdan Yukarıya Gradyan Karartma & Zemin Bütünlüğü -->
						<Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<Border.Background>
								<LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
									<GradientStop Color="#F00b0f19" Offset="0.0"/>
									<GradientStop Color="#800b0f19" Offset="0.28"/>
									<GradientStop Color="#000b0f19" Offset="0.65"/>
								</LinearGradientBrush>
							</Border.Background>
						</Border>

						<!-- Üst Kenar İnce Vignette Çerçevesi -->
						<Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<Border.Background>
								<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
									<GradientStop Color="#400b0f19" Offset="0.0"/>
									<GradientStop Color="#000b0f19" Offset="0.18"/>
								</LinearGradientBrush>
							</Border.Background>
						</Border>
					</Grid>

					<!-- 2. Ön Plan İçerik Düzeni -->
					<Grid RowDefinitions="Auto, *">
						<!-- Sol Üst: Geri / Kapat Butonu (modal.PNG'deki gibi yuvarlak ok) -->
						<Grid Grid.Row="0" Margin="24,20,24,6" ColumnDefinitions="Auto, *">
							<Button Grid.Column="0" Click="CloseVodInfo_Click" Classes="IconBtn" Width="36" Height="36" CornerRadius="18" Background="#50000000" BorderBrush="#33ffffff" BorderThickness="1" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand">
								<TextBlock Text="←" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
							</Button>
							<TextBlock x:Name="VodInfoModalTitle" Grid.Column="1" IsVisible="False"/>
							<TextBlock x:Name="VodInfoSource" Grid.Column="1" IsVisible="False"/>
						</Grid>

						<!-- Ana İçerik Alanı (Kaydırılabilir) -->
						<ScrollViewer Grid.Row="1" Margin="24,10,24,24" VerticalScrollBarVisibility="Auto">
							<Grid ColumnDefinitions="Auto, *">
								<!-- Sol: Poster -->
								<Border Grid.Column="0" Width="175" Height="260" CornerRadius="10" ClipToBounds="True" BoxShadow="0 14 36 0 #77000000" Background="{DynamicResource PosterPlaceholderBg}" VerticalAlignment="Top">
									<Grid>
										<Border x:Name="VodInfoPoster" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
											<TextBlock Text="🎬" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"/>
										</Border>
									</Grid>
								</Border>

								<!-- Sağ: Başlık, Rozetler, Konu/Özet, Oyuncular, Yönetmen, Butonlar -->
								<StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top" Spacing="10">
									<!-- Başlık & Varsa Orijinal İsim -->
									<StackPanel Spacing="3">
										<TextBlock x:Name="VodInfoTitle" Text="" FontSize="28" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxLines="2" LineHeight="34"/>
										<Grid x:Name="VodInfoOrigRow" ColumnDefinitions="Auto, *" IsVisible="False">
											<TextBlock Text="Orijinal:" FontSize="11" Foreground="#94a3b8" Width="50"/>
											<TextBlock x:Name="VodInfoOrigName" Grid.Column="1" Text="-" FontSize="11" FontStyle="Italic" Foreground="#cbd5e1" TextWrapping="Wrap"/>
										</Grid>
									</StackPanel>

									<!-- Rozetler: Yıl, Tür, Süre, Ülke / Puan (modal.PNG'deki gibi hap şeklinde rozetler) -->
									<WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
										<!-- Yıl Rozeti -->
										<Border x:Name="VodInfoDateRow" Background="#26334155" CornerRadius="6" Padding="12,5" Margin="0,0,8,6" BorderBrush="#475569" BorderThickness="1" IsVisible="False">
											<TextBlock x:Name="VodInfoDate" Text="-" FontSize="12" FontWeight="Medium" Foreground="#e2e8f0" VerticalAlignment="Center"/>
										</Border>
										<!-- Tür Rozeti -->
										<Border x:Name="VodInfoGenreRow" Background="#26334155" CornerRadius="6" Padding="12,5" Margin="0,0,8,6" BorderBrush="#475569" BorderThickness="1">
											<TextBlock x:Name="VodInfoGenre" Text="-" FontSize="12" FontWeight="Medium" Foreground="#e2e8f0" VerticalAlignment="Center"/>
										</Border>
										<!-- Süre Rozeti -->
										<Border x:Name="VodInfoDurRow" Background="#26334155" CornerRadius="6" Padding="12,5" Margin="0,0,8,6" BorderBrush="#475569" BorderThickness="1" IsVisible="False">
											<TextBlock x:Name="VodInfoDuration" Text="-" FontSize="12" FontWeight="Medium" Foreground="#e2e8f0" VerticalAlignment="Center"/>
										</Border>
										<!-- Ülke Rozeti -->
										<Border x:Name="VodInfoCountryRow" Background="#26334155" CornerRadius="6" Padding="12,5" Margin="0,0,8,6" BorderBrush="#475569" BorderThickness="1" IsVisible="False">
											<TextBlock x:Name="VodInfoCountry" Text="-" FontSize="12" FontWeight="Medium" Foreground="#e2e8f0" VerticalAlignment="Center"/>
										</Border>
										<!-- Puan Rozeti (Opsiyonel / Yıldızlı) -->
										<Border x:Name="VodInfoAgeRow" Background="#26eab308" CornerRadius="6" Padding="10,5" Margin="0,0,8,6" BorderBrush="#80eab308" BorderThickness="1" IsVisible="False">
											<TextBlock x:Name="VodInfoAge" Text="⭐ -" FontSize="12" FontWeight="Bold" Foreground="#f59e0b" VerticalAlignment="Center"/>
										</Border>
										<!-- Kategori (Fallback) -->
										<TextBlock x:Name="VodInfoCategory" IsVisible="False"/>
									</WrapPanel>

									<!-- Özet / Konu Metni -->
									<TextBlock x:Name="VodInfoPlot" Text="" FontSize="13" Foreground="#cbd5e1" TextWrapping="Wrap" LineHeight="21" Margin="0,2,0,6"/>
									<Border x:Name="VodInfoPlotRow" IsVisible="False"/>

									<!-- Oyuncular -->
									<StackPanel x:Name="VodInfoCastRow" Spacing="2" Margin="0,0,0,6" IsVisible="False">
										<TextBlock Text="Oyuncular" FontSize="11" Foreground="#94a3b8"/>
										<TextBlock x:Name="VodInfoCast" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#f1f5f9" TextWrapping="Wrap"/>
									</StackPanel>

									<!-- Yönetmen -->
									<StackPanel x:Name="VodInfoDirRow" Spacing="2" Margin="0,0,0,6" IsVisible="False">
										<TextBlock Text="Yönetmen" FontSize="11" Foreground="#94a3b8"/>
										<TextBlock x:Name="VodInfoDirector" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#f1f5f9" TextWrapping="Wrap"/>
									</StackPanel>

									<!-- Aksiyon Butonları (Oynat & Favori) -->
									<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
										<Button Classes="ActionBtn" x:Name="VodInfoPlayBtn" Click="VodInfoPlay_Click" CornerRadius="8" Padding="24,10" BorderThickness="0" Cursor="Hand" Background="#0084ff">
											<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
												<TextBlock Text="▶" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
												<TextBlock Text="Oynat" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
											</StackPanel>
										</Button>
										<Button Classes="ActionBtn" x:Name="VodInfoFavBtn" Click="VodInfoFav_Click" Background="#26334155" Foreground="White" CornerRadius="8" Padding="18,10" BorderThickness="1" BorderBrush="#475569" Cursor="Hand">
											<TextBlock x:Name="VodInfoFavText" Text="♡ Favori" FontSize="12.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Button>
									</StackPanel>
								</StackPanel>
							</Grid>
						</ScrollViewer>
					</Grid>
				</Grid>
			</Border>
		</Border>

		<!-- Kaynak Ekleme Modal -->
		<Border x:Name="ChangeSourceOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#B3000000" IsVisible="False" ZIndex="100">
			<Border Background="{DynamicResource BgCard}" Width="450" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" BoxShadow="0 10 40 0 #88000000">
				<StackPanel Spacing="16">
					<Grid ColumnDefinitions="*, Auto">
						<TextBlock Text="Yeni Kaynak Ekle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
						<Button Grid.Column="1" Content="✕" Click="CancelChangeSource_Click" Classes="IconBtn" FontSize="16" Foreground="{DynamicResource TextSec}"/>
					</Grid>
					<StackPanel Spacing="6">
						<TextBlock Text="Kaynak Adı" FontSize="12" Foreground="{DynamicResource TextSec}"/>
						<TextBox x:Name="SourceNameInput" Watermark="Örn: Ana Kaynak" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
					</StackPanel>
					<StackPanel Spacing="6">
						<TextBlock Text="Kaynak Tipi" FontSize="12" Foreground="{DynamicResource TextSec}"/>
						<Grid ColumnDefinitions="*,*,*">
							<Button x:Name="BtnTypeM3U" Grid.Column="0" Content="M3U" Click="SourceType_Click" Tag="M3U" Classes="ActionBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Foreground="{DynamicResource Accent}" CornerRadius="8,0,0,8" Padding="8"/>
							<Button x:Name="BtnTypeLink" Grid.Column="1" Content="Link" Click="SourceType_Click" Tag="Link" Classes="ActionBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1,1,1,1" Foreground="{DynamicResource TextSec}" CornerRadius="0" Padding="8"/>
							<Button x:Name="BtnTypeXtream" Grid.Column="2" Content="Xtream Code" Click="SourceType_Click" Tag="Xtream" Classes="ActionBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1,1,1,1" Foreground="{DynamicResource TextSec}" CornerRadius="0,8,8,0" Padding="8"/>
						</Grid>
						<!-- YENİ: Kaynak türleri arasındaki farkı basitçe açıklayan
						     yönlendirme metni — "hangi bilgiyi nereden bulacağım"
						     belirsizliğini azaltmak için. -->
						<TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,4,0,0">
							<Run Text="Xtream Code:"/> <Run Text="sağlayıcınızın verdiği sunucu adresi + kullanıcı adı + şifre (bir Xtream/Xtreme Codes panel girişi)." FontWeight="Normal"/>
							<LineBreak/>
							<Run Text="M3U:"/> <Run Text="bilgisayarınızdaki bir .m3u/.m3u8 dosyası." FontWeight="Normal"/>  <Run Text="Link:"/> <Run Text="aynı listenin bir internet adresi (URL)." FontWeight="Normal"/>
						</TextBlock>
					</StackPanel>
					<StackPanel x:Name="InputAreaM3U" Spacing="12">
						<StackPanel x:Name="M3uFilePickerPanel" Spacing="12">
							<Button Classes="ActionBtn" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Click="SelectM3uFile_Click">
								<Panel>
									<Rectangle Stroke="{DynamicResource Border}" StrokeThickness="2" StrokeDashArray="4,4" RadiusX="10" RadiusY="10" Fill="Transparent" Height="90"/>
									<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
										<TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center" Foreground="#FFC107"/>
										<TextBlock Text="M3U dosyasını buraya sürükleyin" Foreground="{DynamicResource Text}" FontWeight="Medium" HorizontalAlignment="Center" FontSize="13"/>
										<TextBlock Text="veya tıklayın" FontSize="11" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center"/>
									</StackPanel>
								</Panel>
							</Button>
							<TextBlock x:Name="SelectedFileName" Text="" Foreground="{DynamicResource Accent}" FontSize="12" HorizontalAlignment="Center" IsVisible="False"/>
							<TextBlock x:Name="SelectedFilePath" IsVisible="False"/>
							<TextBlock Text="veya URL ile ekleyin" FontSize="12" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center"/>
						</StackPanel>
						<TextBox x:Name="M3uUrlInput" Watermark="http:// veya https:// ile başlayan link" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>

						<!-- YENİ (EPG): M3U/Link kaynaklarında yayın akışı (EPG)
						     için sağlayıcının XMLTV linki gerekir; Xtream'in
						     aksine burada otomatik bir uç nokta yoktur. -->
						<TextBlock Text="Yayın Akışı (EPG) linki — opsiyonel" FontSize="12" Foreground="{DynamicResource TextSec}"/>
						<TextBox x:Name="M3uEpgUrlInput" Watermark="ör: http://saglayici.com/xmltv.php  veya  .../epg.xml.gz" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
						<TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSec}" Text="Sağlayıcınız genelde bunu 'EPG URL' veya 'XMLTV URL' adıyla panelinde/duyurularında paylaşır. Bulamıyorsanız boş bırakın; kaynağı EPG'siz de kullanabilir, sonradan kaynağı silip bu linkle yeniden ekleyebilirsiniz."/>
					</StackPanel>
					<StackPanel x:Name="InputAreaXtream" Spacing="10" IsVisible="False">
						<TextBox x:Name="XtreamUrlInput" Watermark="Sunucu URL (http://...)" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
						<TextBox x:Name="XtreamUserInput" Watermark="Kullanıcı Adı" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
						<Grid ColumnDefinitions="*, Auto">
							<TextBox x:Name="XtreamPassInput" Grid.Column="0" Grid.ColumnSpan="2" Watermark="Şifre" PasswordChar="*" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12,12,42,12"/>
							<Button x:Name="XtreamTogglePassBtn" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Classes="IconBtn" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" Click="XtreamTogglePassword_Click" ToolTip.Tip="Şifreyi Göster">
								<TextBlock x:Name="XtreamPassToggleIcon" Text="👁️" FontSize="14" Foreground="{DynamicResource TextSec}"/>
							</Button>
						</Grid>
						<TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSec}" Text="Yayın Akışı (EPG) bu tür kaynaklarda otomatik gelir — sunucunuz xmltv.php destekliyorsa ekstra bir şey girmenize gerek yok."/>
					</StackPanel>
					<Button Classes="ActionBtn" Click="ConfirmAddSource_Click" CornerRadius="8" Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" BorderThickness="0" Margin="0,10,0,0">
						<Button.Background>
							<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
								<GradientStop Color="#4f8bff" Offset="0.0"/>
								<GradientStop Color="#ec4899" Offset="1.0"/>
							</LinearGradientBrush>
						</Button.Background>
						<TextBlock Text="Kaynak Ekle" Foreground="White" FontWeight="Bold"/>
					</Button>
				</StackPanel>
			</Border>
		</Border>

		<!-- ============================================================
		     EPG / Yayın Akışı Zaman Çizelgesi
		     Sol sütun: kanal isimleri (dikey senkronize scroll)
		     Sağ taraf: saat cetveli (üstte, sabit) + program blokları
		     (Canvas üzerinde, hem yatay hem dikey kaydırılabilir).
		     Mantık MainWindow.Epg.cs içindedir.
		     ============================================================ -->
		<Border x:Name="EpgOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#B3000000" IsVisible="False" ZIndex="150">
			<Border Background="{DynamicResource BgCard}" Margin="24" CornerRadius="16" BoxShadow="0 10 40 0 #88000000" ClipToBounds="True">
				<Grid RowDefinitions="Auto, Auto, Auto, *">

					<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20,16,20,0">
						<TextBlock x:Name="EpgTitleText" Text="🗓️ Yayın Akışı (EPG)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
						<Button Grid.Column="1" Content="✕" Click="CloseEpg_Click" Classes="IconBtn" FontSize="16" Foreground="{DynamicResource TextSec}"/>
					</Grid>

					<Grid Grid.Row="1" ColumnDefinitions="220, Auto, *, Auto, Auto, Auto, Auto" Margin="20,12,20,0">
						<ComboBox x:Name="EpgCategoryCombo" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="EpgCategoryCombo_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
						<TextBlock x:Name="EpgStatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSec}" FontSize="11"/>
						<Button Grid.Column="3" Classes="ActionBtn SettingsToggleBtn" Content="◀ Önceki Gün" Click="EpgPrevDay_Click" Margin="0,0,6,0"/>
						<Button Grid.Column="4" Classes="ActionBtn SettingsToggleBtn" Content="Bugün / Şimdi" Click="EpgJumpNow_Click" Margin="0,0,6,0"/>
						<Button Grid.Column="5" Classes="ActionBtn SettingsToggleBtn" Content="Sonraki Gün ▶" Click="EpgNextDay_Click" Margin="0,0,6,0"/>
						<Button Grid.Column="6" Classes="ActionBtn SettingsToggleBtn" Content="↻" ToolTip.Tip="EPG'yi yeniden indir" Click="EpgRefresh_Click" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"/>
					</Grid>

					<Border x:Name="EpgSelectedInfoBar" Grid.Row="2" Margin="20,12,20,0" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="14,10" IsVisible="False">
						<Grid ColumnDefinitions="*, Auto">
							<StackPanel Grid.Column="0" Spacing="3">
								<TextBlock x:Name="EpgSelectedTitleText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
								<TextBlock x:Name="EpgSelectedTimeText" FontSize="11" Foreground="{DynamicResource Accent}"/>
								<TextBlock x:Name="EpgSelectedDescText" FontSize="11" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap" MaxLines="3"/>
							</StackPanel>
							<Button Grid.Column="1" x:Name="EpgPlaySelectedBtn" Classes="ActionBtn" Content="▶ Kanalı Oynat" Click="EpgPlaySelected_Click" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="14,8" BorderThickness="0" VerticalAlignment="Center"/>
						</Grid>
					</Border>

					<Grid Grid.Row="3" ColumnDefinitions="190, *" Margin="20,12,20,20">
						<Grid Grid.Column="0" RowDefinitions="40, *">
							<Border Grid.Row="0" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,1" CornerRadius="8,0,0,0">
								<TextBlock Text="Kanallar" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center" Margin="10,0"/>
							</Border>
							<ScrollViewer x:Name="EpgChannelNamesScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ScrollChanged="EpgChannelNamesScroll_ScrollChanged">
								<Canvas x:Name="EpgChannelNamesPanel"/>
							</ScrollViewer>
						</Grid>

						<ScrollViewer x:Name="EpgTimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
							<Grid RowDefinitions="40, *">
								<Canvas x:Name="EpgHeaderCanvas" Grid.Row="0" Height="40" Background="{DynamicResource BgActive}"/>
								<ScrollViewer x:Name="EpgRowsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" ScrollChanged="EpgRowsScroll_ScrollChanged">
									<Canvas x:Name="EpgRowsCanvas"/>
								</ScrollViewer>
							</Grid>
						</ScrollViewer>
					</Grid>
				</Grid>
			</Border>
		</Border>

		<!-- ============================================================
		     YENİ: Çevrimiçi Güncelleme Bildirim & Kurulum Modalı
		     GitHub Releases API'den yeni bir sürüm tespit edildiğinde
		     veya kullanıcı Ayarlar'dan denetlediğinde açılır.
		     ============================================================ -->
		<Border x:Name="UpdateModalOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#B3000000" IsVisible="False" ZIndex="180">
			<Border Background="{DynamicResource BgCard}" Width="560" MaxHeight="620" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource Border}" BoxShadow="0 24 64 0 #AA000000" ClipToBounds="True">
				<Grid RowDefinitions="Auto, Auto, *, Auto">
					
					<!-- 1. Üst Başlık ve Gradyan Şerit -->
					<Border Grid.Row="0" Padding="20,18,20,14" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
						<Grid ColumnDefinitions="Auto, *, Auto">
							<Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Accent}" Margin="0,0,14,0">
								<TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
								<TextBlock x:Name="UpdateModalTitleText" Text="GlyphTV Güncellemesi Mevcut!" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Border CornerRadius="4" Padding="6,1" Background="#2222c55e">
										<TextBlock x:Name="UpdateModalVersionBadgeText" Text="v2.1.0" FontSize="11" FontWeight="Bold" Foreground="#16a34a"/>
									</Border>
									<TextBlock x:Name="UpdateModalCurrentVersionText" Text="Mevcut: v2.1.0" FontSize="11" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
								</StackPanel>
							</StackPanel>
							<Button Grid.Column="2" Content="✕" Click="CloseUpdateModal_Click" Classes="IconBtn" FontSize="16" Foreground="{DynamicResource TextSec}" VerticalAlignment="Top"/>
						</Grid>
					</Border>

					<!-- 2. Meta Bilgi Çubuğu (Yayın Tarihi & Dosya Boyutu) -->
					<Border Grid.Row="1" Background="{DynamicResource BgHover}" Padding="20,10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
						<Grid ColumnDefinitions="*, *">
							<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
								<TextBlock Text="📅" FontSize="12"/>
								<TextBlock x:Name="UpdateModalDateText" Text="22 Ağustos 2026" FontSize="12" Foreground="{DynamicResource TextSec}"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
								<TextBlock Text="📦" FontSize="12"/>
								<TextBlock x:Name="UpdateModalSizeText" Text="Setup Paketi" FontSize="12" Foreground="{DynamicResource TextSec}"/>
							</StackPanel>
						</Grid>
					</Border>

					<!-- 3. Sürüm Notları (Changelog) -->
					<Grid Grid.Row="2" RowDefinitions="Auto, *" Margin="20,14,20,14">
						<TextBlock Grid.Row="0" Text="SÜRÜM NOTLARI &amp; YENİLİKLER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSec}" Margin="0,0,0,8"/>
						<Border Grid.Row="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" MaxHeight="220">
							<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
								<TextBlock x:Name="UpdateModalChangelogText" Text="Yenilikler..." Foreground="{DynamicResource Text}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
							</ScrollViewer>
						</Border>
					</Grid>

					<!-- 4. Alt İşlem / İndirme İlerleme Alanı -->
					<Border Grid.Row="3" Background="{DynamicResource BgCard}" Padding="20,14,20,18" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
						<Grid>
							<!-- İndirme İlerleme Çubuğu (İndirilirken Görünür) -->
							<StackPanel x:Name="UpdateDownloadPanel" Spacing="8" IsVisible="False">
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock x:Name="UpdateProgressStatusText" Text="İndiriliyor... %0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
								</Grid>
								<ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" CornerRadius="4" Foreground="{DynamicResource Accent}"/>
								<TextBlock Text="İndirme tamamlandığında GlyphTV otomatik güncellenip yeniden başlayacaktır." FontSize="11" Foreground="{DynamicResource TextSec}"/>
							</StackPanel>

							<!-- İşlem Butonları (Normal Durumda Görünür) -->
							<Grid x:Name="UpdateActionButtonsPanel" ColumnDefinitions="*, Auto, Auto" Margin="0" HorizontalAlignment="Stretch">
								<Button Grid.Column="0" x:Name="BtnUpdateNow" Classes="ActionBtn" Click="UpdateNow_Click" CornerRadius="8" Padding="16,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
									<Button.Background>
										<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
											<GradientStop Color="#4f8bff" Offset="0.0"/>
											<GradientStop Color="#ec4899" Offset="1.0"/>
										</LinearGradientBrush>
									</Button.Background>
									<TextBlock Text="🚀 Şimdi Güncelle" Foreground="White" FontWeight="Bold" FontSize="13"/>
								</Button>

								<Button Grid.Column="1" Classes="ActionBtn" Click="UpdateOpenGithub_Click" Background="Transparent" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,10,0" Cursor="Hand">
									<TextBlock Text="🌐 GitHub'da Aç" FontSize="12" FontWeight="Medium"/>
								</Button>

								<Button Grid.Column="2" Classes="ActionBtn" Click="CloseUpdateModal_Click" Background="Transparent" Foreground="{DynamicResource TextSec}" BorderThickness="0" CornerRadius="8" Padding="12,10" Cursor="Hand">
									<TextBlock Text="Daha Sonra" FontSize="12"/>
								</Button>
							</Grid>
						</Grid>
					</Border>

				</Grid>
			</Border>
		</Border>

		<!-- Toast Bildirimi -->
		<Border x:Name="NotificationToast" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" Background="{DynamicResource Text}" CornerRadius="20" Padding="20,10" IsVisible="False" ZIndex="200" BoxShadow="0 4 15 0 #40000000">
			<TextBlock x:Name="NotificationText" Text="Bildirim mesajı" Foreground="{DynamicResource BgCard}" FontWeight="Medium" FontSize="14"/>
		</Border>

	</Grid>
</Window>
