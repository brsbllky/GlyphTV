																<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
																	<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" FontSize="13"/>
																	<TextBlock Text="{Binding SourceSummaryText}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
																</StackPanel>
																<Button Grid.Column="2" Classes="ActionBtn" Click="SelectSource_Click" Tag="{Binding}" Background="Transparent" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="6" Width="78" Height="28" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" ToolTip.Tip="Kaynağı Seç / Aktif Et">
																	<StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
																		<Border Width="7" Height="7" CornerRadius="3.5" Background="{Binding StatusBrush}"/>
																		<TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="11"/>
																	</StackPanel>
																</Button>
