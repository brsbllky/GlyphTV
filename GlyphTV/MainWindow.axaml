<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:local="clr-namespace:GlyphTV"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Class="GlyphTV.MainWindow"
        Title="GlyphTV"
        Width="1210" Height="775"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Icon="avares://GlyphTV/icon.ico"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        x:Name="MainWindowRoot"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg">#f5f5f7</SolidColorBrush>
        <SolidColorBrush x:Key="BgSidebar">#f0f0f2</SolidColorBrush>
        <SolidColorBrush x:Key="BgCard">#ffffff</SolidColorBrush>
        <SolidColorBrush x:Key="BgHover">#e8e8ec</SolidColorBrush>
        <SolidColorBrush x:Key="BgActive">#e2e2e8</SolidColorBrush>
        <SolidColorBrush x:Key="Border">#d4d4d8</SolidColorBrush>
        <SolidColorBrush x:Key="Text">#18181b</SolidColorBrush>
        <SolidColorBrush x:Key="TextSec">#6b6b73</SolidColorBrush>
        <SolidColorBrush x:Key="Accent">#a855f7</SolidColorBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
        </Style>
        <Style Selector="TextBox:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
        </Style>

	<!-- TextBox - tüm state'lerde kendi foreground'unu kullan -->
    <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="SelectionBrush" Value="#554f8bff"/>
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Style.Resources>
        <!-- Avalonia Fluent teması bu resource'u hover'da kullanıyor -->
        <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource TextColor}"/>
    </Style.Resources>
</Style>
		
        <Style Selector="Button.ActionBtn">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ActionBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
        </Style>
        <Style Selector="Button.ActionBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
        </Style>

        <!-- Windows tarzı pencere kontrol butonları -->
        <Style Selector="Button.WinBtn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.WinBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.WinBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.WinBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgActive}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- Kapat butonu hover'da kırmızı -->
        <Style Selector="Button.WinCloseBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#e81123"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.WinCloseBtn:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.WinCloseBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#f1707a"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.MenuBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.MenuBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.MenuBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.CatCard">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="11,11"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.CatCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
        </Style>

        <!-- VOD poster kart stili -->
        <Style Selector="Border.VodCardBorder">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="220"/>
        </Style>
        <Style Selector="Border.VodCardBorder:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgHover}"/>
        </Style>

        <Style Selector="Border.ContentItemBorder">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="295"/>
            <Setter Property="Height" Value="90"/>
        </Style>
        <Style Selector="Border.ContentItemBorder:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgHover}"/>
        </Style>
        
        <Style Selector="Button.IconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.IconBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
        </Style>
        <Style Selector="Button.IconBtn:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <Style Selector="Border.SettingsCard">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
            <Setter Property="Width" Value="340"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- YENİ: Player içi ikon butonları (flicker önlemek için ayrı stil) -->
        <Style Selector="Button.PlayerIconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="Button.PlayerIconBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.PlayerIconBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33a855f7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.PlayerIconBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#55a855f7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- YENİ: Merkez yuvarlak Oynat/Duraklat butonu -->
        <Style Selector="Button.PlayBtn">
            <Setter Property="Background" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.PlayBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#55FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="21"/>
        </Style>
        <Style Selector="Button.PlayBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#88FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.PlayBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#AAFFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- YENİ: Player üst barındaki "Ses Dili / Kanallar / Altyazı" butonları -->
        <Style Selector="Button.PlayerTopBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.PlayerTopBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.PlayerTopBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33a855f7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.PlayerTopBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#55a855f7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- YENİ: Player içindeki kanal listesi buton stili -->
        <Style Selector="Button.PlayerChannelBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="Button.PlayerChannelBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.PlayerChannelBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33a855f7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- YENİ: Popup içindeki track seçim butonları -->
        <Style Selector="Button.TrackBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.TrackBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.TrackBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#a855f7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" ColumnDefinitions="220, *">
        
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,11,0,0">
            <Grid RowDefinitions="Auto, *">
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="18,0,18,2">
                    <Image Source="avares://GlyphTV/Assets/glyph_icon.png" 
                           Width="260" 
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0">
                    <Button x:Name="BtnLive" Classes="MenuBtn Active" Click="MenuFilter_Click" Tag="Canlı">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📺" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Canlı TV" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnVOD" Classes="MenuBtn" Click="MenuFilter_Click" Tag="VOD">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🎬" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Filmler (VOD)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSeries" Classes="MenuBtn" Click="MenuFilter_Click" Tag="Dizi">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🎞️" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Diziler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Height="1" Background="{DynamicResource Border}" Margin="4,10"/>
                    <Button x:Name="BtnFav" Classes="MenuBtn" Click="MenuFilter_Click" Tag="Favori">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🤍" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Favoriler" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSettings" Classes="MenuBtn" Click="MenuFilter_Click" Tag="Ayarlar">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🛠️" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Column="1" RowDefinitions="46, *">
            
            <Border x:Name="TitleBarPanel" Grid.Row="0" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="*, Auto, *">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="2" CornerRadius="12" Height="28" Width="400" Padding="14,0">
                            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" Watermark="İçerik ara..." VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Stretch" Spacing="0">
                        <Button Classes="WinBtn" Click="MinimizeWindow_Click">
                            <TextBlock Text="─" FontSize="12" Foreground="{DynamicResource TextSec}"/>
                        </Button>
                        <Button Classes="WinBtn" Click="MaximizeWindow_Click">
                            <TextBlock Text="□" FontSize="13" Foreground="{DynamicResource TextSec}"/>
                        </Button>
                        <Button Classes="WinBtn WinCloseBtn" Click="CloseWindow_Click">
                            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSec}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                
                <Grid x:Name="PlayerContainer" VerticalAlignment="Top" Height="0" ZIndex="10" ClipToBounds="True">
                    <vlc:VideoView x:Name="MainVideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid x:Name="PlayerOverlayRoot" Background="#01000000" PointerMoved="PlayerContainer_PointerMoved" PointerPressed="PlayerOverlay_PointerPressed">
                    
                    <!-- ÜST BAR: Başlık + sağ aksiyon butonları -->
                    <Border x:Name="PlayerTopBar" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="#CC1a1a1f" Padding="20,12">
                        <Border.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                        </Border.Resources>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock x:Name="PlayerTitleText" Grid.Column="0" Text="Kanal Adı" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Canlı modunda: Ses Dili -->
                                <Button x:Name="BtnAudioTrack" Classes="PlayerTopBtn" Click="AudioTrack_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🎵" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ses Dili" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Canlı modunda: Kanallar -->
                                <Button x:Name="BtnChannelList" Classes="PlayerTopBtn" Click="ToggleChannelList_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="☰" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kanallar" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- VOD/Dizi modunda: Altyazı / Dil -->
                                <Button x:Name="BtnAspectRatio" Classes="PlayerTopBtn" Click="AspectRatio_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Grid Width="36" Height="20">
                                            <Canvas Width="36" Height="20">
                                                <!-- Dış çerçeve -->
                                                <Border Canvas.Left="0" Canvas.Top="0" Width="36" Height="20"
                                                        BorderBrush="White" BorderThickness="1.5" CornerRadius="2"
                                                        Background="Transparent" Opacity="0.9"/>
                                                <!-- Sol üst köşe -->
                                                <Border Canvas.Left="2.5" Canvas.Top="2.5" Width="8" Height="1.5" Background="White" Opacity="0.9"/>
                                                <Border Canvas.Left="2.5" Canvas.Top="2.5" Width="1.5" Height="6" Background="White" Opacity="0.9"/>
                                                <!-- Sağ alt köşe -->
                                                <Border Canvas.Left="25.5" Canvas.Top="16" Width="8" Height="1.5" Background="White" Opacity="0.9"/>
                                                <Border Canvas.Left="32" Canvas.Top="11.5" Width="1.5" Height="6" Background="White" Opacity="0.9"/>
                                            </Canvas>
                                            <TextBlock x:Name="AspectRatioText" Text="16:9"
                                                       Foreground="White" FontSize="9" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSubtitle" Classes="PlayerTopBtn" Click="Subtitle_Click" IsVisible="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="💬" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Altyazı / Dil" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ALT BAR: Seek bar + kontrol butonları -->
                    <Border x:Name="PlayerBottomBar" VerticalAlignment="Bottom" Background="#E61a1a1f" Padding="20,15">
                        <Border.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                        </Border.Resources>
                        <StackPanel Spacing="8">
                            <!-- Seek bar - sadece VOD/Dizi için görünür -->
                            <Grid x:Name="SeekBarContainer" ColumnDefinitions="Auto, *, Auto" IsVisible="False">
                                <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="00:00" Foreground="White" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Slider x:Name="TimeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource Accent}" 
                                        ValueChanged="TimeSlider_ValueChanged"/>
                                <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="00:00" Foreground="White" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Kontrol satırı -->
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <!-- SOL: Navigasyon butonları -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <!-- Canlı: Önceki kanal (yukarı ok) -->
                                    <Button x:Name="PrevChannelBtn" Classes="PlayerIconBtn" Click="PrevChannel_Click">
                                        <TextBlock Text="⏮️" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    </Button>
                                    <!-- VOD: 10 sn geri -->
                                    <Button x:Name="SkipBackBtn" Classes="PlayerIconBtn" Click="SkipBack_Click" IsVisible="False">
                                        <TextBlock Text="⏪" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    </Button>
                                    
                                    <!-- Oynat/Duraklat (yuvarlak buton) -->
                                    <Button x:Name="PlayPauseBtn" Classes="PlayBtn" Click="PlayPause_Click">
                                        <TextBlock x:Name="PlayPauseIcon" Text="⏸" Foreground="White" FontSize="18"/>
                                    </Button>
                                    
                                    <!-- Canlı: Sonraki kanal (aşağı ok) -->
                                    <Button x:Name="NextChannelBtn" Classes="PlayerIconBtn" Click="NextChannel_Click">
                                        <TextBlock Text="⏭️" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    </Button>
                                    <!-- VOD: 10 sn ileri -->
                                    <Button x:Name="SkipForwardBtn" Classes="PlayerIconBtn" Click="SkipForward_Click" IsVisible="False">
                                        <TextBlock Text="⏩️" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    </Button>
                                    <!-- YENİ - Dizi: Sonraki bölüm -->
                                    <Button x:Name="NextEpisodeBtn" Classes="PlayerIconBtn" Click="NextEpisode_Click" IsVisible="False" ToolTip.Tip="Sonraki Bölüm">
                                        <TextBlock Text="⏭" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    </Button>
                                    <!-- VOD/Dizi: Oynatma hızı -->
                                    <Button x:Name="SpeedBtn" Classes="PlayerIconBtn" Click="Speed_Click" IsVisible="False" ToolTip.Tip="Oynatma Hızını Değiştir">
                                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                                            <Viewbox Width="24" Height="13" HorizontalAlignment="Center">
                                                <Canvas Width="512" Height="278.862">
                                                    <Path Fill="White"
                                                          Data="M0 255.999C0 185.311 28.655 121.31 74.982 74.982 121.311 28.655 185.311 0 256.001 0c55.455 0 106.794 17.638 148.714 47.607l-26.682 22.017c-29.757-19.521-64.47-32.109-101.845-35.468v29.067h-40.377V34.156c-45.225 4.063-86.554 21.643-119.916 48.665l24.793 24.794-28.549 28.549-25.202-25.202c-33.462 38.969-53.685 89.641-53.685 145.037H0zM450.497 89.547C488.837 134.304 512 192.448 512 255.999h-33.252c0-53.029-18.531-101.73-49.467-139.979l21.216-26.473z"/>
                                                    <Path Fill="#EF1C25"
                                                          Data="M233.323 220.86c-38.904 32.143 13.131 86.245 48.238 40.188L440.179 63.123l-7.427-6.826L233.323 220.86z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="SpeedBtnText" Text="1x" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                
                                <!-- SAĞ: Ses + tam ekran + kapat -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button x:Name="MuteBtn" Classes="PlayerIconBtn" Click="Mute_Click">
                                        <TextBlock x:Name="MuteIcon" Text="🔊" Foreground="White" FontSize="14"/>
                                    </Button>
                                    <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="200" Value="100" ValueChanged="VolumeSlider_ValueChanged" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="VolumeText" Text="100%" Foreground="White" FontSize="11" VerticalAlignment="Center" Width="38"/>
                                    <Button Classes="PlayerIconBtn" Click="Fullscreen_Click" Margin="8,0,0,0">
                                        <TextBlock Text="⛶" Foreground="White" FontSize="16"/>
                                    </Button>
                                    <Button Classes="PlayerIconBtn" Click="ClosePlayer_Click">
                                        <TextBlock Text="✕" Foreground="White" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- KANAL LİSTESİ PANELİ (sağdan kayan) -->
                    <Border x:Name="ChannelListPanel" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="340" Background="#F21a1a1f" BorderBrush="#33a855f7" BorderThickness="1,0,0,0" IsVisible="False" ZIndex="20">
                        <Border.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22a855f7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#44a855f7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                        </Border.Resources>
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,16,12,12">
                                <TextBlock Text="Kanallar" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="PlayerIconBtn" Click="CloseChannelList_Click">
                                    <TextBlock Text="✕" Foreground="White" FontSize="14"/>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" Padding="8,0,8,8">
                                <StackPanel x:Name="PlayerChannelListContainer" Spacing="1"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- SES DİLİ POPUP (canlı için) -->
                    <Border x:Name="AudioTrackPopup" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,20,0" Background="#F21a1a1f" BorderBrush="#44a855f7" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="False" MinWidth="220" MaxHeight="400" ZIndex="25">
                        <Border.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22a855f7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#44a855f7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                        </Border.Resources>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ses Dili" Foreground="White" FontWeight="Bold" FontSize="13" Margin="4,0,4,8"/>
                                <StackPanel x:Name="AudioTrackContainer" Spacing="2"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ALTYAZI + SES DİLİ POPUP (VOD/Dizi için) -->
                    <Border x:Name="SubtitlePopup" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,20,0" Background="#F21a1a1f" BorderBrush="#44a855f7" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="False" MinWidth="240" MaxHeight="500" ZIndex="25">
                        <Border.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22a855f7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#44a855f7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                        </Border.Resources>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Altyazı" Foreground="White" FontWeight="Bold" FontSize="13" Margin="4,0,4,8"/>
                                <StackPanel x:Name="SubtitleContainer" Spacing="2" Margin="0,0,0,12"/>
                                <Border Height="1" Background="#33FFFFFF" Margin="0,0,0,12"/>
                                <TextBlock Text="Ses Dili" Foreground="White" FontWeight="Bold" FontSize="13" Margin="4,0,4,8"/>
                                <StackPanel x:Name="AudioTrackContainerVod" Spacing="2"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Aspect Ratio popup -->
                    <Border x:Name="AspectRatioPopup" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,20,0" Background="#F21a1a1f" BorderBrush="#44a855f7" BorderThickness="1" CornerRadius="10" Padding="12" IsVisible="False" MinWidth="200" ZIndex="25">
                        <Border.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22a855f7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#44a855f7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                        </Border.Resources>
                        <StackPanel>
                            <TextBlock Text="En:Boy Oranı" Foreground="#a855f7" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Button Classes="TrackBtn" Click="SetAspectRatio_Click" Tag="" Content="Orijinal" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Foreground="White"/>
                            <Button Classes="TrackBtn" Click="SetAspectRatio_Click" Tag="16:9" Content="16:9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Foreground="White"/>
                            <Button Classes="TrackBtn" Click="SetAspectRatio_Click" Tag="4:3" Content="4:3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Foreground="White"/>
                            <Button Classes="TrackBtn" Click="SetAspectRatio_Click" Tag="21:9" Content="21:9 (Sinema)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Foreground="White"/>
                            <Button Classes="TrackBtn" Click="SetAspectRatio_Click" Tag="fill" Content="Ekranı Doldur" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Foreground="White"/>
                        </StackPanel>
                    </Border>
                        </Grid>
                    </vlc:VideoView>
                </Grid>

                <ScrollViewer x:Name="ContentScrollViewer" Margin="28,24" ScrollChanged="ContentScrollViewer_ScrollChanged">
                    <StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24" Spacing="10">
                            <Button x:Name="BackBtn" Classes="IconBtn" Content="❮ Geri" Click="Back_Click" Foreground="{DynamicResource TextSec}" FontWeight="Bold" IsVisible="False"/>
                            <TextBlock x:Name="PageTitle" Text="Canlı TV" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                        </StackPanel>

                        <ItemsControl x:Name="CategoriesGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CategoryItem">
                                    <Button Classes="CatCard" Click="Category_Click" Tag="{Binding Name}">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Count, StringFormat='{}({0})'}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="❯" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl x:Name="ContentItemsGrid" IsVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Channel">
                                    <Border Classes="ContentItemBorder">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="10">
                                            <Button Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" Click="Content_Click" Tag="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12" Cursor="Hand"/>
                                            
                                            <!-- Logo veya fallback ▶ ikonu -->
                                            <Grid Grid.Column="0" Width="40" Height="40" IsHitTestVisible="False">
                                                <Border CornerRadius="10" Background="#1A4f8bff" IsVisible="{Binding NoLogo}">
                                                    <TextBlock Text="▶" Foreground="{DynamicResource Accent}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border CornerRadius="10" Background="#0A000000" IsVisible="{Binding HasLogo}" ClipToBounds="True">
                                                    <Image Source="{Binding LogoBitmap}" Stretch="Uniform" Margin="2"/>
                                                </Border>
                                            </Grid>
                                            
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Classes="IconBtn" Content="{Binding FavoriteIcon}" Foreground="{Binding FavoriteBrush}" Click="ToggleFavorite_Click" Tag="{Binding}" FontSize="20" VerticalAlignment="Center" Margin="2,0" ToolTip.Tip="Favorilere Ekle/Çıkar"/>
                                            
                                            <Button Grid.Column="3" Classes="IconBtn" Content="🚫" Click="HideContent_Click" Tag="{Binding}" Foreground="{DynamicResource TextSec}" FontSize="14" VerticalAlignment="Center" Margin="2,0" ToolTip.Tip="İçeriği Gizle"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- YENİ: VOD poster kartları - film/dizi afişi tarzı -->
                        <ItemsControl x:Name="VodContentGrid" IsVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Channel">
                                    <Border Classes="VodCardBorder">
                                        <Grid ColumnDefinitions="Auto, *">
                                            
                                            <!-- Sol: Poster / Logo -->
                                            <Border Grid.Column="0" Width="130" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
                                                <Grid>
                                                    <Border Background="#1A4f8bff" IsVisible="{Binding NoLogo}">
                                                        <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                                    </Border>
                                                    <Border Background="#0A000000" IsVisible="{Binding HasLogo}">
                                                        <Image Source="{Binding LogoBitmap}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- Sağ: Bilgi + Dikey butonlar -->
                                            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                                                
                                                <!-- Üst: Film adı ve kategori -->
                                                <StackPanel Grid.Row="0" Margin="14,14,14,0" IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Name}"/>
                                                    <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                
                                                <!-- Alt: Dikey butonlar -->
                                                <StackPanel Grid.Row="1" Margin="14,10,14,12" VerticalAlignment="Bottom" Spacing="5">
                                                    <!-- ▶ Oynat (her zaman) -->
                                                    <Button Classes="ActionBtn" Click="Content_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                        <TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                                    </Button>
                                                    <!-- ▶ Devam Et (sadece yarım bırakılmışsa) -->
                                                    <Button Classes="ActionBtn" Click="Content_Resume_Click" Tag="{Binding}" Background="#22a855f7" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
                                                        <TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                    </Button>
                                                    <!-- ♡ Favori üstte, ⓘ Detay altta -->
                                                    <Button Classes="ActionBtn" Click="ToggleFavorite_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Favori" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="ActionBtn" Click="VodInfo_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Detay" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- YENİ: Dizi poster kartları - sezon/bölüm navigasyonlu -->
                        <ItemsControl x:Name="SeriesContentGrid" IsVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SeriesCard">
                                    <Border Classes="VodCardBorder" Height="240">
                                        <Grid ColumnDefinitions="Auto, *">
                                            
                                            <!-- Sol: Poster -->
                                            <Border Grid.Column="0" Width="130" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
                                                <Grid>
                                                    <Border Background="#1A4f8bff" IsVisible="{Binding NoLogo}">
                                                        <TextBlock Text="🎞️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                                    </Border>
                                                    <Border Background="#0A000000" IsVisible="{Binding HasLogo}">
                                                        <Image Source="{Binding LogoBitmap}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- Sağ: Bilgi + Navigasyon -->
                                            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                                                
                                                <!-- Üst: Dizi adı + kategori -->
                                                <StackPanel Grid.Row="0" Margin="14,12,14,0" IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding ShowName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ShowName}"/>
                                                    <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                
                                                <!-- Alt: Butonlar -->
                                                <StackPanel Grid.Row="1" Margin="14,8,14,12" VerticalAlignment="Bottom" Spacing="5">
                                                    <!-- ▶ Oynat (her zaman) -->
                                                    <Button Classes="ActionBtn" Click="PlaySeries_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                        <TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                                    </Button>
                                                    <!-- ▶ Devam Et (sadece yarım bırakılmışsa) -->
                                                    <Button Classes="ActionBtn" Click="PlaySeriesResume_Click" Tag="{Binding}" Background="#22a855f7" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
                                                        <TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                    </Button>
                                                    <!-- < Sezon > -->
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <Button Grid.Column="0" Classes="ActionBtn" Click="PrevSeason_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding SeasonText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Button Grid.Column="2" Classes="ActionBtn" Click="NextSeason_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
                                                    </Grid>
                                                    <!-- < Bölüm > -->
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <Button Grid.Column="0" Classes="ActionBtn" Click="PrevEpisode_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding EpisodeText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Button Grid.Column="2" Classes="ActionBtn" Click="NextEpisode_Click2" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
                                                    </Grid>
                                                    <!-- ⓘ Detay + ♡ Favori -->
                                                    <Grid ColumnDefinitions="*, *">
                                                        <Button Grid.Column="0" Classes="ActionBtn" Click="SeriesInfo_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Detay" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="ActionBtn" Click="SeriesFav_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Favori" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ══════════════════════════════════════════════════════
                             FAVORİLER PANELİ
                             Canlı TV kategori kartları + Film poster kartları +
                             Dizi poster kartları – tek sayfada gruplanmış
                             ══════════════════════════════════════════════════════ -->
                        <StackPanel x:Name="FavoriPanel" IsVisible="False" Spacing="0">

                            <!-- ── Canlı TV Favorileri ──────────────────────────── -->
                            <StackPanel x:Name="FavoriLiveSection" IsVisible="False" Margin="0,0,0,32">
                                <TextBlock Text="Canlı TV" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Text}" Margin="0,0,0,16"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FavoriLiveGrid">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <Button Classes="CatCard" Click="FavoriCategory_Click" Tag="{Binding}">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="{Binding}" FontSize="14" FontWeight="Medium"
                                                               Foreground="{DynamicResource Text}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="❯"
                                                               Foreground="{DynamicResource TextSec}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- ── Filmler Favorileri ───────────────────────────── -->
                            <StackPanel x:Name="FavoriVodSection" IsVisible="False" Margin="0,0,0,32">
                                <TextBlock Text="Filmler" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Text}" Margin="0,0,0,16"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FavoriVodGrid">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:Channel">
                                            <Border Classes="VodCardBorder">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Border Grid.Column="0" Width="130" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
                                                        <Grid>
                                                            <Border Background="#1A4f8bff" IsVisible="{Binding NoLogo}">
                                                                <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                                            </Border>
                                                            <Border Background="#0A000000" IsVisible="{Binding HasLogo}">
                                                                <Image Source="{Binding LogoBitmap}" Stretch="UniformToFill"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Column="1" RowDefinitions="Auto, *">
                                                        <StackPanel Grid.Row="0" Margin="14,14,14,0" IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Name}"/>
                                                            <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Margin="14,10,14,12" VerticalAlignment="Bottom" Spacing="5">
                                                            <Button Classes="ActionBtn" Click="Content_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                                <TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                                            </Button>
                                                            <Button Classes="ActionBtn" Click="Content_Resume_Click" Tag="{Binding}" Background="#22a855f7" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
                                                                <TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                            </Button>
                                                            <Button Classes="ActionBtn" Click="ToggleFavorite_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Favori" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Classes="ActionBtn" Click="VodInfo_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Detay" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- ── Diziler Favorileri ───────────────────────────── -->
                            <StackPanel x:Name="FavoriSeriesSection" IsVisible="False" Margin="0,0,0,32">
                                <TextBlock Text="Diziler" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Text}" Margin="0,0,0,16"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="FavoriSeriesGrid">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:SeriesCard">
                                            <Border Classes="VodCardBorder" Height="240">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Border Grid.Column="0" Width="130" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
                                                        <Grid>
                                                            <Border Background="#1A4f8bff" IsVisible="{Binding NoLogo}">
                                                                <TextBlock Text="🎞️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                                            </Border>
                                                            <Border Background="#0A000000" IsVisible="{Binding HasLogo}">
                                                                <Image Source="{Binding LogoBitmap}" Stretch="UniformToFill"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Column="1" RowDefinitions="Auto, *">
                                                        <StackPanel Grid.Row="0" Margin="14,12,14,0" IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding ShowName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ShowName}"/>
                                                            <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Margin="14,8,14,12" VerticalAlignment="Bottom" Spacing="5">
                                                            <Button Classes="ActionBtn" Click="PlaySeries_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                                <TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                                            </Button>
                                                            <Button Classes="ActionBtn" Click="PlaySeriesResume_Click" Tag="{Binding}" Background="#22a855f7" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
                                                                <TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                            </Button>
                                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                                <Button Grid.Column="0" Classes="ActionBtn" Click="PrevSeason_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
                                                                <Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding SeasonText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Button Grid.Column="2" Classes="ActionBtn" Click="NextSeason_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                                <Button Grid.Column="0" Classes="ActionBtn" Click="PrevEpisode_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
                                                                <Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding EpisodeText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Button Grid.Column="2" Classes="ActionBtn" Click="NextEpisode_Click2" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="*, *">
                                                                <Button Grid.Column="0" Classes="ActionBtn" Click="SeriesInfo_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Detay" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Grid.Column="1" Classes="ActionBtn" Click="SeriesFav_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Favori" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                        </StackPanel>
                        <!-- ══════════════════════════════════════════════════════ -->

                        <WrapPanel x:Name="SettingsPanel" IsVisible="False" Orientation="Horizontal">
                            
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
                                        <TextBlock Text="✨" FontSize="18"/>
                                        <TextBlock Text="Genel" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Tema" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
                                            <TextBlock Text="Açık veya koyu tema" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="SettingsThemeBtn" Classes="ActionBtn" Grid.Column="1" Content="☀️ Açık" Click="ThemeToggle_Click" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="12,8"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,16"/>
                                    <!-- YENİ: Otomatik kaynak yenileme -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Otomatik Yenileme" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
                                            <TextBlock Text="Açılışta kaynağı otomatik yenile" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="AutoRefreshBtn" Classes="ActionBtn" Grid.Column="1" Content="✕ Kapalı" Click="AutoRefreshToggle_Click" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="12,8"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,16"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Sıfırla" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
                                            <TextBlock Text="Tüm ayarları varsayılana döndür" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ActionBtn" Content="↺ Sıfırla" Click="ResetApp_Click" Background="Transparent" Foreground="#ff5f57" BorderBrush="#ff5f57" BorderThickness="1" CornerRadius="8" Padding="12,8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <Border Classes="SettingsCard">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
                                        <TextBlock Text="🖧" FontSize="18" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Kaynaklar" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <ItemsControl x:Name="SourcesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:TvSource">
                                                <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                                    <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
                                                            <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="ActionBtn" Content="{Binding StatusText}" Click="SelectSource_Click" Tag="{Binding}" Background="Transparent" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <Button Grid.Column="2" Classes="ActionBtn" Content="↻" Click="RefreshSource_Click" Tag="{Binding}" Background="Transparent" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="10,4" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" ToolTip.Tip="Kaynağı Yenile"/>
                                                        <Button Grid.Column="3" Classes="ActionBtn" Content="Sil" Click="DeleteSource_Click" Tag="{Binding}" Background="Transparent" Foreground="#ff5f57" BorderBrush="#ff5f57" BorderThickness="1" CornerRadius="6" Padding="10,4"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <Button Classes="ActionBtn" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Click="ShowChangeSource_Click">
                                        <Panel>
                                            <Rectangle Stroke="{DynamicResource Border}" StrokeThickness="2" StrokeDashArray="4,4" RadiusX="10" RadiusY="10" Fill="Transparent"/>
                                            <TextBlock Text="+ Yeni Kaynak Ekle" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" Margin="0,16"/>
                                        </Panel>
                                    </Button>
                                </StackPanel>
                            </Border>

							<Border Classes="SettingsCard">
								<StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
										<TextBlock Text="📥" FontSize="18"/>
										<TextBlock Text="Dışa Aktar" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
									</StackPanel>
									<Grid ColumnDefinitions="*, Auto">
										<StackPanel VerticalAlignment="Center">
											<TextBlock Text="Favoriler" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
											<TextBlock x:Name="FavCountText" Text="0 favori içerik" FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
										</StackPanel>
										<Button Grid.Column="1" Classes="ActionBtn" Click="ExportJson_Click" CornerRadius="8" Padding="16,8" BorderThickness="0">
											<Button.Background>
												<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
													<GradientStop Color="#a855f7" Offset="0.0"/>
													<GradientStop Color="#ec4899" Offset="1.0"/>
												</LinearGradientBrush>
											</Button.Background>
											<StackPanel Orientation="Horizontal" Spacing="6">
												<TextBlock Text="📥" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
												<TextBlock Text="M3U" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
											</StackPanel>
										</Button>
									</Grid>
								</StackPanel>
							</Border>

							<!-- GÜNCELLENEN GİZLİ İÇERİKLER KARTI (Çerçeveli Liste) -->
							<Border Classes="SettingsCard">
								<StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
										<TextBlock Text="⛔" FontSize="18"/>
										<TextBlock x:Name="HiddenCountTitle" Text="Gizli İçerikler (0)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
									</StackPanel>

									<TextBlock x:Name="HiddenEmptyText" Text="Gizli içerik yok" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center" Margin="0,10"/>

									<ScrollViewer MaxHeight="180">
										<ItemsControl x:Name="HiddenItemsList" IsVisible="False">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="local:Channel">
													<!-- Her bir gizli içerik için şık bir çerçeve -->
													<Border Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
														<Grid ColumnDefinitions="*, Auto">
															<TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
															<Button Grid.Column="1" Classes="ActionBtn" Content="Geri Al" Click="RestoreHidden_Click" Tag="{Binding}" Background="{DynamicResource BgCard}" Foreground="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="10,4" FontSize="11"/>
														</Grid>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</ScrollViewer>
								</StackPanel>
							</Border>

							<!-- HAKKINDA KARTI -->
							<Border Classes="SettingsCard">
								<StackPanel>
									<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
										<TextBlock Text="ⓘ" FontSize="18"/>
										<TextBlock Text="Hakkında" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
									</StackPanel>
                                    
									<!-- Logo + İsim -->
									<StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
										<Image Source="avares://GlyphTV/Assets/glyph_icon.png" Width="260" RenderOptions.BitmapInterpolationMode="HighQuality"/>
									</StackPanel>
									
									<!-- Sürüm -->
									<Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
										<TextBlock Text="Sürüm" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
										<TextBlock Grid.Column="1" Text="2.3.1" Foreground="{DynamicResource TextSec}"/>
									</Grid>

									<!-- Geliştirici -->
									<Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
										<TextBlock Text="Geliştirici" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
										<TextBlock Grid.Column="1" Text="Barış Ballıkaya" Foreground="{DynamicResource TextSec}"/>
									</Grid>

									<!-- Telif -->
									<Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
										<TextBlock Text="Telif" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
										<TextBlock Grid.Column="1" Text="© 2026" Foreground="{DynamicResource TextSec}"/>
									</Grid>

									<!-- Çerçeveli açıklama -->
									<Border Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
										<StackPanel Spacing="6">
											<TextBlock Text="GlyphTV™" FontWeight="Bold" Foreground="{DynamicResource Text}" FontSize="13"/>
											<TextBlock Text="Modern IPTV oynatıcı. Avalonia UI ve LibVLCSharp ile geliştirilmiştir."
													   Foreground="{DynamicResource TextSec}" FontSize="11" TextWrapping="Wrap"/>
											<TextBlock Text="Tüm hakları saklıdır." Foreground="{DynamicResource TextSec}" FontSize="11" FontStyle="Italic" Margin="0,4,0,0"/>
										</StackPanel>
									</Border>
								</StackPanel>
							</Border>
							
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- YENİ: Film detay bilgi paneli -->
        <Border x:Name="VodInfoOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#B3000000" IsVisible="False" ZIndex="100">
            <Border Background="{DynamicResource BgCard}" Width="650" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" BoxShadow="0 10 40 0 #88000000" ClipToBounds="True">
                <Grid RowDefinitions="Auto, *">
                    <!-- Üst bar: Başlık + Kapat -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,18,24,0">
                        <TextBlock x:Name="VodInfoModalTitle" Text="Film Detayları" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Click="CloseVodInfo_Click" Classes="IconBtn" FontSize="16" Foreground="{DynamicResource TextSec}"/>
                    </Grid>
                    
                    <!-- İçerik -->
                    <ScrollViewer Grid.Row="1" Margin="24,16,24,24" MaxHeight="600">
                        <StackPanel Spacing="14">
                            <!-- Poster + Temel bilgi -->
                            <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,8">
                                <Border Grid.Column="0" x:Name="VodInfoPoster" Width="160" Height="240" CornerRadius="10" ClipToBounds="True" Background="#1A4f8bff">
                                    <TextBlock Text="🎬" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Spacing="8">
                                    <TextBlock x:Name="VodInfoTitle" Text="" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="VodInfoCategory" Text="" FontSize="13" Foreground="{DynamicResource TextSec}"/>
                                    
                                    <!-- Detay satırları -->
                                    <Border Background="{DynamicResource BgActive}" CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <TextBlock Text="Tür:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoGenre" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto, *">
                                                <TextBlock Text="Kaynak:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoSource" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid x:Name="VodInfoOrigRow" ColumnDefinitions="Auto, *" IsVisible="False">
                                                <TextBlock Text="Orijinal:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoOrigName" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid x:Name="VodInfoDirRow" ColumnDefinitions="Auto, *" IsVisible="False">
                                                <TextBlock Text="Yönetmen:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoDirector" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid x:Name="VodInfoCastRow" ColumnDefinitions="Auto, *" IsVisible="False">
                                                <TextBlock Text="Oyuncular:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoCast" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid x:Name="VodInfoDurRow" ColumnDefinitions="Auto, *" IsVisible="False">
                                                <TextBlock Text="Süre:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoDuration" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}"/>
                                            </Grid>
                                            <Grid x:Name="VodInfoDateRow" ColumnDefinitions="Auto, *" IsVisible="False">
                                                <TextBlock Text="Tarih:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoDate" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}"/>
                                            </Grid>
                                            <Grid x:Name="VodInfoAgeRow" ColumnDefinitions="Auto, *" IsVisible="False">
                                                <TextBlock Text="Puan:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoAge" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}"/>
                                            </Grid>
                                            <Grid x:Name="VodInfoPlotRow" ColumnDefinitions="Auto, *" IsVisible="False">
                                                <TextBlock Text="Konu:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" Width="75"/>
                                                <TextBlock x:Name="VodInfoPlot" Grid.Column="1" Text="-" FontSize="12" Foreground="{DynamicResource TextSec}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Aksiyon butonları -->
                            <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                                <Button Grid.Column="0" Classes="ActionBtn" x:Name="VodInfoPlayBtn" Click="VodInfoPlay_Click" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,10" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock Text="▶ Oynat" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                </Button>
                                <Button Grid.Column="1" Classes="ActionBtn" x:Name="VodInfoFavBtn" Click="VodInfoFav_Click" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,10" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock x:Name="VodInfoFavText" Text="♡ Favori" FontSize="13" Foreground="{DynamicResource Text}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="ChangeSourceOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#B3000000" IsVisible="False" ZIndex="100">
            <Border Background="{DynamicResource BgCard}" Width="450" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" BoxShadow="0 10 40 0 #88000000">
                <StackPanel Spacing="16">
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Yeni Kaynak Ekle" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Click="CancelChangeSource_Click" Classes="IconBtn" FontSize="16" Foreground="{DynamicResource TextSec}"/>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Kaynak Adı" FontSize="12" Foreground="{DynamicResource TextSec}"/>
                        <TextBox x:Name="SourceNameInput" Watermark="Örn: Ana Kaynak" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Kaynak Tipi" FontSize="12" Foreground="{DynamicResource TextSec}"/>
                        <Grid ColumnDefinitions="*,*,*">
                            <Button x:Name="BtnTypeM3U" Grid.Column="0" Content="M3U" Click="SourceType_Click" Tag="M3U" Classes="ActionBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Foreground="{DynamicResource Accent}" CornerRadius="8,0,0,8" Padding="8"/>
                            <Button x:Name="BtnTypeLink" Grid.Column="1" Content="Link" Click="SourceType_Click" Tag="Link" Classes="ActionBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1,1,1,1" Foreground="{DynamicResource TextSec}" CornerRadius="0" Padding="8"/>
                            <Button x:Name="BtnTypeXtream" Grid.Column="2" Content="Xtream Code" Click="SourceType_Click" Tag="Xtream" Classes="ActionBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1,1,1,1" Foreground="{DynamicResource TextSec}" CornerRadius="0,8,8,0" Padding="8"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="InputAreaM3U" Spacing="12">
                        <StackPanel x:Name="M3uFilePickerPanel" Spacing="12">
                            <Button Classes="ActionBtn" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" Click="SelectM3uFile_Click">
                                <Panel>
                                    <Rectangle Stroke="{DynamicResource Border}" StrokeThickness="2" StrokeDashArray="4,4" RadiusX="10" RadiusY="10" Fill="Transparent" Height="90"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center" Foreground="#FFC107"/>
                                        <TextBlock Text="M3U dosyasını buraya sürükleyin" Foreground="{DynamicResource Text}" FontWeight="Medium" HorizontalAlignment="Center" FontSize="13"/>
                                        <TextBlock Text="veya tıklayın" FontSize="11" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Panel>
                            </Button>
                            <TextBlock x:Name="SelectedFileName" Text="" Foreground="{DynamicResource Accent}" FontSize="12" HorizontalAlignment="Center" IsVisible="False"/>
                            <TextBlock x:Name="SelectedFilePath" IsVisible="False"/>
                            <TextBlock Text="veya URL ile ekleyin" FontSize="12" Foreground="{DynamicResource TextSec}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBox x:Name="M3uUrlInput" Watermark="http:// veya https:// ile başlayan link" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
                    </StackPanel>

                    <StackPanel x:Name="InputAreaXtream" Spacing="10" IsVisible="False">
                        <TextBox x:Name="XtreamUrlInput" Watermark="Sunucu URL (http://...)" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
                        <TextBox x:Name="XtreamUserInput" Watermark="Kullanıcı Adı" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
                        <TextBox x:Name="XtreamPassInput" Watermark="Şifre" PasswordChar="*" Foreground="{DynamicResource Text}" Background="{DynamicResource BgActive}" BorderThickness="1" BorderBrush="{DynamicResource Border}" CornerRadius="8" Padding="12"/>
                    </StackPanel>

                    <Button Classes="ActionBtn" Click="ConfirmAddSource_Click" CornerRadius="8" Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" BorderThickness="0" Margin="0,10,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#4f8bff" Offset="0.0"/>
                                <GradientStop Color="#ec4899" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="Kaynak Ekle" Foreground="White" FontWeight="Bold"/>
                    </Button>

                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="NotificationToast" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" Background="{DynamicResource Text}" CornerRadius="20" Padding="20,10" IsVisible="False" ZIndex="200" BoxShadow="0 4 15 0 #40000000">
            <TextBlock x:Name="NotificationText" Text="Bildirim mesajı" Foreground="{DynamicResource BgCard}" FontWeight="Medium" FontSize="14"/>
        </Border>

    </Grid>
</Window>