<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:local="clr-namespace:GlyphTV"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Class="GlyphTV.MainWindow"
        Title="GlyphTV"
        Width="1280" Height="775"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Icon="avares://GlyphTV/icon.ico"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        x:Name="MainWindowRoot"
        KeyDown="Window_KeyDown">

	<Window.Resources>
		<SolidColorBrush x:Key="Bg">#f5f5f7</SolidColorBrush>
		<SolidColorBrush x:Key="BgSidebar">#f0f0f2</SolidColorBrush>
		<SolidColorBrush x:Key="BgCard">#ffffff</SolidColorBrush>
		<SolidColorBrush x:Key="BgHover">#e8e8ec</SolidColorBrush>
		<SolidColorBrush x:Key="BgActive">#e2e2e8</SolidColorBrush>
		<SolidColorBrush x:Key="Border">#d4d4d8</SolidColorBrush>
		<SolidColorBrush x:Key="Text">#18181b</SolidColorBrush>
		<SolidColorBrush x:Key="TextSec">#6b6b73</SolidColorBrush>
		<SolidColorBrush x:Key="Accent">#3b82f6</SolidColorBrush>
	</Window.Resources>

	<Window.Styles>
		<Style Selector="TextBox /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
			<Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
		</Style>
		<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
			<Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
		</Style>
		<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
			<Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
		</Style>
		<Style Selector="TextBox:focus:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
			<Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
			<Setter Property="SelectionBrush" Value="#554f8bff"/>
			<Setter Property="SelectionForegroundBrush" Value="{DynamicResource Text}"/>
			<Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
			<Style.Resources>
				<SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource TextColor}"/>
				<SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource TextColor}"/>
				<SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource TextColor}"/>
				<SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource TextColor}"/>
			</Style.Resources>
		</Style>

		<Style Selector="TextBox.SearchBox">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
		</Style>
		<Style Selector="TextBox.SearchBox:pointerover">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		</Style>
		<Style Selector="TextBox.SearchBox:focus">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
		</Style>

		<!-- ============================================================
		     ComboBox & Açılır Popup Menü Stilleri
		     ============================================================ -->
		<Style Selector="ComboBox">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="MaxDropDownHeight" Value="380"/>
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
		</Style>
		<Style Selector="ComboBox /template/ ScrollViewer">
			<Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
		</Style>
		<Style Selector="ComboBox:pointerover /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		</Style>
		<Style Selector="ComboBox:focus /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
		</Style>
		<Style Selector="ComboBox /template/ Border#Background">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>
		<Style Selector="ComboBox /template/ Popup#PART_Popup Border#PopupBorder">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="BoxShadow" Value="0 10 30 0 #88000000"/>
			<Setter Property="Padding" Value="4"/>
		</Style>
		<Style Selector="ComboBoxItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
		</Style>
		<Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgActive}"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<Style Selector="Button.ActionBtn">
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.ActionBtn /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
			<Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
		</Style>
		<Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
			<Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
		</Style>
		<Style Selector="Button.ActionBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
			<Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
		</Style>

		<!-- YENİ: Ayarlar sayfasındaki Tema (Sistem/Açık/Koyu), Otomatik
		     Yenileme (Açık/Kapalı) ve Kaynaklar/Genel'deki tekil aksiyon
		     butonları (Yenile/Sil/Temizle/Sıfırla) artık hepsi bu ortak
		     stili paylaşıyor — sabit MinWidth sayesinde metin uzunluğu
		     ne olursa olsun ("AÇIK" / "SİSTEM" / "SIFIRLA") tüm butonlar
		     aynı boyutta görünüyor, hepsi kalın (Bold) ve büyük harfle
		     yazılıyor.
		     DÜZELTME (aktif seçim hiç belli olmuyordu): Bu stilin
		     Background/Foreground/BorderBrush'ı önceden Tema/Otomatik
		     Yenileme butonlarının XAML'inde DOĞRUDAN (local) attribute
		     olarak veriliyordu. Avalonia'da doğrudan verilen bir değer
		     her zaman bir Style Setter'dan daha yüksek önceliklidir — bu
		     yüzden aşağıdaki .Active stili class eklendiğinde bile ASLA
		     görsel olarak uygulanamıyordu (arkaplan hep aynı kalıyordu).
		     Şimdi varsayılan (pasif) renkler DOĞRUDAN BU STİLDEN geliyor;
		     Yenile/Sil/Temizle/Sıfırla gibi "Active" durumu hiç olmayan
		     butonlar kendi renklerini (mavi/kırmızı) yine XAML'de local
		     olarak verip bu varsayılanı normal şekilde ezmeye devam
		     ediyor — sorun sadece "Active" class'ı gerçekten ekleyip
		     çıkarabildiğimiz 5 buton (Tema×3, Otomatik×2) içindi. -->
		<Style Selector="Button.SettingsToggleBtn">
			<Setter Property="MinWidth" Value="96"/>
			<Setter Property="Padding" Value="14,8"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<Style Selector="Button.SettingsToggleBtn.Active">
			<Setter Property="Background" Value="{DynamicResource Accent}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- YENİ (madde 3 — içerik sıralama butonları A-Z/Z-A/Son
		     Eklenenler): SettingsToggleBtn'in "Active" ile AYNI görsel
		     ağırlığa sahip ama farklı bir class adıyla ("Selected")
		     çalışan varyantı — UpdateSortButtons (MainWindow.Navigation.cs)
		     bu class'ı ekleyip/çıkarır. Ayrı bir class kullanılmasının
		     sebebi: aynı SettingsToggleBtn temel stilini paylaşan Tema/
		     Otomatik Yenileme butonlarının "Active" mantığıyla (ayrı bir
		     C# metodu, SetActiveClass) hiç karışmaması. -->
		<Style Selector="Button.SettingsToggleBtn.Selected">
			<Setter Property="Background" Value="{DynamicResource Accent}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- YENİ: Donanım Çözümlemesi / İnterlacing seçim listesi öğeleri.
     Toggle butonlarından farklı olarak tek satır + sağda ✓ işareti
     deseni kullanır. -->
		<Style Selector="Border.SelectListItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Border.SelectListItem:pointerover">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
		</Style>
		<Style Selector="Border.SelectListItem.Active">
			<Setter Property="Background" Value="{DynamicResource BgActive}"/>
		</Style>

		<!-- YENİ: Profesyonel Ayarlar Modalı Sol Gezinme Menü Butonları -->
		<Style Selector="Button.SettingsNavBtn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,2"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="Button.SettingsNavBtn /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.SettingsNavBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
		</Style>
		<Style Selector="Button.SettingsNavBtn:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
		</Style>
		<Style Selector="Button.SettingsNavBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgActive}"/>
		</Style>
		<Style Selector="Button.SettingsNavBtn.Active">
			<Setter Property="Foreground" Value="{DynamicResource Accent}"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>

		<Style Selector="Border.KbdBadge">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- YENİ (madde 1 — sol kategori listesi paneli): CategoryListPanel
		     içindeki her kategori artık bir kart değil, tek satırlık bir
		     liste öğesi. Sağ tarafta ⠿ tutamacı sürükle-bırak ile manuel
		     sıralama başlatır (bkz. MainWindow.Navigation.cs →
		     CategoryDragStart_PointerPressed/CategoryItem_DragOver/
		     CategoryItem_Drop). Seçili kategori "Selected" class'ı ile
		     (UpdateCategorySelectionVisual), sürüklenen bir öğenin ÜZERİNE
		     gelindiğinde ise "DragOver" class'ı ile vurgulanır. -->
		<Style Selector="Button.CategoryListItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="10,9"/>
			<Setter Property="Margin" Value="0,2"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.CategoryListItem /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
		</Style>
		<Style Selector="Button.CategoryListItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
		</Style>
		<Style Selector="Button.CategoryListItem.Selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgActive}"/>
		</Style>
		<Style Selector="Button.CategoryListItem.DragOver /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#333b82f6"/>
		</Style>

		<!-- YENİ: Favoriler panelindeki yatay listeler (Canlı TV/Filmler/
		     Diziler) için kaydırma çubuğu yerine sol/sağ ok butonları.
		     İçerik başta/sonda olduğunda ilgili ok kod-behind'dan
		     (UpdateHArrowVisibility, MainWindow.Navigation.cs) gizlenir. -->
		<Style Selector="Border.HScrollArrow">
			<Setter Property="Width" Value="38"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="CornerRadius" Value="19"/>
			<Setter Property="Background" Value="#CC18181b"/>
			<Setter Property="BorderBrush" Value="#33ffffff"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="ZIndex" Value="20"/>
			<Setter Property="BoxShadow" Value="0 2 8 0 #55000000"/>
		</Style>
		<Style Selector="Border.HScrollArrow:pointerover">
			<Setter Property="Background" Value="#EE18181b"/>
		</Style>
		<Style Selector="Border.HScrollArrow.NextArrow">
			<Setter Property="HorizontalAlignment" Value="Right"/>
		</Style>

		<Style Selector="Border.PopularCardBorder">
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.PopularCardBorder:pointerover">
			<Setter Property="RenderTransform" Value="scale(1.03)"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
		</Style>

		<Style Selector="Border.ResumeCardBorder">
			<Setter Property="Transitions">
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.ResumeCardBorder:pointerover">
			<Setter Property="RenderTransform" Value="scale(1.02)"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
		</Style>

		<Style Selector="Button.WinBtn">
			<Setter Property="Width" Value="46"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.WinBtn /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.WinBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.WinBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgActive}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.WinCloseBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#e81123"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.WinCloseBtn:pointerover">
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Button.WinCloseBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#f1707a"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.MenuBtn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSec}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,2"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="Button.MenuBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.MenuBtn.Active /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgActive}"/>
			<Setter Property="Foreground" Value="{DynamicResource Text}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="Button.CatCard">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="20,18"/>
			<Setter Property="Margin" Value="6"/>
			<Setter Property="Width" Value="240"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="Button.CatCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
			<Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
		</Style>

		<Style Selector="Border.VodCardBorder">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="Width" Value="240"/>
			<Setter Property="Height" Value="220"/>
		</Style>
		<Style Selector="Border.VodCardBorder:pointerover">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
		</Style>

		<Style Selector="Border.ContentItemBorder">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="Width" Value="240"/>
			<!-- YENİ (madde 5 — kart altında EPG bilgisi): 78'den 90'a
			     çıkarıldı; sadece yükseklik değişti, Width (dolayısıyla
			     RecalculateGridColumns/CARD_FOOTPRINT_LIVE hesabı) aynı
			     kaldığı için sütun sayısı etkilenmez. -->
			<Setter Property="Height" Value="90"/>
		</Style>
		<Style Selector="Border.ContentItemBorder:pointerover">
			<Setter Property="Background" Value="{DynamicResource BgHover}"/>
		</Style>

		<!-- YENİ: VOD/Dizi kart satırlarının (VodContentGrid/SeriesContentGrid
		     içindeki iç ItemsControl) hizalanması. Varsayılan (kategori
		     gezinme) davranış ortalanmış kalır — bu, kart sayısı sütun
		     sayısını doldurmadığında (örn. son satır) daha dengeli görünür.
		     Arama sonuçlarında ise dış kapsayıcıya (VodContentGrid/
		     SeriesContentGrid) kod-behind'dan eklenen "SearchMode" class'ı
		     sayesinde bu satırlar sola dayalı gösterilir — bkz.
		     MainWindow.Navigation.cs → UpdateViewInternal (arama bloğu).
		     NOT: HorizontalAlignment burada artık DOĞRUDAN (local) değer
		     olarak değil, sadece bu stilden geliyor — aksi halde local
		     değer her zaman Style Setter'dan önceliklidir ve SearchMode
		     override'ı hiç uygulanamaz (bkz. Button.SettingsToggleBtn
		     stilindeki aynı notun açıklaması). -->
		<Style Selector="ItemsControl.RowItemsHost">
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="ItemsControl.SearchMode ItemsControl.RowItemsHost">
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>

		<Style Selector="Button.IconBtn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.IconBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
		</Style>
		<Style Selector="Button.IconBtn:pointerover">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<Style Selector="Border.SettingsCard">
			<Setter Property="Background" Value="{DynamicResource BgCard}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="16"/>
			<Setter Property="Padding" Value="24"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<!-- NOT: Eski "PLAYER BUTON STİLLERİ" bölümü (Button.PlayerIconBtn,
		     .PlayBtn, .PlayerTopBtn, .PlayerIconBtnWide, .PlayerCloseBtn,
		     .PlayerChannelBtn, .TrackBtn) ve AudioTrackPopup/SubtitlePopup/
		     ChannelListPanel ScrollViewer şeffaflık stilleri artık burada
		     değil — bunları kullanan TÜM kontroller (oynatıcı üst/alt bar,
		     popup'lar) PlayerOverlayWindow.axaml'e taşındı (bkz. "airspace"
		     düzeltmesi, MainWindow.PlayerOverlay.cs); ilgili stiller de
		     birlikte oraya taşındı. -->
	</Window.Styles>

	<Grid x:Name="RootGrid" ColumnDefinitions="200, *">

		<Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,1,0,0">
			<Grid RowDefinitions="Auto, *">
				<Border Grid.Row="0" Margin="10,4,10,14" Padding="8,7" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0" CornerRadius="0">
					<Grid ColumnDefinitions="Auto, Auto, *">
						<!-- Uygulama Logosu -->
						<Image Grid.Column="0" Source="avares://GlyphTV/Assets/icon.png"
						       Width="52" Height="52"
						       RenderOptions.BitmapInterpolationMode="HighQuality"
						       VerticalAlignment="Center"/>

						<!-- Dikey Ayırıcı Çizgi -->
						<Border Grid.Column="1" Width="1" Height="32" Background="{DynamicResource Border}" Margin="10,0" VerticalAlignment="Center"/>

						<!-- Canlı Saat & Tarih -->
						<StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
							<TextBlock x:Name="SidebarClockTime" Text="--:--" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}"/>
							<TextBlock x:Name="SidebarClockDate" Text="---" FontSize="12.5" Foreground="{DynamicResource TextSec}" Margin="0,1,0,0"/>
						</StackPanel>
					</Grid>
				</Border>

				<StackPanel Grid.Row="1" Margin="10,0">
					<Button x:Name="BtnHome" Classes="MenuBtn Active" Click="MenuFilter_Click" Tag="Anasayfa">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🏠" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="Anasayfa" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button x:Name="BtnLive" Classes="MenuBtn" Click="MenuFilter_Click" Tag="Canlı">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="📺" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="Canlı TV" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button x:Name="BtnVOD" Classes="MenuBtn" Click="MenuFilter_Click" Tag="VOD">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🎬" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Text="Filmler" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button x:Name="BtnSeries" Classes="MenuBtn" Click="MenuFilter_Click" Tag="Dizi">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🎞️" FontSize="18" VerticalAlignment="Center"/>
							<TextBlock Text="Diziler" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<Border Height="1" Background="{DynamicResource Border}" Margin="4,10"/>
					<Button x:Name="BtnEpg" Classes="MenuBtn" Click="EpgButton_Click">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🗓️" FontSize="15" VerticalAlignment="Center"/>
							<TextBlock Text="Yayın Akışı" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button x:Name="BtnFav" Classes="MenuBtn" Click="MenuFilter_Click" Tag="Favori">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🤍" FontSize="15" VerticalAlignment="Center"/>
							<TextBlock Text="Favoriler" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button x:Name="BtnSettings" Classes="MenuBtn" Click="SettingsButton_Click">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🛠️" FontSize="18" VerticalAlignment="Center"/>
							<TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<Grid x:Name="MainContentGrid" Grid.Column="1" RowDefinitions="46, *">

			<Border x:Name="TitleBarPanel" Grid.Row="0" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" PointerPressed="TitleBar_PointerPressed">
				<Grid ColumnDefinitions="*, Auto, *">
					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
						<Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="2" CornerRadius="12" Height="28" Width="400" Padding="14,0">
							<TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" Watermark="🔎 İçerik ara..." VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
						</Border>
					</StackPanel>

					<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" Spacing="0">
						<Button Classes="WinBtn" Click="MinimizeWindow_Click">
							<TextBlock Text="─" FontSize="12" Foreground="{DynamicResource TextSec}"/>
						</Button>
						<Button Classes="WinBtn" Click="MaximizeWindow_Click">
							<TextBlock Text="□" FontSize="13" Foreground="{DynamicResource TextSec}"/>
						</Button>
						<Button Classes="WinBtn WinCloseBtn" Click="CloseWindow_Click">
							<TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSec}"/>
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<!-- ═══════════════════════════════════════════════════════════
			     DÜZELTME (player kategori/içerik listelerinin ÜZERİNE
			     biniyordu — bazı satırlar hiç görünmüyor/erişilemiyordu):
			     PlayerContainer ve aşağıdaki kategori+içerik Grid'i önceden
			     AYNI Grid hücresinde üst üste (overlapping siblings) duran
			     iki kardeşti; PlayerContainer'ın ZIndex="-1" olması hiçbir
			     şey değiştirmiyordu çünkü video yüzeyi (VLC VideoView /
			     mpv MpvVideoHost) GERÇEK bir native Win32 alt penceredir —
			     Windows'ta native pencereler Avalonia'nın kendi çiziminin
			     HER ZAMAN önünde görünür, ZIndex ile değiştirilemeyen bir
			     pencere kompozisyon kısıtıdır ("airspace", bkz.
			     PlayerOverlayWindow.axaml başındaki ayrıntılı açıklama).
			     Bu yüzden player açıkken listelerin üst kısmı video
			     tarafından fiilen KAPATILIYOR, ZIndex hiçbir fark
			     yaratmıyordu.

			     Artık PlayerContainer ve kategori+içerik Grid'i AYRI Grid
			     SATIRLARINDA (RowDefinitions="Auto, *") — PlayerContainer
			     kendi Height'ı kadar (kapalıyken 0, açıkken 450, tam
			     ekranda NaN) gerçek yer kaplıyor, listeler bu satırın
			     HEMEN ALTINDAN başlıyor. Böylece video her zaman listelerin
			     üstünde ayrı bir blok olarak durur, hiçbir satırı kapatmaz
			     ve her iki listenin de en baştan sona tam erişimi olur. -->
			<Grid x:Name="PlayerRowGrid" Grid.Row="1" RowDefinitions="Auto, *">

				<Grid x:Name="PlayerContainer" Grid.Row="0" VerticalAlignment="Top" Height="0" ClipToBounds="True">
					<!-- YENİ: Video yüzeyi artık burada sabit değil — hangi motor
         (VLC/mpv) aktifse, o motorun native kontrolü (engine.VideoSurface)
         MainWindow.axaml.cs → EnsureEngineInitialized() içinde bu panele
         Children.Add() ile eklenir. -->
					<Panel x:Name="PlayerVideoHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
				</Grid>

				<Grid Grid.Row="1" ColumnDefinitions="Auto, *">

					<!-- ═══════════════════════════════════════════════════════
					     YENİ (madde 1 — kalıcı sol kategori listesi paneli):
					     Eskiden kategoriler ana içerik alanında büyük "kart"lar
					     (CatCard) olarak, kendi başına bir sekme ("Categories"
					     görünüm durumu) hâlinde gösteriliyordu. Artık kategori
					     listesi HER ZAMAN (Content/Shows görünümünde de) solda,
					     dar/sabit genişlikte kalıcı bir panelde duruyor — bkz.
					     ekran görüntüsü ("TÜRK RAW / ULUSAL / BELGESEL / ...").
					     Görünürlüğü MainWindow.Navigation.cs → SetGridVisibility
					     içindeki "categories" parametresiyle yönetilir.

					     KAYDIRMA (madde 1'in ikinci kısmı): Liste gerçek bir
					     kaydırma çubuğu OLMADAN, sadece mouse tekerleği ile
					     kaydırılabilir olmalı. Bunu sağlayan iki şey: (1) bu
					     panel sabit yükseklikli bir Grid satırı içinde durduğu
					     için ScrollViewer'ın taşacak içeriği olduğunda gerçek
					     bir viewport'u vardır, (2) VerticalScrollBarVisibility
					     "Disabled" DEĞİL "Hidden" — "Disabled" kaydırmayı TAMAMEN
					     kapatır (tekerlek de çalışmaz), "Hidden" ise SADECE
					     görsel çubuğu gizler; ScrollViewer tekerlek olayını
					     normal şekilde işlemeye devam eder.
					     ═══════════════════════════════════════════════════════ -->
					<Border x:Name="CategoryListPanel" Grid.Column="0" Width="220"
							Background="{DynamicResource BgSidebar}"
							BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
							Padding="14,20,10,16" IsVisible="False">
						<Grid RowDefinitions="Auto, *">
							<Grid Grid.Row="0" Margin="6,0,4,12">
								<TextBlock Text="Kategoriler" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSec}"/>
								<TextBlock Text="⠿ ile sürükleyip sıralayın" FontSize="9" Foreground="{DynamicResource TextSec}" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
							</Grid>

							<ScrollViewer Grid.Row="1"
										  VerticalScrollBarVisibility="Hidden"
										  HorizontalScrollBarVisibility="Disabled">
								<ItemsControl x:Name="CategoriesGrid">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel Orientation="Vertical"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="sys:String">
											<Button Classes="CategoryListItem" Click="Category_Click" Tag="{Binding}"
													DragDrop.AllowDrop="True"
													DragDrop.DragOver="CategoryItem_DragOver"
													DragDrop.DragLeave="CategoryItem_DragLeave"
													DragDrop.Drop="CategoryItem_Drop">
												<Grid ColumnDefinitions="*, Auto">
													<TextBlock Text="{Binding}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text}"
															   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False"/>
													<TextBlock Grid.Column="1" Text="⠿" FontSize="12" Foreground="{DynamicResource TextSec}"
															   VerticalAlignment="Center" Margin="8,0,0,0" Cursor="Hand"
															   PointerPressed="CategoryDragStart_PointerPressed" Tag="{Binding}"/>
												</Grid>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</Border>

					<Grid Grid.Column="1">
				<ScrollViewer x:Name="ContentScrollViewer" Margin="28,24"
							  VerticalScrollBarVisibility="Hidden"
							  ScrollChanged="ContentScrollViewer_ScrollChanged">
					<StackPanel>

						<Grid x:Name="PageTitlePanel" Margin="0,0,0,24" IsVisible="False">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
								<Button x:Name="BackBtn" Classes="IconBtn" Content="❮ Geri" Click="Back_Click" Foreground="{DynamicResource TextSec}" FontWeight="Bold" IsVisible="False"/>
								<TextBlock x:Name="PageTitle" Text="" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Text}" IsVisible="False"/>
							</StackPanel>

							<!-- YENİ (madde 3 — içerik sıralama): A-Z / Z-A / Son
							     Eklenenler. Sadece içerik görünümünde (kategori
							     listesi veya ayarlar/favori/arama DIŞINDA) görünür
							     — bkz. SetGridVisibility(content). Seçili mod
							     UpdateSortButtons ile "Selected" class'ı üzerinden
							     vurgulanır. -->
							<StackPanel x:Name="SortOptionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="False">
								<Button Classes="ActionBtn SettingsToggleBtn" Content="A-Z" Tag="AZ" Click="SortMode_Click"/>
								<Button Classes="ActionBtn SettingsToggleBtn" Content="Z-A" Tag="ZA" Click="SortMode_Click"/>
								<Button Classes="ActionBtn SettingsToggleBtn" Content="Son Eklenenler" Tag="New" Click="SortMode_Click"/>
							</StackPanel>
						</Grid>

						<!-- YENİ: Arama sonuçlarında içerik türlerini (Canlı/Film/Dizi)
						     ayrı ayrı, başlıklı bölümler hâlinde göstermek için
						     eklenen etiketler. Normal (aramasız) gezinmede hep
						     gizlidir; sadece arama sırasında UpdateViewInternal
						     tarafından açılır — bkz. MainWindow.Navigation.cs. -->
						<TextBlock x:Name="SearchLiveLabel" Text="📺 Canlı" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,10" IsVisible="False"/>

						<!-- Canlı TV liste görünümü — Gizle butonu kaldırıldı, Grid 3 sütuna indirildi -->
						<!-- KALICI DÜZELTME (CPU spike): dış panel artık gerçek
						     sanallaştırma yapan VirtualizingStackPanel; kartlar
						     RowGroupedCollection tarafından satırlara gruplanıyor
						     (bkz. RowGroupedCollection.cs / MainWindow.axaml.cs). -->
						<ItemsControl x:Name="ContentItemsGrid" IsVisible="False">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel Orientation="Vertical"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:CompileBindings="False">
									<ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Left">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="local:Channel">
												<Border Classes="ContentItemBorder">
													<Grid ColumnDefinitions="Auto, *, Auto" Margin="8">
														<Button Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" Click="Content_Click" Tag="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12" Cursor="Hand"/>

														<Grid Grid.Column="0" Width="34" Height="34" IsHitTestVisible="False">
															<Border CornerRadius="9" Background="#1A4f8bff" IsVisible="{Binding NoLogo}">
																<TextBlock Text="▶" Foreground="{DynamicResource Accent}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
															</Border>
															<Border CornerRadius="9" Background="#0A000000" IsVisible="{Binding HasLogo}" ClipToBounds="True">
																<Image Source="{Binding LogoBitmap}" Stretch="Uniform" Margin="2" RenderOptions.BitmapInterpolationMode="LowQuality"/>
															</Border>
														</Grid>

														<StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
															<TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Name}"/>
															<TextBlock Text="{Binding Group}" FontSize="10" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
															<!-- YENİ (madde 5): kart altında "şu an yayında" EPG bilgisi
															     — sadece EPG eşleşmesi varsa görünür (bkz.
															     Channel.HasEpgNow / MainWindow.Epg.cs →
															     UpdateLiveChannelsEpgNowInfo). -->
															<TextBlock Text="{Binding EpgNowDisplayText}" FontSize="9" Foreground="{DynamicResource Accent}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasEpgNow}"/>
														</StackPanel>

														<Button Grid.Column="2" Classes="IconBtn" Content="{Binding FavoriteIcon}" Foreground="{Binding FavoriteBrush}" Click="ToggleFavorite_Click" Tag="{Binding}" FontSize="17" VerticalAlignment="Center" Margin="2,0" ToolTip.Tip="Favorilere Ekle/Çıkar"/>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<TextBlock x:Name="SearchVodLabel" Text="🎬 Filmler" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,20,0,10" IsVisible="False"/>

						<!-- KALICI DÜZELTME (CPU spike): dış panel artık gerçek
						     sanallaştırma yapan VirtualizingStackPanel; kartlar
						     RowGroupedCollection tarafından satırlara gruplanıyor. -->
						<ItemsControl x:Name="VodContentGrid" IsVisible="False">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel Orientation="Vertical"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:CompileBindings="False">
									<ItemsControl ItemsSource="{Binding Items}" Classes="RowItemsHost">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="local:Channel">
												<Border Classes="VodCardBorder">
													<Grid ColumnDefinitions="Auto, *">
														<Border Grid.Column="0" Width="112" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
															<Grid>
																<Border Background="{DynamicResource PosterPlaceholderBg}" IsVisible="{Binding NoLogo}">
																	<TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
																</Border>
																<Border Background="{DynamicResource PosterOverlayBg}" IsVisible="{Binding HasLogo}">
																	<Image Source="{Binding LogoBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="LowQuality"/>
																</Border>
															</Grid>
														</Border>
														<Grid Grid.Column="1" RowDefinitions="Auto, *">
															<StackPanel Grid.Row="0" Margin="14,14,14,0" IsHitTestVisible="False">
																<TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Name}"/>
																<TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
															</StackPanel>
															<StackPanel Grid.Row="1" Margin="14,10,14,12" VerticalAlignment="Bottom" Spacing="5">
																<Button Classes="ActionBtn" Click="Content_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																	<TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
																</Button>
																<Button Classes="ActionBtn" Click="Content_Resume_Click" Tag="{Binding}" Background="#223b82f6" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
																	<TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
																</Button>
																<Button Classes="ActionBtn" Click="ToggleFavorite_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																	<StackPanel Orientation="Horizontal" Spacing="4">
																		<TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
																		<TextBlock Text="Favori" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
																	</StackPanel>
																</Button>
																<Button Classes="ActionBtn" Click="VodInfo_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																	<StackPanel Orientation="Horizontal" Spacing="4">
																		<TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
																		<TextBlock Text="Detay" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
																	</StackPanel>
																</Button>
															</StackPanel>
														</Grid>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<TextBlock x:Name="SearchSeriesLabel" Text="🎞️ Diziler" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,20,0,10" IsVisible="False"/>

						<!-- KALICI DÜZELTME (CPU spike): dış panel artık gerçek
						     sanallaştırma yapan VirtualizingStackPanel; kartlar
						     RowGroupedCollection tarafından satırlara gruplanıyor. -->
						<ItemsControl x:Name="SeriesContentGrid" IsVisible="False">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel Orientation="Vertical"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:CompileBindings="False">
									<ItemsControl ItemsSource="{Binding Items}" Classes="RowItemsHost">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="local:SeriesCard">
												<Border Classes="VodCardBorder" Height="240">
													<Grid ColumnDefinitions="Auto, *">
														<Border Grid.Column="0" Width="112" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
															<Grid>
																<Border Background="{DynamicResource PosterPlaceholderBg}" IsVisible="{Binding NoLogo}">
																	<TextBlock Text="🎞️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
																</Border>
																<Border Background="{DynamicResource PosterOverlayBg}" IsVisible="{Binding HasLogo}">
																	<Image Source="{Binding LogoBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="LowQuality"/>
																</Border>
															</Grid>
														</Border>
														<Grid Grid.Column="1" RowDefinitions="Auto, *">
															<StackPanel Grid.Row="0" Margin="14,12,14,0" IsHitTestVisible="False">
																<TextBlock Text="{Binding ShowName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ShowName}"/>
																<TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
															</StackPanel>
															<StackPanel Grid.Row="1" Margin="14,8,14,12" VerticalAlignment="Bottom" Spacing="5">
																<Button Classes="ActionBtn" Click="PlaySeries_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																	<TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
																</Button>
																<Button Classes="ActionBtn" Click="PlaySeriesResume_Click" Tag="{Binding}" Background="#223b82f6" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
																	<TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
																</Button>
																<Grid ColumnDefinitions="Auto, *, Auto">
																	<Button Grid.Column="0" Classes="ActionBtn" Click="PrevSeason_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
																	<Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
																		<TextBlock Text="{Binding SeasonText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
																	</Border>
																	<Button Grid.Column="2" Classes="ActionBtn" Click="NextSeason_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
																</Grid>
																<Grid ColumnDefinitions="Auto, *, Auto">
																	<Button Grid.Column="0" Classes="ActionBtn" Click="PrevEpisode_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
																	<Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
																		<TextBlock Text="{Binding EpisodeText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
																	</Border>
																	<Button Grid.Column="2" Classes="ActionBtn" Click="NextEpisode_Click2" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
																</Grid>
																<Grid ColumnDefinitions="*, *">
																	<Button Grid.Column="0" Classes="ActionBtn" Click="SeriesInfo_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0">
																		<StackPanel Orientation="Horizontal" Spacing="4">
																			<TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
																		</StackPanel>
																	</Button>
																	<Button Grid.Column="1" Classes="ActionBtn" Click="SeriesFav_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0">
																		<StackPanel Orientation="Horizontal" Spacing="4">
																			<TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
																		</StackPanel>
																	</Button>
																</Grid>
															</StackPanel>
														</Grid>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- ========================================================= -->
						<!-- ANASAYFA PANELİ (Popüler & Devam Et)                      -->
						<!-- ========================================================= -->
						<StackPanel x:Name="HomePanel" IsVisible="True" Spacing="0" Margin="0,4,0,24">
							
							<!-- 1. POPÜLER BÖLÜMÜ: TMDb Trend Hero Banner (20 İçerik) -->
							<!-- Not: "Popüler" başlığı kullanıcı isteğiyle kaldırıldı -->
							<Border x:Name="HeroBannerContainer"
							        Margin="0,0,0,24"
							        Height="470"
							        CornerRadius="22"
							        ClipToBounds="True"
							        Background="{DynamicResource BgCard}"
							        BorderBrush="{DynamicResource Border}"
							        BorderThickness="1"
							        BoxShadow="0 12 40 0 #88000000">
								<Grid>
									<!-- 1. Arka Plan Backdrop Görseli (Yüksek kaliteli HD silüet ve canlı renkler) -->
									<Image x:Name="HeroBackdropImg"
									       Stretch="UniformToFill"
									       RenderOptions.BitmapInterpolationMode="HighQuality"
									       HorizontalAlignment="Center"
									       VerticalAlignment="Center"
									       Opacity="0.88"/>

									<!-- 2. Gradyan Karartma Katmanları (Sinematik Silüet ve Zemin Bütünlüğü) -->
									<!-- Soldan Sağa Karartma (Sol metin okunabilirliği + Sağ silüet berraklığı) -->
									<Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
												<GradientStop Color="#F00b0f19" Offset="0.0"/>
												<GradientStop Color="#CC0b0f19" Offset="0.35"/>
												<GradientStop Color="#400b0f19" Offset="0.68"/>
												<GradientStop Color="#000b0f19" Offset="1.0"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>

									<!-- Aşağıdan Yukarıya Zemin / Taban Karartma & Yansıma Katmanı -->
									<Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
												<GradientStop Color="#F00b0f19" Offset="0.0"/>
												<GradientStop Color="#800b0f19" Offset="0.28"/>
												<GradientStop Color="#000b0f19" Offset="0.65"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>

									<!-- Üst Kenar İnce Vignette Çerçevesi -->
									<Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
												<GradientStop Color="#400b0f19" Offset="0.0"/>
												<GradientStop Color="#000b0f19" Offset="0.18"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>

									<!-- 3. Ön Plan İçerik Düzeni -->
									<Grid Margin="38,32,38,26" RowDefinitions="Auto, *, Auto">
										
										<!-- Üst Alan: Rozetler / Etiketler -->
										<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
											<!-- TMDb Trend Rozeti -->
											<Border CornerRadius="8" Background="#2200d2ff" BorderBrush="#00d2ff" BorderThickness="1" Padding="9,4">
												<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
													<TextBlock Text="✨" FontSize="11" Foreground="#00d2ff" VerticalAlignment="Center"/>
													<TextBlock Text="TMDB TREND" FontSize="11" FontWeight="Black" Foreground="#00d2ff" VerticalAlignment="Center"/>
												</StackPanel>
											</Border>

											<!-- Tür: SİNEMA / DİZİ -->
											<Border CornerRadius="6" Background="#33000000" BorderBrush="#334155" BorderThickness="1" Padding="8,4">
												<TextBlock x:Name="HeroTypeBadgeText" Text="SİNEMA" FontSize="11" FontWeight="Bold" Foreground="#cbd5e1" VerticalAlignment="Center"/>
											</Border>

											<!-- Puan: ⭐ 8.0 -->
											<Border CornerRadius="6" Background="#40000000" BorderBrush="#334155" BorderThickness="1" Padding="8,4">
												<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
													<TextBlock Text="⭐" FontSize="11" Foreground="#fbbf24" VerticalAlignment="Center"/>
													<TextBlock x:Name="HeroRatingText" Text="8.0" FontSize="11" FontWeight="Bold" Foreground="#fbbf24" VerticalAlignment="Center"/>
												</StackPanel>
											</Border>
										</StackPanel>

										<!-- Orta Alan: Başlık, Slogan, Açıklama, Tür Etiketleri -->
										<StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="9" MaxWidth="720" HorizontalAlignment="Left">
											<!-- Başlık -->
											<TextBlock x:Name="HeroTitleText" Text="Deadpool &amp; Wolverine" FontSize="35" FontWeight="Black" Foreground="White" TextWrapping="Wrap" MaxLines="2" LineHeight="42"/>

											<!-- Slogan (Varsa) -->
											<TextBlock x:Name="HeroTaglineText" Text="&quot;Birlikte her şeyi düzeltecekler. Ya da batıracaklar.&quot;" FontSize="13.5" FontWeight="SemiBold" FontStyle="Italic" Foreground="#38bdf8" TextWrapping="Wrap" MaxLines="2"/>

											<!-- Açıklama -->
											<TextBlock x:Name="HeroOverviewText" Text="Zaman Varyansı Otoritesi (TVA) tarafından evrenini kurtarmak için göreve çağrılan umutsuz Wade Wilson, isteksiz bir Wolverine ile güçlerini birleştirmek zorundadır." FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap" MaxLines="3" LineHeight="20" MaxWidth="620"/>

											<!-- Tür Etiketleri -->
											<ItemsControl x:Name="HeroGenresList" Margin="0,4,0,0">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel Orientation="Horizontal" Spacing="6"/>
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="sys:String">
														<Border CornerRadius="12" Background="#331e293b" BorderBrush="#334155" BorderThickness="1" Padding="10,4">
															<TextBlock Text="{Binding}" FontSize="11" Foreground="#cbd5e1" VerticalAlignment="Center"/>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>

										<!-- Alt Alan: Aksiyon Butonları & Sağ Altta Carousel Gezinme -->
										<Grid Grid.Row="2" Margin="0,14,0,0">
											<!-- Sol: Hemen İzle / Detaylar & Bölümler / Favori -->
											<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
												<!-- Hemen İzle Butonu -->
												<Border CornerRadius="12" BoxShadow="0 4 20 0 #550084ff">
													<Button Classes="ActionBtn" Click="HeroPlay_Click" Background="#0084ff" Foreground="White" CornerRadius="12" Padding="24,11" BorderThickness="0">
														<StackPanel Orientation="Horizontal" Spacing="8">
															<TextBlock Text="▶" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
															<TextBlock Text="Hemen İzle" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
														</StackPanel>
													</Button>
												</Border>

												<!-- Detaylar & Bölümler Butonu -->
												<Button Classes="ActionBtn" Click="HeroDetail_Click" Background="#260f172a" Foreground="White" CornerRadius="12" Padding="18,11" BorderThickness="1" BorderBrush="#334155">
													<StackPanel Orientation="Horizontal" Spacing="7">
														<TextBlock Text="ⓘ" FontSize="14" Foreground="#38bdf8" VerticalAlignment="Center"/>
														<TextBlock Text="Detaylar &amp; Bölümler" FontSize="12.5" FontWeight="SemiBold" Foreground="#e2e8f0" VerticalAlignment="Center"/>
													</StackPanel>
												</Button>

												<!-- Favori Butonu -->
												<Button Classes="ActionBtn" Click="HeroFavorite_Click" Background="#260f172a" Foreground="White" CornerRadius="12" Width="44" Height="44" Padding="0" BorderThickness="1" BorderBrush="#334155" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
													<TextBlock x:Name="HeroFavIconText" Text="🤍" FontSize="15" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Button>
											</StackPanel>

											<!-- Sağ: Carousel Okları & Gösterge Noktaları -->
											<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
												<!-- Sol Ok -->
												<Border Classes="ActionBtn" PointerPressed="HeroPrev_Click" Background="#330f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="18" Width="36" Height="36" Cursor="Hand">
													<Path Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12Z" Fill="#94a3b8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>

												<!-- Gösterge Noktaları -->
												<Border Background="#44020617" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="14" Padding="8,5">
													<ItemsControl x:Name="HeroDotsControl">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel Orientation="Horizontal" Spacing="5"/>
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
															<DataTemplate x:DataType="local:HeroDotItem">
																<Border Tag="{Binding}" PointerPressed="HeroDot_Click" Cursor="Hand" Width="{Binding DotWidth}" Height="6" CornerRadius="3" Background="{Binding DotBrush}" VerticalAlignment="Center"/>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Border>

												<!-- Sağ Ok -->
												<Border Classes="ActionBtn" PointerPressed="HeroNext_Click" Background="#330f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="18" Width="36" Height="36" Cursor="Hand">
													<Path Data="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12Z" Fill="#94a3b8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</StackPanel>
										</Grid>
									</Grid>
								</Grid>
							</Border>

							<!-- 2. DEVAM ET BÖLÜMÜ (Yarıda Bırakılan İçerikler) -->
							<StackPanel Margin="0,4,0,16">
								<!-- Devam Et Başlığı ("Kaynak Ekle" Gradyanı) ve Filtre Butonları (A-Z stili) -->
								<Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
									<Border Grid.Column="0" CornerRadius="20" BoxShadow="0 6 18 0 #30ec4899">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
												<GradientStop Color="#4f8bff" Offset="0.0"/>
												<GradientStop Color="#ec4899" Offset="1.0"/>
											</LinearGradientBrush>
										</Border.Background>
										<Grid Height="40" Margin="22,0,26,0">
											<TextBlock Text="Devam Et" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
										</Grid>
									</Border>

									<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
										<Button x:Name="BtnResumeAll" Classes="ActionBtn SettingsToggleBtn Selected" Click="ResumeFilter_Click" Tag="All" Content="Tümü"/>
										<Button x:Name="BtnResumeMovies" Classes="ActionBtn SettingsToggleBtn" Click="ResumeFilter_Click" Tag="Movies" Content="Filmler"/>
										<Button x:Name="BtnResumeSeries" Classes="ActionBtn SettingsToggleBtn" Click="ResumeFilter_Click" Tag="Series" Content="Diziler"/>
									</StackPanel>
								</Grid>

								<!-- Devam Et İçerik Listesi (Uygulamadaki Standart Kart Stili) -->
								<Grid>
									<!-- Boş Durum Bildirimi -->
									<Border x:Name="HomeResumeEmptyNotice" IsVisible="False" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="20" HorizontalAlignment="Stretch">
										<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
											<TextBlock Text="⏳" FontSize="18" VerticalAlignment="Center"/>
											<TextBlock Text="Henüz yarıda bırakılan bir film veya dizi bulunmuyor." FontSize="13" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>

									<ScrollViewer x:Name="HomeResumeScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="HomeResumeScroll_ScrollChanged">
										<ItemsControl x:Name="HomeResumeGrid">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" Spacing="12"/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="local:ResumeWatchItem">
													<Border Classes="VodCardBorder" Height="240" Margin="0,0,12,0">
														<Grid ColumnDefinitions="Auto, *">
															<!-- Sol: Poster & İkon -->
															<Border Grid.Column="0" Width="112" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
																<Grid>
																	<Border Background="{DynamicResource PosterPlaceholderBg}" IsVisible="{Binding NoLogo}">
																		<TextBlock Text="{Binding PlaceholderIcon}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
																	</Border>
																	<Border Background="{DynamicResource PosterOverlayBg}" IsVisible="{Binding HasLogo}">
																		<Image Source="{Binding LogoBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="LowQuality"/>
																	</Border>

																	<!-- Devam Et: Kalan Süre Rozeti ve İlerleme Çubuğu -->
																	<Grid VerticalAlignment="Bottom" RowDefinitions="Auto, Auto" IsVisible="{Binding HasProgress}">
																		<!-- Kalan Süre Rozeti -->
																		<Border Grid.Row="0" Margin="4,0,4,6" HorizontalAlignment="Center" Background="#D90b1120" BorderBrush="#40ffffff" BorderThickness="1" CornerRadius="6" Padding="6,2">
																			<TextBlock Text="{Binding RemainingTimeText}" FontSize="10" FontWeight="Bold" Foreground="#F9FAFB" HorizontalAlignment="Center"/>
																		</Border>

																		<!-- İlerleme Çubuğu (Bar) -->
																		<ProgressBar Grid.Row="1" Height="4" MinHeight="0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Foreground="{DynamicResource Accent}" Background="#80000000" BorderThickness="0" CornerRadius="0"/>
																	</Grid>
																</Grid>
															</Border>

															<!-- Sağ: Başlık, Kategori/Tür ve İşlem Butonları -->
															<Grid Grid.Column="1" RowDefinitions="Auto, *">
																<StackPanel Grid.Row="0" Margin="14,12,14,0" IsHitTestVisible="False">
																	<TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
																	<TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
																</StackPanel>

																<!-- Dizi İçin İşlem Butonları (Diziler sekmesiyle birebir aynı) -->
																<StackPanel Grid.Row="1" Margin="14,8,14,12" VerticalAlignment="Bottom" Spacing="5" IsVisible="{Binding IsSeries}">
																	<Button Classes="ActionBtn" Click="PlaySeries_Click" Tag="{Binding SeriesCard}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																		<TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
																	</Button>
																	<Button Classes="ActionBtn" Click="PlaySeriesResume_Click" Tag="{Binding SeriesCard}" Background="#223b82f6" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding SeriesCard.HasResume}">
																		<TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
																	</Button>
																	<Grid ColumnDefinitions="Auto, *, Auto">
																		<Button Grid.Column="0" Classes="ActionBtn" Click="PrevSeason_Click" Tag="{Binding SeriesCard}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
																		<Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
																			<TextBlock Text="{Binding SeriesCard.SeasonText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
																		</Border>
																		<Button Grid.Column="2" Classes="ActionBtn" Click="NextSeason_Click" Tag="{Binding SeriesCard}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
																	</Grid>
																	<Grid ColumnDefinitions="Auto, *, Auto">
																		<Button Grid.Column="0" Classes="ActionBtn" Click="PrevEpisode_Click" Tag="{Binding SeriesCard}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
																		<Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
																			<TextBlock Text="{Binding SeriesCard.EpisodeText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
																		</Border>
																		<Button Grid.Column="2" Classes="ActionBtn" Click="NextEpisode_Click2" Tag="{Binding SeriesCard}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
																	</Grid>
																	<Grid ColumnDefinitions="*, *">
																		<Button Grid.Column="0" Classes="ActionBtn" Click="SeriesInfo_Click" Tag="{Binding SeriesCard}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0">
																			<StackPanel Orientation="Horizontal" Spacing="4">
																				<TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
																			</StackPanel>
																		</Button>
																		<Button Grid.Column="1" Classes="ActionBtn" Click="SeriesFav_Click" Tag="{Binding SeriesCard}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0">
																			<StackPanel Orientation="Horizontal" Spacing="4">
																				<TextBlock Text="{Binding SeriesCard.FavoriteIcon}" FontSize="12" Foreground="{Binding SeriesCard.FavoriteBrush}" VerticalAlignment="Center"/>
																			</StackPanel>
																		</Button>
																	</Grid>
																</StackPanel>

																<!-- Film / VOD İçin İşlem Butonları (Filmler sekmesiyle birebir aynı) -->
																<StackPanel Grid.Row="1" Margin="14,10,14,12" VerticalAlignment="Bottom" Spacing="5" IsVisible="{Binding IsMovie}">
																	<Button Classes="ActionBtn" Click="ResumeRestart_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																		<TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
																	</Button>
																	<Button Classes="ActionBtn" Click="ResumeCard_Click" Tag="{Binding}" Background="#223b82f6" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
																		<TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
																	</Button>
																	<Button Classes="ActionBtn" Click="ResumeFavorite_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																		<StackPanel Orientation="Horizontal" Spacing="4">
																			<TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
																			<TextBlock Text="Favori" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
																		</StackPanel>
																	</Button>
																	<Button Classes="ActionBtn" Click="ResumeDetail_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																		<StackPanel Orientation="Horizontal" Spacing="4">
																			<TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
																			<TextBlock Text="Detay" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
																		</StackPanel>
																	</Button>
																</StackPanel>
															</Grid>
														</Grid>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</ScrollViewer>

									<!-- Sol ve Sağ Ok Butonları -->
									<Border x:Name="HomeResumePrevBtn" Classes="HScrollArrow" PointerPressed="HomeResumePrev_Click" IsVisible="False">
										<Path Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
									</Border>
									<Border x:Name="HomeResumeNextBtn" Classes="HScrollArrow NextArrow" PointerPressed="HomeResumeNext_Click" IsVisible="False">
										<Path Data="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
									</Border>
								</Grid>
							</StackPanel>

						</StackPanel>

						<StackPanel x:Name="FavoriPanel" IsVisible="False" Spacing="0">
							<StackPanel x:Name="FavoriLiveSection" IsVisible="False" Margin="0,0,0,32">
								<TextBlock Text="Canlı TV" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,16"/>
								<Grid>
									<ScrollViewer x:Name="FavoriLiveScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="FavoriLiveScroll_ScrollChanged">
										<ItemsControl x:Name="FavoriLiveGrid">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal"/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="sys:String">
													<Button Classes="CatCard" Click="FavoriCategory_Click" Tag="{Binding}">
														<Grid ColumnDefinitions="*, Auto">
															<TextBlock Text="{Binding}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
															<TextBlock Grid.Column="1" Text="❯" Foreground="{DynamicResource TextSec}" VerticalAlignment="Center"/>
														</Grid>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</ScrollViewer>
									<Border x:Name="FavoriLivePrevBtn" Classes="HScrollArrow" PointerPressed="FavoriLivePrev_Click" IsVisible="False">
										<Path Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
									</Border>
									<Border x:Name="FavoriLiveNextBtn" Classes="HScrollArrow NextArrow" PointerPressed="FavoriLiveNext_Click" IsVisible="False">
										<Path Data="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
									</Border>
								</Grid>
							</StackPanel>
							<StackPanel x:Name="FavoriVodSection" IsVisible="False" Margin="0,0,0,32">
								<TextBlock Text="Filmler" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,16"/>
								<Grid>
								<ScrollViewer x:Name="FavoriVodScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="FavoriVodScroll_ScrollChanged">
									<!-- KALICI DÜZELTME (CPU spike): tek satır yatay liste
									     olduğundan satır gruplamasına gerek yok — sadece
									     panel gerçek sanallaştırma yapan
									     VirtualizingStackPanel(Horizontal) oldu. -->
									<ItemsControl x:Name="FavoriVodGrid">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<VirtualizingStackPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="local:Channel">
												<Border Classes="VodCardBorder">
													<Grid ColumnDefinitions="Auto, *">
														<Border Grid.Column="0" Width="112" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
															<Grid>
																<Border Background="{DynamicResource PosterPlaceholderBg}" IsVisible="{Binding NoLogo}">
																	<TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
																</Border>
																<Border Background="{DynamicResource PosterOverlayBg}" IsVisible="{Binding HasLogo}">
																	<Image Source="{Binding LogoBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="LowQuality"/>
																</Border>
															</Grid>
														</Border>
														<Grid Grid.Column="1" RowDefinitions="Auto, *">
															<StackPanel Grid.Row="0" Margin="14,14,14,0" IsHitTestVisible="False">
																<TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Name}"/>
																<TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
															</StackPanel>
															<StackPanel Grid.Row="1" Margin="14,10,14,12" VerticalAlignment="Bottom" Spacing="5">
																<Button Classes="ActionBtn" Click="Content_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																	<TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
																</Button>
																<Button Classes="ActionBtn" Click="Content_Resume_Click" Tag="{Binding}" Background="#223b82f6" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
																	<TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
																</Button>
																<Button Classes="ActionBtn" Click="ToggleFavorite_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																	<StackPanel Orientation="Horizontal" Spacing="4">
																		<TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
																		<TextBlock Text="Favori" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
																	</StackPanel>
																</Button>
																<Button Classes="ActionBtn" Click="VodInfo_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																	<StackPanel Orientation="Horizontal" Spacing="4">
																		<TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
																		<TextBlock Text="Detay" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
																	</StackPanel>
																</Button>
															</StackPanel>
														</Grid>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									</ScrollViewer>
								<Border x:Name="FavoriVodPrevBtn" Classes="HScrollArrow" PointerPressed="FavoriVodPrev_Click" IsVisible="False">
									<Path Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
								</Border>
								<Border x:Name="FavoriVodNextBtn" Classes="HScrollArrow NextArrow" PointerPressed="FavoriVodNext_Click" IsVisible="False">
									<Path Data="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
								</Border>
								</Grid>
							</StackPanel>
							<StackPanel x:Name="FavoriSeriesSection" IsVisible="False" Margin="0,0,0,32">
								<TextBlock Text="Diziler" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,0,16"/>
								<Grid>
								<ScrollViewer x:Name="FavoriSeriesScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ScrollChanged="FavoriSeriesScroll_ScrollChanged">
									<!-- KALICI DÜZELTME (CPU spike): tek satır yatay liste
									     olduğundan satır gruplamasına gerek yok — sadece
									     panel gerçek sanallaştırma yapan
									     VirtualizingStackPanel(Horizontal) oldu. -->
									<ItemsControl x:Name="FavoriSeriesGrid">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<VirtualizingStackPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="local:SeriesCard">
												<Border Classes="VodCardBorder" Height="240">
													<Grid ColumnDefinitions="Auto, *">
														<Border Grid.Column="0" Width="112" CornerRadius="12,0,0,12" ClipToBounds="True" IsHitTestVisible="False">
															<Grid>
																<Border Background="{DynamicResource PosterPlaceholderBg}" IsVisible="{Binding NoLogo}">
																	<TextBlock Text="🎞️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
																</Border>
																<Border Background="{DynamicResource PosterOverlayBg}" IsVisible="{Binding HasLogo}">
																	<Image Source="{Binding LogoBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="LowQuality"/>
																</Border>
															</Grid>
														</Border>
														<Grid Grid.Column="1" RowDefinitions="Auto, *">
															<StackPanel Grid.Row="0" Margin="14,12,14,0" IsHitTestVisible="False">
																<TextBlock Text="{Binding ShowName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ShowName}"/>
																<TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
															</StackPanel>
															<StackPanel Grid.Row="1" Margin="14,8,14,12" VerticalAlignment="Bottom" Spacing="5">
																<Button Classes="ActionBtn" Click="PlaySeries_Click" Tag="{Binding}" Background="{DynamicResource Accent}" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
																	<TextBlock Text="▶ Oynat" FontSize="12" FontWeight="Bold" Foreground="White"/>
																</Button>
																<Button Classes="ActionBtn" Click="PlaySeriesResume_Click" Tag="{Binding}" Background="#223b82f6" Foreground="White" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Accent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasResume}">
																	<TextBlock Text="▶ Devam Et" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
																</Button>
																<Grid ColumnDefinitions="Auto, *, Auto">
																	<Button Grid.Column="0" Classes="ActionBtn" Click="PrevSeason_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
																	<Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
																		<TextBlock Text="{Binding SeasonText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
																	</Border>
																	<Button Grid.Column="2" Classes="ActionBtn" Click="NextSeason_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
																</Grid>
																<Grid ColumnDefinitions="Auto, *, Auto">
																	<Button Grid.Column="0" Classes="ActionBtn" Click="PrevEpisode_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8,0,0,8" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="◀" FontSize="10"/>
																	<Border Grid.Column="1" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1" IsHitTestVisible="False">
																		<TextBlock Text="{Binding EpisodeText}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
																	</Border>
																	<Button Grid.Column="2" Classes="ActionBtn" Click="NextEpisode_Click2" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="0,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" Content="▶" FontSize="10"/>
																</Grid>
																<Grid ColumnDefinitions="*, *">
																	<Button Grid.Column="0" Classes="ActionBtn" Click="SeriesInfo_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,3,0">
																		<StackPanel Orientation="Horizontal" Spacing="4">
																			<TextBlock Text="ⓘ" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
																		</StackPanel>
																	</Button>
																	<Button Grid.Column="1" Classes="ActionBtn" Click="SeriesFav_Click" Tag="{Binding}" Background="{DynamicResource BgActive}" Foreground="{DynamicResource Text}" CornerRadius="8" Padding="0,6" BorderThickness="1" BorderBrush="{DynamicResource Border}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="3,0,0,0">
																		<StackPanel Orientation="Horizontal" Spacing="4">
																			<TextBlock Text="{Binding FavoriteIcon}" FontSize="12" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center"/>
																		</StackPanel>
																	</Button>
																</Grid>
															</StackPanel>
														</Grid>
													</Grid>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
								<Border x:Name="FavoriSeriesPrevBtn" Classes="HScrollArrow" PointerPressed="FavoriSeriesPrev_Click" IsVisible="False">
									<Path Data="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
								</Border>
								<Border x:Name="FavoriSeriesNextBtn" Classes="HScrollArrow NextArrow" PointerPressed="FavoriSeriesNext_Click" IsVisible="False">
									<Path Data="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
								</Border>
								</Grid>
							</StackPanel>
						</StackPanel>

					</StackPanel>
				</ScrollViewer>

				<!-- Özel minimal scroll çubuğu (sabit boyutlu thumb)
				     Gerçek ScrollViewer scroll çubuğu yukarıda Hidden;
				     pozisyon ContentScrollViewer_ScrollChanged içinde
				     kod-behind'dan hesaplanıp bu Border'a uygulanıyor.
				     Scroll sırasında görünür, durakladığında otomatik
				     gizlenir (fade); ayrıca sürüklenerek scroll yapılabilir. -->
				<!-- Hover sırasında genişleyen thumb için: dış kapsayıcı
				     (CustomScrollThumb) SABİT genişlikte tutulur ve tüm
				     pointer olaylarını o yakalar — bu sayede genişleme
				     animasyonu sırasında "imleç artık sınırların dışında"
				     diye PointerExited'in anında tetiklenip thumb'ın
				     titreyerek kaybolması engellenir. Görünür ince/kalın
				     çubuk ise içteki CustomScrollThumbVisual'dır ve
				     IsHitTestVisible=False olduğu için olayları engellemez,
				     sadece görsel olarak büyür/küçülür. -->
				<Border x:Name="CustomScrollThumb"
						Width="15" Height="80"
						Background="Transparent"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,24,0,0"
						Opacity="0"
						Cursor="Hand"
						PointerEntered="CustomScrollThumb_PointerEntered"
						PointerExited="CustomScrollThumb_PointerExited"
						PointerPressed="CustomScrollThumb_PointerPressed"
						PointerMoved="CustomScrollThumb_PointerMoved"
						PointerReleased="CustomScrollThumb_PointerReleased"
						IsVisible="False">
					<Border.Transitions>
						<Transitions>
							<DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
						</Transitions>
					</Border.Transitions>
					<Border x:Name="CustomScrollThumbVisual"
							Width="6" Height="80"
							CornerRadius="3"
							Background="#66888888"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							IsHitTestVisible="False">
						<Border.Transitions>
							<Transitions>
								<DoubleTransition Property="Width" Duration="0:0:0.12"/>
							</Transitions>
						</Border.Transitions>
					</Border>
				</Border>
					</Grid>
				</Grid>
			</Grid>
		</Grid>

		<!-- ═══════════════════════════════════════════════════════════
		     YENİ (madde 2 — Ayarlar modalının kategori panelinin ÜZERİNE
		     yazılmaması): Ayarlar artık ana içerik akışının İÇİNDE
		     (ContentScrollViewer'ın altında, sağ tarafta) bir StackPanel
		     DEĞİL — EpgOverlay/VodInfoOverlay/ChangeSourceOverlay ile
		     AYNI desende, RootGrid'in DOĞRUDAN çocuğu, Grid.Column="0"
		     Grid.ColumnSpan="2" olan tam ekran bir overlay. Bu sayede
		     hem ana Sidebar (200px) hem de yeni CategoryListPanel (220px)
		     dahil TÜM pencerenin üzerine, ortalanmış olarak açılır —
		     önceki hâlinde sadece içerik sütununun (MainContentGrid)
		     İÇİNDE kaldığından sağa yaslı görünüyor, sol taraftaki
		     kategori panelinin üzerine hiç çıkmıyordu.
		     ═══════════════════════════════════════════════════════════ -->
		<Border x:Name="SettingsModalOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#B3000000" IsVisible="False" ZIndex="100">
			<Border Background="{DynamicResource BgCard}" Margin="32,24" MaxWidth="1080" MaxHeight="720" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="16" BoxShadow="0 16 48 0 #99000000" ClipToBounds="True">
				<Grid RowDefinitions="Auto, *">
					<!-- Modal Üst Başlık Çubuğu -->
					<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,18,24,18">
						<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
							<Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource BgActive}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
								<TextBlock Text="🛠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="Ayarlar" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
								<TextBlock Text="Uygulama tercihleri, oynatıcı ve IPTV kaynak yönetimi" FontSize="11" Foreground="{DynamicResource TextSec}"/>
							</StackPanel>
						</StackPanel>

						<!-- Kapat Butonu -->
						<Button Grid.Column="1" Content="✕" Click="CloseSettings_Click" Classes="IconBtn" FontSize="16" Foreground="{DynamicResource TextSec}" ToolTip.Tip="Kapat (Esc)"/>
					</Grid>

					<!-- Alt Çizgi Ayırıcı -->
					<Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Border}"/>

					<!-- Gövde: Sol Kenar Çubuğu (Sidebar) + Sağ İçerik Alanı -->
					<Grid Grid.Row="1" ColumnDefinitions="240, *">
						<!-- Sol Kenar Çubuğu -->
						<Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Border}" Padding="12,16">
							<Grid RowDefinitions="*, Auto">
								<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
									<StackPanel Spacing="3">
										<Button x:Name="SettingsNavSources" Classes="SettingsNavBtn Active" Tag="Sources" Click="SettingsNav_Click">
											<Grid ColumnDefinitions="26, *">
												<TextBlock Grid.Column="0" Text="🌐" FontSize="15" VerticalAlignment="Center"/>
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="Kaynaklar" FontWeight="SemiBold" FontSize="13"/>
													<TextBlock Text="M3U &amp; Xtream listeleri" FontSize="10" Foreground="{DynamicResource TextSec}"/>
												</StackPanel>
											</Grid>
										</Button>

										<Button x:Name="SettingsNavAppearance" Classes="SettingsNavBtn" Tag="Appearance" Click="SettingsNav_Click">
											<Grid ColumnDefinitions="26, *">
												<TextBlock Grid.Column="0" Text="✨" FontSize="15" VerticalAlignment="Center"/>
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="Genel &amp; Görünüm" FontWeight="SemiBold" FontSize="13"/>
													<TextBlock Text="Tema, başlangıç &amp; motor" FontSize="10" Foreground="{DynamicResource TextSec}"/>
												</StackPanel>
											</Grid>
										</Button>

										<Button x:Name="SettingsNavData" Classes="SettingsNavBtn" Tag="Data" Click="SettingsNav_Click">
											<Grid ColumnDefinitions="26, *">
												<TextBlock Grid.Column="0" Text="🗄️" FontSize="15" VerticalAlignment="Center"/>
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="Veri &amp; Depolama" FontWeight="SemiBold" FontSize="13"/>
													<TextBlock Text="Geçmiş, önbellek ve sıfırlama" FontSize="10" Foreground="{DynamicResource TextSec}"/>
												</StackPanel>
											</Grid>
										</Button>

										<Button x:Name="SettingsNavShortcuts" Classes="SettingsNavBtn" Tag="Shortcuts" Click="SettingsNav_Click">
											<Grid ColumnDefinitions="26, *">
												<TextBlock Grid.Column="0" Text="⌨️" FontSize="15" VerticalAlignment="Center"/>
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="Kısayollar" FontWeight="SemiBold" FontSize="13"/>
													<TextBlock Text="Klavye &amp; fare tuşları" FontSize="10" Foreground="{DynamicResource TextSec}"/>
												</StackPanel>
											</Grid>
										</Button>

										<Button x:Name="SettingsNavAbout" Classes="SettingsNavBtn" Tag="About" Click="SettingsNav_Click">
											<Grid ColumnDefinitions="26, *">
												<TextBlock Grid.Column="0" Text="ⓘ" FontSize="15" VerticalAlignment="Center"/>
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="Hakkında" FontWeight="SemiBold" FontSize="13"/>
													<TextBlock Text="Sürüm bilgisi &amp; topluluk" FontSize="10" Foreground="{DynamicResource TextSec}"/>
												</StackPanel>
											</Grid>
										</Button>
									</StackPanel>
								</ScrollViewer>

								<!-- Alt Bilgi / Sürüm Rozeti -->
								<Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
									<StackPanel Spacing="2">
										<TextBlock Text="GlyphTV™ v2.1.0" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Text}"/>
										<TextBlock Text="Designed by AkuLaTa" FontSize="9.5" Foreground="{DynamicResource TextSec}"/>
									</StackPanel>
								</Border>
							</Grid>
						</Border>

						<!-- Sağ İçerik Alanı -->
						<Grid Grid.Column="1">
							<!-- 1. SEKME: KAYNAKLAR -->
							<ScrollViewer x:Name="SettingsTabSources" Margin="24,18,24,24" VerticalScrollBarVisibility="Auto" IsVisible="True">
								<StackPanel Spacing="16">
									<Grid ColumnDefinitions="*, Auto">
										<StackPanel VerticalAlignment="Center">
											<TextBlock Text="IPTV Kaynakları" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
											<TextBlock Text="M3U oynatma listelerinizi veya Xtream hesaplarınızı yönetin." FontSize="12" Foreground="{DynamicResource TextSec}" Margin="0,2,0,0"/>
										</StackPanel>
